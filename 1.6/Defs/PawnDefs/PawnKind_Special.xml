<?xml version="1.0" encoding="utf-8" ?>
<Defs>
<!--Skyblooded-->
  <PawnKindDef ParentName="BasePlayerPawnKind">
    <defName>ET_SkytouchedPawnKind</defName>
    <label>skyblooded</label>
    <defaultFactionDef>ET_TerratechKeepers</defaultFactionDef>
    <chemicalAddictionChance>0</chemicalAddictionChance>
    <apparelTags>
      <li>Neolithic</li>
    </apparelTags>
    <apparelAllowHeadgearChance>1</apparelAllowHeadgearChance>
    <apparelMoney>60~2000</apparelMoney>
    <!--<weaponMoney>
			<min>40</min>
			<max>5000</max>
		</weaponMoney>
		<weaponTags>
			<li>ET_PeriwoodWeapon</li>
		</weaponTags>-->
    <backstoryCryptosleepCommonality>0</backstoryCryptosleepCommonality>
    <backstoryFilters>
      <li>
        <categories>
          <li>ET_TerratechBackstories</li>
        </categories>
      </li>
    </backstoryFilters>
    <techHediffsChance>0</techHediffsChance>
    <techHediffsMoney>0~2000</techHediffsMoney>
    <techHediffsTags>
      <li>Poor</li>
    </techHediffsTags>
    <techHediffsDisallowTags>
      <li>PainCauser</li>
    </techHediffsDisallowTags>
    <initialResistanceRange>25~75</initialResistanceRange>
    <forcedTraits>
      <ET_SkytouchedTrait>0</ET_SkytouchedTrait>
    </forcedTraits>
    <disallowedTraits>
      <li>Undergrounder</li>
      <li>ShootingAccuracy</li>
			<li>Brawler</li>
			<li>Wimp</li>
			<li>Pyromaniac</li>
			<li>Transhumanist</li>
      <li>BodyPurist</li>
		</disallowedTraits>
  </PawnKindDef>

