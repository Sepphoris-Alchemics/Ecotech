<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <PawnKindDef ParentName="BasePlayerPawnKind">
    <defName>ET_KeeperMember</defName>
    <label>terratech keeper</label>
    <defaultFactionDef>ET_TerratechKeepers</defaultFactionDef>
    <chemicalAddictionChance>0.06</chemicalAddictionChance>
    <apparelRequired>
      <li>ET_PeriwoodHelmet</li>
      <li>ET_PeriwoodArmor</li>
    </apparelRequired>
    <apparelTags>
      <li>Neolithic</li>
      <li>LightPlantArmor</li>
    </apparelTags>
    <apparelAllowHeadgearChance>0</apparelAllowHeadgearChance>
    <apparelMoney>400~800</apparelMoney>
    <backstoryCryptosleepCommonality>0</backstoryCryptosleepCommonality>
    <techHediffsChance>0</techHediffsChance>
    <techHediffsMoney>50~50</techHediffsMoney>
    <techHediffsTags>
      <li>Poor</li>
    </techHediffsTags>
    <techHediffsDisallowTags>
      <li>PainCauser</li>
    </techHediffsDisallowTags>
    <initialResistanceRange>25~75</initialResistanceRange>
    <disallowedTraits>
      <li>ShootingAccuracy</li>
			<li>Brawler</li>
			<li>Wimp</li>
			<li>Pyromaniac</li>
			<li>Transhumanist</li>
      <li>BodyPurist</li>
		</disallowedTraits>
  </PawnKindDef>

  <PawnKindDef ParentName="TribalBase" Name="ET_OrganicLowTierBase" Abstract="True">
    <race>Human</race>
    <defaultFactionType>ET_OrganicFaction</defaultFactionType>
    <backstoryCategories>
      <li>ET_TerratechBackstories</li>
    </backstoryCategories>
    <gearHealthRange>
			<min>0.4</min>
			<max>0.7</max>
		</gearHealthRange>
    <apparelTags>
      <li>Neolithic</li>
    </apparelTags>
    <weaponMoney>10~300</weaponMoney>
    <initialWillRange>25~75</initialWillRange>
    <chemicalAddictionChance>0.05</chemicalAddictionChance>
    <invNutrition>2.55</invNutrition>
    <itemQuality>Normal</itemQuality>
    <backstoryCryptosleepCommonality>0</backstoryCryptosleepCommonality>
    <maxGenerationAge>65</maxGenerationAge>
    <disallowedTraits>
      <li>ShootingAccuracy</li>
			<li>Brawler</li>
			<li>Wimp</li>
			<li>Pyromaniac</li>
			<li>Transhumanist</li>
      <li>BodyPurist</li>
		</disallowedTraits>
  </PawnKindDef>
<!--==========-->
  <PawnKindDef Abstract="True" Name="ET_OrganicMidTierBase" ParentName="ET_OrganicLowTierBase">
    <defaultFactionDef>ET_TerratechKeepers</defaultFactionDef>
    <combatPower>120</combatPower>
    <maxGenerationAge>45</maxGenerationAge>
    <gearHealthRange>
      <min>.6</min>
      <max>3.5</max>
    </gearHealthRange>
    <canBeSapper>true</canBeSapper>
    <itemQuality>Normal</itemQuality>
    <apparelTags>
      <li>Neolithic</li>
    </apparelTags>
    <apparelMoney>
      <min>2500</min>
      <max>4200</max>
    </apparelMoney>
    <apparelAllowHeadgearChance>1</apparelAllowHeadgearChance>
    <weaponMoney Inherit="false">800~1600</weaponMoney>
    <combatEnhancingDrugsCount>
      <min>0</min>
      <max>2</max>
    </combatEnhancingDrugsCount>
    <combatEnhancingDrugsChance>0.5</combatEnhancingDrugsChance>
    <techHediffsTags>
      <li>Medieval</li>
    </techHediffsTags>
    <techHediffsChance>0.25</techHediffsChance>
    <inventoryOptions>
      <skipChance>0.5</skipChance>
      <subOptionsChooseOne>
        <li>
          <thingDef>Silver</thingDef>
          <countRange>
            <min>40</min>
            <max>200</max>
          </countRange>
        </li>
        <li>
          <thingDef>MedicineHerbal</thingDef>
          <countRange>
            <min>1</min>
            <max>2</max>
          </countRange>
        </li>
      </subOptionsChooseOne>
    </inventoryOptions>
    <initialWillRange>12~18</initialWillRange>
    <initialResistanceRange>50~75</initialResistanceRange>
  </PawnKindDef>
