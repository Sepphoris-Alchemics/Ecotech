<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <PawnKindDef ParentName="BasePlayerPawnKind">
    <defName>ET_KeeperMember</defName>
    <label>terratech keeper</label>
    <defaultFactionDef>ET_TerratechKeepers</defaultFactionDef>
    <chemicalAddictionChance>0.06</chemicalAddictionChance>
    <apparelRequired>
      <li>ET_PrimaHeavyHelmet</li>
      <li>ET_PrimaHeavyArmor</li>
    </apparelRequired>
    <apparelTags>
      <li>Neolithic</li>
      <li>ET_PlantArmorTag</li>
    </apparelTags>
    <apparelAllowHeadgearChance>0</apparelAllowHeadgearChance>
    <apparelMoney>400~800</apparelMoney>
    <backstoryCryptosleepCommonality>0</backstoryCryptosleepCommonality>
    <techHediffsChance>0</techHediffsChance>
    <techHediffsMoney>50~50</techHediffsMoney>
    <techHediffsTags>
      <li>Poor</li>
    </techHediffsTags>
    <techHediffsDisallowTags>
      <li>PainCauser</li>
    </techHediffsDisallowTags>
    <initialResistanceRange>21~45</initialResistanceRange>
  </PawnKindDef>

  <PawnKindDef ParentName="TribalBase" Name="ET_SentryBase" Abstract="True">
    <race>Human</race>
    <defaultFactionType>ET_OrganicFaction</defaultFactionType>
    <backstoryCategories>
      <li>ET_TerratechBackstories</li>
    </backstoryCategories>
    <apparelTags>
      <li>Neolithic</li>
      <li>ET_PlantArmorTag</li>
    </apparelTags>
    <weaponTags>
      <li>ET_PrimaMeleeBasic</li>
      <li>ET_BriarWeapon</li>
      <li>ET_InitiateHeavyWeapon</li>
    </weaponTags>
    <weaponMoney>10~300</weaponMoney>
    <initialWillRange>21~60</initialWillRange>
    <chemicalAddictionChance>0.05</chemicalAddictionChance>
    <invNutrition>2.55</invNutrition>
    <itemQuality>Normal</itemQuality>
    <backstoryCryptosleepCommonality>0</backstoryCryptosleepCommonality>
    <maxGenerationAge>65</maxGenerationAge>
  </PawnKindDef>


  <PawnKindDef Abstract="True" Name="ET_EliteSentryBase" ParentName="ET_SentryBase">
    <defaultFactionDef>ET_TerratechKeepers</defaultFactionDef>
    <combatPower>50</combatPower>
    <maxGenerationAge>45</maxGenerationAge>
    <gearHealthRange>
      <min>.6</min>
      <max>3.5</max>
    </gearHealthRange>
    <canBeSapper>true</canBeSapper>
    <itemQuality>Normal</itemQuality>
    <apparelTags>
      <li>Neolithic</li>
      <li>ET_PlantArmorTag</li>
      <li>ET_InitiateHeavyWeapon</li>
    </apparelTags>
    <apparelMoney>
      <min>2500</min>
      <max>4200</max>
    </apparelMoney>
    <apparelAllowHeadgearChance>0.9</apparelAllowHeadgearChance>
    <weaponMoney Inherit="false">800~1600</weaponMoney>
    <combatEnhancingDrugsCount>
      <min>0</min>
      <max>2</max>
    </combatEnhancingDrugsCount>
    <combatEnhancingDrugsChance>0.5</combatEnhancingDrugsChance>
    <techHediffsTags>
      <li>Medieval</li>
    </techHediffsTags>
    <techHediffsChance>0.25</techHediffsChance>
    <inventoryOptions>
      <skipChance>0.5</skipChance>
      <subOptionsChooseOne>
        <li>
          <thingDef>Silver</thingDef>
          <countRange>
            <min>40</min>
            <max>200</max>
          </countRange>
        </li>
        <li>
          <thingDef>MedicineHerbal</thingDef>
          <countRange>
            <min>1</min>
            <max>2</max>
          </countRange>
        </li>
      </subOptionsChooseOne>
    </inventoryOptions>
    <initialWillRange>6~8</initialWillRange>
    <initialResistanceRange>15~30</initialResistanceRange>
  </PawnKindDef>

