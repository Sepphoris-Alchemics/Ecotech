<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <FactionDef>
    <defName>ET_OrganicFaction</defName>
    <label>Terratech Curators</label>
    <description>Using the soil as their library, this faction has massive groves of hundreds - if not thousands - of plants constantly being grown and replanted, which has kept their tech alive for thousands of years. While they do not possess much metal, adn refuse to use alloys and fabricated tools, they are nontheless more than capable of defending themselves.
\nThey generally keep to themselves, not socializing or trusting anyone besides their own. That said, they do not attack others either, and their trust can be gained over time, especially with tribes.</description>
    <pawnSingular>curator</pawnSingular>
    <pawnsPlural>curator</pawnsPlural>
    <settlementGenerationWeight>0.5</settlementGenerationWeight>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <canMakeRandomly>true</canMakeRandomly>
    <canSiege>false</canSiege>
    <canStageAttacks>false</canStageAttacks>
    <leaderTitle>Grovekeeper</leaderTitle>
    <autoFlee>false</autoFlee>
    <earliestRaidDays>120</earliestRaidDays>
    <settlementTexturePath>World/WorldObjects/TribalSettlement</settlementTexturePath>    <!--create custom icon-->
    <colorSpectrum>
      <li>(85, 170, 175)</li>
    </colorSpectrum>
    <factionNameMaker>ET_NamerOrganicFaction</factionNameMaker>    <!--create custom def-->
    <settlementNameMaker>ET_NamerOrganicSettlement</settlementNameMaker>    <!--create custom def-->
    <techLevel>Neolithic</techLevel>
    <backstoryFilters>
      <li>
        <categories>
          <li>Tribal</li>
          <li>Researcher</li>
        </categories>
      </li>
    </backstoryFilters>
    <!--<backstoryCategories>
      <li>ET_OrganicFactionBackstories</li>
    </backstoryCategories>-->
    <raidCommonalityFromPointsCurve>
      <points>
        <li>(0, .5)</li>
      </points>
    </raidCommonalityFromPointsCurve>
    <raidLootMaker>ET_OrganicRaidLootMaker</raidLootMaker>    <!--create custom def-->
    <caravanTraderKinds>      <!--create defs-->
      <li>ET_OrganicCaravan_Seeds</li>
      <li>ET_OrganicCaravan_Saps</li>
    </caravanTraderKinds>
    <visitorTraderKinds>      <!--create defs-->
      <li>ET_OrganicVisitor_Standard</li>
    </visitorTraderKinds>
    <baseTraderKinds>      <!--create defs-->
      <li>ET_FactionTrader_Base</li>
    </baseTraderKinds>
    <allowedArrivalTemperatureRange>
      <min>-40</min>
      <max>45</max>
    </allowedArrivalTemperatureRange>
    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(0,40)</li>
        <li>(70, 70)</li>
        <li>(700, 150)</li>
        <li>(1300, 250)</li>
        <li>(100000, 10000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>
    <raidLootValueFromPointsCurve>
      <points>
        <li>(35,     15)</li>
        <li>(100,   120)</li>
        <li>(1000,  500)</li>
        <li>(2000,  800)</li>
        <li>(4000, 1000)</li>
      </points>
    </raidLootValueFromPointsCurve>
    <pawnGroupMakers>      <!--create defs-->
      <!--
			Perennial should be most common.
			Prima should be second-most common, and should only be upgraded or sapped weaponry.
			Both briar and wild wepaonry should be rare, and not upgraded.
			"Random" means that weapons may or may not be infused
			"Basic" means weapons won't be infused
			"Infused" means weapons will be infused
			-->
      <li>
        <kindDef>Combat</kindDef>
        <options>
          <!--Briar-->
          <ET_BriarSentry_Random>9</ET_BriarSentry_Random>
          <ET_WildSentry_Random>6</ET_WildSentry_Random>
          <ET_InitiateSentry_HeavyAll>3</ET_InitiateSentry_HeavyAll>
          <ET_Sentry_SkirmisherAll>8</ET_Sentry_SkirmisherAll>
          <ET_Sentry_RangerAll>6</ET_Sentry_RangerAll>
          <ET_PerennialSentry_MeleeAll>5</ET_PerennialSentry_MeleeAll>
          <ET_PrimaSentry_GunnerInfused>8</ET_PrimaSentry_GunnerInfused>
          <ET_PrimaSentry_FighterInfused>3</ET_PrimaSentry_FighterInfused>
          <ET_SentryElite>1</ET_SentryElite>
        </options>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
        <options>
          <ET_Sentry_SkirmisherAll>4</ET_Sentry_SkirmisherAll>
          <ET_PrimaSentry_FighterInfused>6</ET_PrimaSentry_FighterInfused>
          <ET_PrimaSentry_FighterBasic>6</ET_PrimaSentry_FighterBasic>
          <ET_PrimaSentry_GunnerInfused>4</ET_PrimaSentry_GunnerInfused>
        </options>
      </li>
      <li>
        <kindDef>Trader</kindDef>
        <traders>
          <Town_Trader>1</Town_Trader>
        </traders>
        <carriers>
          <Muffalo>1</Muffalo>
          <Dromedary>4</Dromedary>
          <Alpaca>2</Alpaca>
          <Elephant>6</Elephant>
        </carriers>
        <guards>
          <ET_Sentry_RangerAll>8</ET_Sentry_RangerAll>
          <ET_BriarSentry_Random>4</ET_BriarSentry_Random>
          <ET_PerennialSentry_MeleeAll>6</ET_PerennialSentry_MeleeAll>
          <ET_PrimaSentry_GunnerBasic>5</ET_PrimaSentry_GunnerBasic>
        </guards>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <ET_Sentry_RangerAll>12</ET_Sentry_RangerAll>
          <ET_Sentry_SkirmisherAll>16</ET_Sentry_SkirmisherAll>
          <ET_BriarSentry_Random>18</ET_BriarSentry_Random>
          <ET_InitiateSentry_HeavyAll>6</ET_InitiateSentry_HeavyAll>
          <ET_PrimaSentry_FighterInfused>9</ET_PrimaSentry_FighterInfused>
          <ET_PrimaSentry_GunnerInfused>8</ET_PrimaSentry_GunnerInfused>
          <ET_WildSentry_Random>8</ET_WildSentry_Random>
          <ET_SentryElite>1</ET_SentryElite>
        </options>
      </li>
    </pawnGroupMakers>
    <factionIconPath>UI/World/TerratechTown</factionIconPath>
    <maxConfigurableAtWorldCreation>9</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>10</configurationListOrderPriority>
    <modExtensions>
      <li Class="VEF.Factions.FactionDefExtension">
        <allowedBiomes>
          <li>BorealForest</li>
          <li>TemperateForest</li>
          <li>TemperateSwamp</li>
          <li>TropicalRainforest</li>
          <li>TropicalSwamp</li>
        </allowedBiomes>
        <excludeFromCommConsole>true</excludeFromCommConsole>
        <startingGoodwillByFactionDefs>
          <PlayerColony>-60~-50</PlayerColony>
          <PlayerTribe>-10~10</PlayerTribe>
        </startingGoodwillByFactionDefs>
      </li>
    </modExtensions>
  </FactionDef>

  <ThingSetMakerDef>
    <defName>ET_OrganicRaidLootMaker</defName>
    <root Class="ThingSetMaker_MarketValue">
      <fixedParams>
        <filter>
          <thingDefs>
            <li>Silver</li>
            <li>MedicineHerbal</li>
            <li>Jade</li>
            <li>ET_SunDrop</li>
          </thingDefs>
        </filter>
      </fixedParams>
    </root>
  </ThingSetMakerDef>


</Defs>