<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<!--
	-To-do: Glowsap can also be used to create pots that can act as a makeshift growing location. Akin to hyroponics, but with standard fertility and a limited lifespan. An ideal way to grow Terraplants in regions with low soil quality.
	-To-do: Later used in Periwood Weapons.
-->

  <ThingDef ParentName="ResourceBase">
    <defName>ET_Seed_LithicCraftingStationTierOne</defName>
    <label>Terrathyst Crucible Cluster</label>
    <description>A cluster of crystals that will grow to a much larger size, forming a terrathyst crucible. This growth happens by the crystal converting terrain nutrients to a usable electric charge.
\n\nThis seed is very sensitive to the terrain it's planted on; the higher the fertility, the faster it will grow. However, it will still eventually grow on non-fertile terrains.</description>
    <possessionCount>0</possessionCount>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/Resource/TerrathystSeed</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
      <drawSize>0.3</drawSize>
    </graphicData>
    <stackLimit>8</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <intricate>true</intricate>
    <statBases>
      <MaxHitPoints>30</MaxHitPoints>
      <MarketValue>45</MarketValue>
      <Mass>0.2</Mass>
      <Flammability>0</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>TerraseedsLithicStructures</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Plantable">
        <plantDefToSpawn>ET_LithicCraftingStationTierOne</plantDefToSpawn>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>1.9</glowRadius>
        <glowColor>(238,211,77,0)</glowColor>
      </li>
    </comps>
    <tradeTags Inherit='false'>
      <li>ET_LithicStructureSeed</li>
    </tradeTags>
    <allowedArchonexusCount>4</allowedArchonexusCount>
  </ThingDef>

