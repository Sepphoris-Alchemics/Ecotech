<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<!--
	-To-do: Glowsap can also be used to create pots that can act as a makeshift growing location. Akin to hyroponics, but with standard fertility and a limited lifespan. An ideal way to grow Terraplants in regions with low soil quality.
	-To-do: Later used in Periwood Weapons.
-->

  <ThingDef ParentName="ResourceBase">
    <defName>ET_Seed_Terraforge</defName>
    <label>Terraforge Channeling Seed</label>
    <description>A durable seed specifically patterned to immediately grow into a Terraforge, which is critical in Ecotech usage. The Terraforge violently roots into the surface beneath it, making it unable to be moved once planted.
\n\nThis seed ignores fertility, allowing it to be planted on many surfaces.</description>
    <possessionCount>0</possessionCount>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/Resource/SurgeSeed</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
      <drawSize>0.3</drawSize>
    </graphicData>
    <stackLimit>8</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <intricate>true</intricate>    <!-- Not returned to player when product made of this is smelted. -->
    <statBases>
      <WorkToMake>2400</WorkToMake>
      <MaxHitPoints>80</MaxHitPoints>
      <MarketValue>105</MarketValue>
      <Mass>0.015</Mass>
      <Flammability>0.5</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>TerraseedsPrimaStructures</li>
    </thingCategories>
    <recipeMaker>
      <recipeUsers>
        <li>CraftingSpot</li>
      </recipeUsers>
      <skillRequirements>
        <Plants>2</Plants>
      </skillRequirements>
      <displayPriority>510</displayPriority>
    </recipeMaker>
    <costList>
      <WoodLog>5</WoodLog>
    </costList>
    <comps>
      <li Class="CompProperties_Plantable">
        <plantDefToSpawn>ET_TerraforgePlant</plantDefToSpawn>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>0.9</glowRadius>
        <glowColor>(370,370,370,0)</glowColor>
      </li>
    </comps>
    <tradeTags Inherit='false'>
      <li>ET_PrimaStructureSeed</li>
    </tradeTags>
    <allowedArchonexusCount>2</allowedArchonexusCount>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
    <defName>ET_Seed_SapFilter</defName>
    <label>Sap Transposer Seed</label>
    <description>A special seed that will grow into a sap transposer. The sap transposer will grow in roughly a day.</description>
    <possessionCount>1</possessionCount>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/Resource/SurgeSeed</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
      <drawSize>0.3</drawSize>
    </graphicData>
    <stackLimit>3</stackLimit>
    <healthAffectsPrice>true</healthAffectsPrice>
    <intricate>true</intricate> <!-- Not returned to player when product made of this is smelted. -->
    <statBases>
      <MaxHitPoints>20</MaxHitPoints>
      <MarketValue>1</MarketValue>
      <Mass>0.015</Mass>
      <Flammability>1</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>TerraseedsPrimaStructures</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Plantable">
        <plantDefToSpawn>ET_SapFilterPlant</plantDefToSpawn>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>1.9</glowRadius>
        <glowColor>(370,370,370,0)</glowColor>
      </li>
      <li Class="CompProperties_Lifespan">
        <lifespanTicks>240000</lifespanTicks>
      </li>
    </comps>
    <allowedArchonexusCount>1</allowedArchonexusCount>
    <tradeTags Inherit='false'>
      <li>ET_PrimaStructureSeed</li>
    </tradeTags>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
    <defName>ET_Seed_SmallTerravat</defName>
    <label>Small Terravat Channeling Seed</label>
