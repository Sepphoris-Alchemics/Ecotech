<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="LampBase">
    <defName>ET_PrimaBrightsapColumn</defName>
    <label>Prima Brightsap Column</label>
    <description>A column made of wood and terramass that will grow into the ceiling above it, providing structural support. The presence of Brightsap ensures it won't wither away any time soon, and provides a large amount of light when flourishing.
\n\n\While the column itself will not expire, the glow of the brightsap within will eventually fade, and it's light output will be significantly lowered. You will need to renourish the columm every year for it to retain it's glow.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <drawSize>(1.4,1.4)</drawSize>
      <drawOffset>(0,0,0.2)</drawOffset>
      <texPath>Things/Building/PrimaBrightsapPillar/PrimaBrightsapPillarA</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shadowData>
        <volume>(0.3, 0.5, 0.3)</volume>
        <offset>(0,0,-0.23)</offset>
      </shadowData>
      <damageData>
        <rect>(0.2,0.2,0.6,0.6)</rect>
      </damageData>
    </graphicData>
    <uiIconPath>Things/Building/PrimaBrightsapPillar/PrimaBrightsapPillarA</uiIconPath>
    <tickerType>Normal</tickerType>
    <altitudeLayer>Building</altitudeLayer>
    <minifiedDef IsNull="True" />
    <thingCategories Inherit="False">
    </thingCategories>
    <designationCategory Inherit="False">
    </designationCategory>
    <statBases>
      <MaxHitPoints>140</MaxHitPoints>
      <WorkToBuild>5000</WorkToBuild>
      <Flammability>2</Flammability>
      <Beauty>3</Beauty>
      <Mass>200</Mass>
    </statBases>
    <drawerType>MapMeshAndRealTime</drawerType>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <fillPercent>0.25</fillPercent>
    <comps Inherit="False">
      <li Class="CompProperties_Glower">
        <glowRadius>12</glowRadius>        <!--Same amount as a normal lamp-->
        <glowColor>(238,211,77,0)</glowColor>
      </li>
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>0.016</fuelConsumptionRate>
        <fuelCapacity>1</fuelCapacity>        <!--Requires only one fuel per year-->
        <fuelFilter>
          <thingDefs>
            <li>ET_Brightsap</li>
          </thingDefs>
        </fuelFilter>
        <initialFuelPercent>1</initialFuelPercent>
        <fuelLabel>Brightsap</fuelLabel>
        <fuelGizmoLabel>Healthy brightsap</fuelGizmoLabel>
        <outOfFuelMessage>Requires brightsap replacement</outOfFuelMessage>
        <showFuelGizmo>true</showFuelGizmo>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
      </li>
    </comps>
    <specialDisplayRadius>6.9</specialDisplayRadius>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <killedLeavings>
      <ET_TierOnePlating>12</ET_TierOnePlating>
    </killedLeavings>
    <pathCost>25</pathCost>
    <passability>PassThroughOnly</passability>
    <rotatable>false</rotatable>
    <stealable>false</stealable>
    <building>
      <deconstructible>false</deconstructible>
      <expandHomeArea>false</expandHomeArea>
    </building>
    <researchPrerequisites Inherit="False">
      <li>ET_BrightsapStructures</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <holdsRoof>true</holdsRoof>
    <canOverlapZones>true</canOverlapZones>
    <fertility>0</fertility>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
  </ThingDef>

  <ThingDef ParentName="LampBase">
