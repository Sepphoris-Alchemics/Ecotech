<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--TERRAVAT RECIPES (most saps progress a weapon into their Apex state, if applicable)
  GLOWSAP:
    Used for opening seeds
    Used for progressing most weapons quickly
    Used for refining other items

  ENDOSAP/Endosap:
    Used for improving durability and lifespan

  SUNSAP/Brightsap:
    Used for revitalizing any weapon

  HYPERSAP/Hypersap:
    Used for improving shot capacity

  ARCHSAP:
    Removes any weapon's lifespan
  -->

  <ThingDef ParentName="BuildingBase">
    <defName>ET_BiosynthVat</defName>
    <label>Biosynth vat</label>
    <description>A tree meant to mimic and replicate the processes of Terravats to extremely precise degrees. The biosynth vat is required for the manipulation or fusion of anything that posesses complex genetic makeup, such as body parts, creatures, and even humanoids.
\n\nWhile a terravat's contents can be freely modified, a biosynth tree will only use the required resources when the operation is called, and the items are used immediately.</description>
    <size>(1,1)</size>
    <graphicData>
      <texPath>Things/Building/Terravats/BiosynthVat</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
      <drawSize>(2.6,2.6)</drawSize>
      <drawOffset>(0,0,0.75)</drawOffset>
      <drawRotated>false</drawRotated>
      <damageData>
        <rect>(0.3,0,2.7,1)</rect>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <descriptionHyperlinks>
      <ThingDef>ET_PrimaHeavyHelmetRecipeHyperlink</ThingDef>
      <ThingDef>ET_PrimaHeavyArmorRecipeHyperlink</ThingDef>
    </descriptionHyperlinks>
    <statBases>
      <WorkToBuild>600</WorkToBuild>
      <Mass>10</Mass>
      <MaxHitPoints>100</MaxHitPoints>
      <Flammability>1.0</Flammability>
