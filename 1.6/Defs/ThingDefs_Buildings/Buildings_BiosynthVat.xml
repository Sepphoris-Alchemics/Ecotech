<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--TERRAVAT RECIPES (most saps progress a weapon into their Apex state, if applicable)
  GLOWSAP:
    Used for opening seeds
    Used for progressing most weapons quickly
    Used for refining other items

  ENDOSAP/Endosap:
    Used for improving durability and lifespan

  SUNSAP/Brightsap:
    Used for revitalizing any weapon

  HYPERSAP/Hypersap:
    Used for improving shot capacity

  ARCHSAP:
    Removes any weapon's lifespan
  -->

  <ThingDef ParentName="BuildingBase">
    <defName>ET_BiosynthVat</defName>
    <label>Biosynth tree</label>
    <description>A giant tree meant to mimic and replicate the processes of Terravats to extremely precise degrees. The biosynth vat is required for the manipulation or editing of anything that posesses complex genetic makeup, such as body parts, creatures, and even humanoids.
\n\nWhile a terravat's contents can be freely modified, a biosynth tree will only use the required resources when the operation is called, and the items are used immediately.
\nCheck the 'information' section of the biosynth tree to see all possible recipes.</description>
    <size>(1,1)</size>
    <graphicData>
      <texPath>Things/Building/Terravats/SmallVat/Empty</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
      <drawSize>(1.8,1.8)</drawSize>
      <drawOffset>(0,0,0.3)</drawOffset>
      <drawRotated>false</drawRotated>
      <damageData>
        <rect>(0.3,0,2.7,1)</rect>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <statBases>
      <WorkToBuild>600</WorkToBuild>
      <Mass>10</Mass>
      <MaxHitPoints>100</MaxHitPoints>
      <Flammability>1.0</Flammability>
    </statBases>
    <fillPercent>0.5</fillPercent>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <hasInteractionCell>true</hasInteractionCell>
    <!--<designationCategory>EcotechDesignation</designationCategory>-->
    <uiIconScale>0.5</uiIconScale>
    <maxTechLevelToBuild>Ultra</maxTechLevelToBuild>
    <researchPrerequisites>
      <li>ET_SmallTerravats</li>
    </researchPrerequisites>
    <drawerType>MapMeshAndRealTime</drawerType>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>42</pathCost>
    <surfaceType>Item</surfaceType>
    <killedLeavings>
      <WoodLog>12</WoodLog>
    </killedLeavings>
    <building>
      <deconstructible>false</deconstructible>
      <artificialForMeditationPurposes>false</artificialForMeditationPurposes>
      <buildingTags>
        <li>Production</li>
      </buildingTags>
      <destroySound>BuildingDestroyed_Wood_Small</destroySound>
    </building>
    <tickerType>Normal</tickerType>
    <rotatable>true</rotatable>
    <uiOrder>2710</uiOrder>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>3.9</glowRadius>
        <glowColor>(239,84,203,0)</glowColor>
      </li>
      <li Class="CVNPlantUtils.CompProperties_AssemblingItem">
        <isAssemblingPawn>false</isAssemblingPawn>
        <uiIconChooseRecipe>Things/Building/powernode_researchlink</uiIconChooseRecipe>
        <uiIconStartProcess>Things/Building/powernode_researchlink</uiIconStartProcess>
        <useConnectedFacility>false</useConnectedFacility>
        <useZone>false</useZone>
        <radius>10</radius>
        <effectWorking>ConstructMetal</effectWorking>
        <recipeSet>
          <li>
            <label>breed terraplate armor</label>
            <duration>3000</duration>
            <resultDef>ET_PrimaHeavyArmor</resultDef>
            <amount>1</amount>
            <ingredientSets>
              <li>
                <thingDef>ET_Brightsap</thingDef>
                <amount>3</amount>
              </li>
            </ingredientSets>
          </li>
        </recipeSet>
      </li>
    </comps>
    <specialDisplayRadius>10</specialDisplayRadius>
  </ThingDef>
</Defs>