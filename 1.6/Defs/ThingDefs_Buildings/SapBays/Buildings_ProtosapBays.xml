      <li Class="CompProperties_Glower">
        <glowRadius>2.9</glowRadius>
        <glowColor>(132,197,193,0)</glowColor>
      </li>
    </comps>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <uiOrder>2621</uiOrder>
  </ThingDef>

</Defs>
