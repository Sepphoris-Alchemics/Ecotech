<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<ThingDef ParentName="ApparelBase" Name="LithicApparelBase" Abstract="True">
		<techLevel>Neolithic</techLevel>
		<smeltable>false</smeltable>
		<tickerType>Normal</tickerType>
		<tradeTags>
			<li>ET_LithicArmorTag</li>
		</tradeTags>
	</ThingDef>

<!--TO-DO: LITHIC MANTLE

MANTLE WILL HAVE 2 STAGES ON LAUNCH

	-BASE STAGE: WILL INCLUDE "FORTIFY" ABILITY
	-SECOND STAGE STAGE: WILL INCLUDE "SHOCK BURST" ABILITY
	-THIRD STAGE: WILL INCLUDE "LIGHTNING BOLT" ABILITY

ARMOR ABILITIES:
	FORTIFY: INCREASES DEFENSES FOR A COUPLE HOURS BUT DECREASES MOVEMENT, ETC. FOR THE SAMER ABOUTN OF TIME
	SHOCK BURST: FIRES A BURST OF ELECTRICITY THAT SHOCKS A TARGETS IN A SMALL AREA. DAMAGE + CHANCE TO EMP
	LIGHTNING BOLT: FIRES A DIRECTED BOLT OF LIGHTNING AT A TARGET. MEDIUM RANGE, MEDIUM DAMAGE


ANOTHER ARMOR WILL INCLUDE THE FOURTH STAGE:
	STORM BARRAGE: FIRES 5 QUICK BLASTS OF ELECTRIC DAMAGE ON A TARGET. 
-->

	<ThingDef ParentName="PlantApparelBase">
		<defName>ET_LithicLightArmorT1</defName>
		<label>genesite mantle</label>
		<techLevel>Neolithic</techLevel>
		<description>An armor of ancient stone, far different from any stone time found on the planet's surface, or even within the atmosphere.
This particular set of armor - which is more akin to a protective working suit - was made with efficiency in mind, layering *just* enough of the stone to provide protection, while also not being heavy or imposing movement restrictions.
The stone that this armor is made of is exceptionally durable, and does not decay that easily.
This specific set can be modified and charged with Shocksap provide offensive functions. However, this change will slightly diminish it's defensive capabilities.</description>
		<graphicData>
			<texPath>Things/Apparel/Terraplate/TerraplateArmor</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>1</drawSize>
		</graphicData>
		<generateCommonality>0</generateCommonality>
		<statBases>
			<Mass>4.6</Mass>
			<MaxHitPoints>600</MaxHitPoints>			<!--Durability is 60% of base, rounded up to nearest 5th)-->
			<MarketValue>200</MarketValue>
			<Flammability>0</Flammability>
			<ArmorRating_Sharp>0.2</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.25</ArmorRating_Blunt>
			<ArmorRating_Heat>0.15</ArmorRating_Heat>
			<Insulation_Cold>2</Insulation_Cold>
			<Insulation_Heat>5</Insulation_Heat>
			<EquipDelay>14</EquipDelay>
		</statBases>
		<thingCategories>
			<li>ApparelArmor</li>
		</thingCategories>
		<equippedStatOffsets>
			<MoveSpeed>-0.2</MoveSpeed>
			<IncomingDamageFactor>-.2</IncomingDamageFactor>
		</equippedStatOffsets>
		<apparel>
			<tags>
				<li>LithicArmor</li>
			</tags>
			<wornGraphicPath>Things/Apparel/Terraplate/TerraplateArmor</wornGraphicPath>
			<layers>
				<li>OnSkin</li>
				<li>Middle</li>
				<li>Shell</li>
			</layers>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Neck</li>
				<li>Shoulders</li>
				<li>Arms</li>
				<li>Legs</li>
				<li>Feet</li>
				<li>Waist</li>
			</bodyPartGroups>
			<defaultOutfitTags>
				<li>Soldier</li>
			</defaultOutfitTags>
		</apparel>
		<comps>
			<li Class="CompProperties_InspectString">
				<inspectString>&lt;color=#68bd46&gt;Organic-class&lt;/color&gt; | Immutable
-10% damage taken | 10% Toxic Resistance | -15% speed</inspectString>
			</li>
        <li Class="Ecotech.ThingCompProperties_EquippedLifespan">
          <compClass>Ecotech.ThingComp_EquippedLifespan</compClass>
          <lifespanTicks>1620000</lifespanTicks>
          <lifespanBarColor>(81, 89, 45)</lifespanBarColor>
        </li>
		</comps>
	</ThingDef>

	<ThingDef ParentName="PlantApparelBase">
		<defName>ET_PrimaHeavyHelmet</defName>
		<label>terraplate helmet</label>
		<techLevel>Neolithic</techLevel>
		<description>A helmet that is intended to be grown (and worn) alongside Terraplate armor. Due to the armor being fully formed before being worn, the helmet has to be grown seperately.</description>
		<graphicData>
			<texPath>Things/Apparel/Terraplate_helm/TerraplateHelmet</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>0.8</drawSize>
		</graphicData>
		<statBases>
			<Mass>2.4</Mass>
			<MaxHitPoints>60</MaxHitPoints>
			<MarketValue>80</MarketValue>
			<Flammability>0.8</Flammability>
			<ArmorRating_Sharp>0.35</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.2</ArmorRating_Blunt>
			<ArmorRating_Heat>0.1</ArmorRating_Heat>
			<Insulation_Cold>10</Insulation_Cold>
			<Insulation_Heat>5</Insulation_Heat>
