			<ToxicEnvironmentResistance>0.1</ToxicEnvironmentResistance>
			<VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.67</VacuumResistance>
		</equippedStatOffsets>
		<thingCategories>
			<li>ApparelArmor</li>
		</thingCategories>
		<generateCommonality>0</generateCommonality>
		<apparel>
			<tags>
				<li>HeavyPlantArmor</li>
