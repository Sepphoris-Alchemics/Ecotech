<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<RecipeDef>
    <defName>ET_TerraforgeSeedRecipe</defName>
    <label>shape channeling seed (terraforge)</label>
    <description>Shape a seed that will quickly grow into a terraforge.</description>
    <jobString>shaping a terraforge.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Plants</workSkill>
      <skillRequirements>
        <Plants>4</Plants>
      </skillRequirements>
    <researchPrerequisite>ET_OrganicTerratechEssentials</researchPrerequisite>
    <effectWorking>Sculpt</effectWorking>
    <soundWorking>Recipe_MakeBow</soundWorking>
    <workAmount>3200</workAmount>
    <allowMixingIngredients>false</allowMixingIngredients>
    <targetCountAdjustment>1</targetCountAdjustment>
    <products>
      <ET_Seed_Terraforge>1</ET_Seed_Terraforge>
    </products>
    <displayPriority>1</displayPriority>
  </RecipeDef>

<RecipeDef>
    <defName>ET_TerrathystCrucibleRecipe</defName>
    <label>form terrathyst crucible cluster</label>
    <description>Shape a cluster of crystals that will grow into a terrathyst crucible. Terrathyst Crucibles use sap and lithic fragments to form crystal clusters, and to grow weapons around terrathyst cores.</description>
    <jobString>shaping a crystal cluster.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Plants</workSkill>
    <skillRequirements>
      <Crafting>4</Crafting>
    </skillRequirements>
  <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>ET_Terrathyst</li>
          </thingDefs>
        </filter>
        <count>3</count>
      </li>
    </ingredients>
    <researchPrerequisite>ET_LithicTerratechEssentials</researchPrerequisite>
    <effectWorking>Sculpt</effectWorking>
    <soundWorking>Recipe_Smith</soundWorking>
    <workAmount>3200</workAmount>
    <allowMixingIngredients>false</allowMixingIngredients>
    <targetCountAdjustment>1</targetCountAdjustment>
    <products>
      <ET_Seed_TerrathystCrucible>1</ET_Seed_TerrathystCrucible>
    </products>
    <displayPriority>2</displayPriority>
  </RecipeDef>

</Defs>