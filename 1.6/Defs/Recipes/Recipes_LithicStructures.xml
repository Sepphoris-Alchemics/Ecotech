<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <RecipeDef>
    <defName>ET_TerrathystCrucibleRecipe</defName>
    <label>form terrathyst crucible cluster</label>
    <description>Shape a cluster of crystals that will grow into a terrathyst crucible. Terrathyst Crucibles use sap and lithic fragments to form crystal clusters, and to grow weapons around terrathyst cores.</description>
    <jobString>shaping a crystal cluster.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Plants</workSkill>
    <skillRequirements>
      <Plants>3</Plants>
    </skillRequirements>
<ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>ET_Terrathyst</li>
          </thingDefs>
        </filter>
        <count>3</count>
      </li>
    </ingredients>
    <researchPrerequisite>ET_LithicTerratechEssentials</researchPrerequisite>
    <effectWorking>Sculpt</effectWorking>
    <soundWorking>Recipe_MakeBow</soundWorking>
    <workAmount>1600</workAmount>
    <allowMixingIngredients>false</allowMixingIngredients>
    <targetCountAdjustment>1</targetCountAdjustment>
    <products>
      <ET_Seed_LithicForgeTierOne>1</ET_Seed_LithicForgeTierOne>
    </products>
    <displayPriority>0</displayPriority>
  </RecipeDef>

