<RecipeDef>
    <defName>ET_PerennialRandomWeaponRecipe</defName>
    <label>salvage laser weapon</label>
    <description>Create a random perennial weapon from a periwood core.</description>
    <jobString>Carving perennial weapon.</jobString>
    <workSpeedStat>ResearchSpeed</workSpeedStat>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <workAmount>10000</workAmount>
    <unfinishedThingDef>ET_UnfinishedTier2Heart</unfinishedThingDef>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentSpacerEco</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>ComponentSpacerEco</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <ET_RandomTier2Weapon>1</ET_RandomTier2Weapon>
    </products>
	<researchPrerequisite>ET_PerennialSeeds</researchPrerequisite>
		<skillRequirements>
			<Intellectual>2</Intellectual>
		</skillRequirements>
    <workSkill>Intellectual</workSkill>
    <recipeUsers>
			<li>ET_Terraforge</li>
		</recipeUsers>
  </RecipeDef>
</Defs>