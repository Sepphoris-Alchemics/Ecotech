<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <RecipeDef>
    <defName>ET_PrimaBrightsapLampSeedRecipe</defName>
    <label>shape channeling seed (brightlamp) </label>
    <description>Shape a seed that will quickly grow into a Brightlamp. Brightlamps take a few days to grow, but provide light that only requires brightsap.
\n\nThe roots grow deep enough to allow the seed to be growable on any solid surface.</description>
    <jobString>shaping a brightlamp seed.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Plants</workSkill>
    <skillRequirements>
      <Plants>6</Plants>
    </skillRequirements>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>ET_Brightsap</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>ET_Brightsap</li>
      </thingDefs>
    </fixedIngredientFilter>
    <researchPrerequisite>ET_BrightsapStructures</researchPrerequisite>
    <effectWorking>Sculpt</effectWorking>
    <soundWorking>Recipe_MakeBow</soundWorking>
    <workAmount>2800</workAmount>
    <allowMixingIngredients>false</allowMixingIngredients>
    <targetCountAdjustment>1</targetCountAdjustment>
    <products>
      <ET_Seed_PrimaBrightsapLamp>1</ET_Seed_PrimaBrightsapLamp>
    </products>
    <displayPriority>908</displayPriority>
  </RecipeDef>

  <RecipeDef>
    <defName>ET_PrimaBrightsapColumnSeedRecipe</defName>
    <label>shape channeling seed (brightsap column) </label>
    <description>Shape a seed that will quickly grow into a Brightsap Column. Brightsap columns take a few days to grow, but provide light that only requires brightsap. Be sure that any roof you want it to support is supported by something else until it is fully grown!
\n\nThe roots grow deep enough to allow the seed to be growable on any solid surface.</description>
    <jobString>shaping a brightsap column seed.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Plants</workSkill>
    <skillRequirements>
      <Plants>6</Plants>
    </skillRequirements>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>ET_Brightsap</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>ET_Brightsap</li>
      </thingDefs>
    </fixedIngredientFilter>
    <researchPrerequisite>ET_BrightsapStructures</researchPrerequisite>
    <effectWorking>Sculpt</effectWorking>
    <soundWorking>Recipe_MakeBow</soundWorking>
    <workAmount>2800</workAmount>
    <allowMixingIngredients>false</allowMixingIngredients>
    <targetCountAdjustment>1</targetCountAdjustment>
    <products>
      <ET_Seed_PrimaBrightsapColumn>1</ET_Seed_PrimaBrightsapColumn>
    </products>
    <displayPriority>909</displayPriority>
  </RecipeDef>

 <RecipeDef>
    <defName>ET_ProtosapBaySeedRecipe</defName>
    <label>shape protosap bay seed (brightsap)</label>
    <description>Shape a seed that will grow into a brightsap bay. Protosap bays take time to grow, but allow a way to grow terraplants in environments with little to no suitable terrains.
\n\nThe roots grow deep enough to allow the seed to be growable on any solid surface. When planted, the way the plant grows can be manually determined, allowing you to define the space it'll grow into.</description>
    <jobString>shaping a brightsap bay seed.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Plants</workSkill>
    <skillRequirements>
      <Plants>6</Plants>
    </skillRequirements>
    <researchPrerequisite>ET_GrownProtosapBays</researchPrerequisite>
    <effectWorking>Sculpt</effectWorking>
    <soundWorking>Recipe_MakeBow</soundWorking>
    <workAmount>3200</workAmount>
    <allowMixingIngredients>false</allowMixingIngredients>
    <targetCountAdjustment>1</targetCountAdjustment>
    <products>
      <ET_Seed_BrightsapBay>1</ET_Seed_BrightsapBay>
    </products>
    <displayPriority>910</displayPriority>
  </RecipeDef>
</Defs>