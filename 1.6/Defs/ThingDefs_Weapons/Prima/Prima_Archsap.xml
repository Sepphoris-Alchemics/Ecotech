<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!--Endosap differences:
	50% higher item health
	75% lower flammability-->

<!--=====Prima SMG=====-->

<!--=====Prima Carbine=====-->

	<ThingDef ParentName="BaseUnmodifiedTerraweapon">
		<defName>ET_PrimaCarbineArchsap</defName>
		<label>prima archobine</label>
		<description>An infused variant of the Prima Carbine. It's baseline sap has been replaced with archsap, which is capable of self-sustainment, and thus grants it an unlimited lifespan.</description>
		<graphicData>
			<texPath>Things/WeaponPrima/Archsap/PrimaCarbineUpgraded_AS</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>1</drawSize>
		</graphicData>
		<soundInteract>Interact_Rifle</soundInteract>
		<weaponTags Inherit='False'>
      <li>ET_PlantWeapon</li>
		</weaponTags>
    <relicChance>0</relicChance>
		<statBases>
      <MaxHitPoints>55</MaxHitPoints> <!--50% of 35 = 17.5; rounds to nearest 5th, which is 20; 35+20=55-->
			<AccuracyTouch>0.70</AccuracyTouch>
			<AccuracyShort>0.80</AccuracyShort>
			<AccuracyMedium>0.70</AccuracyMedium>
			<AccuracyLong>0.40</AccuracyLong>
			<RangedWeapon_Cooldown>1</RangedWeapon_Cooldown>
			<DeteriorationRate>0</DeteriorationRate>
			<Mass>1.6</Mass>
			<Flammability>1.5</Flammability> <!--50% of 3-->
      <WorkToMake>12000</WorkToMake>
		</statBases>
		<techLevel>Neolithic</techLevel>
		<smeltable>false</smeltable>
    <equippedAngleOffset>50</equippedAngleOffset>
    <verbs> <!--First one is if VWE Makeshift becomes unavailable-->
      <!--<li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_ThornCarbine</defaultProjectile>
        <warmupTime>0.6</warmupTime>
        <range>23.9</range>
				<burstShotCount>2</burstShotCount>
				<ticksBetweenBurstShots>7</ticksBetweenBurstShots>
        <soundCast>Shot_AssaultRifle</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>0</muzzleFlashScale>
      </li>-->
      <li>
        <verbClass>VEF.Weapons.Verb_MakeshiftShoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_ThornCarbine</defaultProjectile>
        <warmupTime>0.6</warmupTime>
        <range>23.9</range>
				<burstShotCount>2</burstShotCount>
				<ticksBetweenBurstShots>7</ticksBetweenBurstShots>
        <soundCast>ET_Sound_BlowgunMedium</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>0</muzzleFlashScale>
      </li>
    </verbs>
		<tools>
			<li>
				<label>grip</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<tickerType>Normal</tickerType>
		<comps>
			<li Class="CompProperties_SelfhealHitpoints">
				<ticksPerHeal>12000</ticksPerHeal>				<!-- 6k ticks = 10hp/day, 12k ticks = 5hp/day, 18k = 3.75hp/day 24k ticks = 2.5hp/day -->
			</li>
			<li Class="CompProperties_InspectString">
				<inspectString>&lt;color=#68bd46&gt;Organic-class&lt;/color&gt; | &lt;color=#D5DA3A&gt;Infused with Archsap&lt;/color&gt;
&lt;color=#D5DA3A&gt;Unlimited Lifespan&lt;/color&gt; | &lt;color=#D5DA3A&gt;+50% health&lt;/color&gt;</inspectString>
			</li>
		</comps>
		<modExtensions>
			<li Class="VEF.Weapons.MoteProperties">
				<fleckDef>WoodBit</fleckDef>
				<size>0.2</size>
				<velocity>1</velocity>
				<angleRange>-15~15</angleRange>
				<rotationRange>-5~5</rotationRange>
				<numTimesThrown>1</numTimesThrown>
			</li>
			<li Class="VEF.Weapons.MakeshiftProperties">
				<shots>2~5</shots>
			</li>
		</modExtensions>
	</ThingDef>

<!--=====Prima Twincaster=====-->

	<ThingDef ParentName="UpgradedArchsapTerraweapon">
		<defName>ET_PrimaTwincasterArchsap</defName>
		<label>Archocaster</label>
		<description>The second-generation form of the Prima Stakecaster, infused with Archosap. The presence of the sap has enabled the stakecaster to create self-rejuvinating sap, eliminating it's limited lifespan.
\nUnfortunately the sap has also neutralized the Twincaster's growth potential, preventing it from being evolved further.</description>
		<graphicData>
			<texPath>Things/WeaponPrima/Archsap/PrimaCrossbowUpgraded_AS</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>1</drawSize>
		</graphicData>
		<soundInteract>Interact_Rifle</soundInteract>
		<weaponTags Inherit='False'>
			<li>ET_PlantWeapon</li>
		</weaponTags>
		<weaponClasses>
			<li>LongShots</li>
			<li>Ranged</li>
			<li>RangedHeavy</li>
		</weaponClasses>
		<relicChance>0</relicChance>
		<statBases>
			<MaxHitPoints>90</MaxHitPoints>			<!--+50% hitpoints-->
			<AccuracyTouch>0.70</AccuracyTouch>			<!--.05 higher accuracies than dormant-->
			<AccuracyShort>0.70</AccuracyShort>
			<AccuracyMedium>0.80</AccuracyMedium>
			<AccuracyLong>0.60</AccuracyLong>
			<RangedWeapon_Cooldown>1.125</RangedWeapon_Cooldown>
			<DeteriorationRate>0</DeteriorationRate>
			<Mass>2.8</Mass>
			<Flammability>1.5</Flammability>
			<WorkToMake>4000</WorkToMake>
		</statBases>
		<techLevel>Neolithic</techLevel>
		<smeltable>false</smeltable>
		<equippedAngleOffset>50</equippedAngleOffset>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_StakeBriar</defaultProjectile>
				<warmupTime>3</warmupTime>
				<range>32.9</range>
				<burstShotCount>2</burstShotCount>
				<ticksBetweenBurstShots>12</ticksBetweenBurstShots>
				<soundCast>ET_Sound_LightStake</soundCast>
				<muzzleFlashScale>0</muzzleFlashScale>
			</li>
		</verbs>
		<tools>
			<li>
				<label>grip</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<tickerType>Normal</tickerType>
		<comps>
			<li Class="CompProperties_SelfhealHitpoints">
				<ticksPerHeal>12000</ticksPerHeal>				<!-- 6k ticks = 10hp/day, 12k ticks = 5hp/day, 18k = 3.75hp/day 24k ticks = 2.5hp/day -->
			</li>
			<li Class="CompProperties_InspectString">
				<inspectString>&lt;color=#68bd46&gt;Organic-class&lt;/color&gt; | &lt;color=#D5DA3A&gt;Infused with Archsap&lt;/color&gt;
&lt;color=#D5DA3A&gt;Unlimited Lifespan&lt;/color&gt; | &lt;color=#D5DA3A&gt;+50% health&lt;/color&gt;</inspectString>
			</li>
		</comps>
	</ThingDef>

</Defs>