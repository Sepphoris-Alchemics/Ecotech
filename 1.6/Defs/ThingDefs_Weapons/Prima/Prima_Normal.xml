<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<!--
TIME TICK BASICS:
60,000 = 1 day
900,000 = 1 quadrum (15 days)
3,600,000	 = 1 quadrum (60 days)

Upgraded Primas get +10 health and -1 flammability. 1.2 lifespan times below:
			-Immature light: 30 days (1800000) | 30 health
			-Immature normal: 45 days (2700000) | 35 health
			-Immature heavy: 60 days (3600000) | 50 health

			-Mature light: 45 days (2700000) | 40 health
			-Mature normal: 60 days (3600000) | 45 health
			-Mature heavy: 75 days (4500000) | 50 health
-->

	<ThingDef ParentName="BaseUnmodifiedPrimaWeapon"> <!--Counterpart: Greatbow-->
		<defName>ET_PrimaStakecaster</defName> <!--has the pod growth time and research level of light weapons, but the duration of heavy-->
		<label>Primcaster</label>
		<description>A biotic weapon, patterned off of a heavy bolt caster, and grown straight from a specialized pod. Extremely powerful and capable of inflicting deadly wounds, but is slow to aim, with equally slow projectile speed.\n\nThis weapon is entirely organic; it has a limited lifetime and will eventually expire, but can be easily regrown.</description>
		<graphicData>
			<texPath>Things/WeaponPrima/Basic/ET_PrimaCrossbowBasic</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>0.95</drawSize>
		</graphicData>
		<soundInteract>Interact_Rifle</soundInteract>
		<weaponTags Inherit='False'>
      <li>ET_PlantWeapon</li>
		</weaponTags>
    <weaponClasses>
			<li>LongShots</li>
      <li>Ranged</li>
			<li>RangedHeavy</li>
    </weaponClasses>
    <relicChance>0</relicChance>
		<statBases>
      <MaxHitPoints>40</MaxHitPoints>
			<AccuracyTouch>0.65</AccuracyTouch>
			<AccuracyShort>0.65</AccuracyShort>
			<AccuracyMedium>0.75</AccuracyMedium>
			<AccuracyLong>0.55</AccuracyLong>
			<RangedWeapon_Cooldown>1.125</RangedWeapon_Cooldown> <!--CD lowered by 25% instead of 50%-->
			<DeteriorationRate>0</DeteriorationRate>
			<Mass>2.6</Mass>
			<Flammability>3</Flammability>
      <WorkToMake>4000</WorkToMake>
		</statBases>
		<techLevel>Neolithic</techLevel>
		<smeltable>false</smeltable>
    <equippedAngleOffset>50</equippedAngleOffset>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_StakeLight</defaultProjectile>
        <warmupTime>3</warmupTime>
        <range>31.9</range>
        <soundCast>ET_Sound_LightStake</soundCast>
        <muzzleFlashScale>0</muzzleFlashScale>
      </li>
    </verbs>
		<tools>
			<li>
				<label>grip</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<tickerType>Normal</tickerType>
		<comps>
        <li Class="Ecotech.ThingCompProperties_EquippedLifespan">
          <compClass>Ecotech.ThingComp_EquippedLifespan</compClass>
          <lifespanTicks>2700000</lifespanTicks> <!--45 days-->
          <lifespanBarColor>(81, 89, 45)</lifespanBarColor>
          <!--<expireEffect></expireEffect>-->
					<!--<replacementToSpawn>ChunkSlagSteel</replacementToSpawn>-->
        </li>
      <li Class="Ecotech.ThingCompProperties_InstallableInSlottedThingTransformer"/>
		</comps>
	</ThingDef>

	<ThingDef ParentName="BaseUnmodifiedPrimaWeapon"> <!--Counterpart: Pump Shotgun-->
		<defName>ET_PrimaShotgun</defName>
		<label>prima scattershot</label>
		<description>A biotic weapon, patterned off of a semi-automatic shotgun, and grown straight from a specialized pod. They are quite powerful, but have very limited range and speed.\n\nThis weapon is entirely organic; it has a limited lifetime and will eventually expire, but can be easily regrown.</description>
