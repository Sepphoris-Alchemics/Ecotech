<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!--Hypersap differences are applied to their dormant form.
At their matured form, they are given their maturity increases-->

	<ThingDef ParentName="UpgradedHypersapTerraweapon_Burst">
		<defName>ET_HypercasterI</defName>
		<label>Hypercaster I</label>
		<description>A special iteration of the Stakecaster evolution line. The addition of Hypersap has improved the range, projectile speed, fire rate, and projectile potential.
\nStronger variants of the Hypercaster exist, which can be achieved by replacing the sap of higher-evolved Stakecasters.</description>
		<graphicData>
			<texPath>Things/WeaponPrima/Hypersap/PrimaCrossbowUpgraded_HS</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>1</drawSize>
		</graphicData>
		<soundInteract>Interact_Rifle</soundInteract>
		<weaponTags Inherit='False'>
      <li>ET_PlantWeapon</li>
		</weaponTags>
    <weaponClasses>
      <li>LongShots</li>
      <li>Ranged</li>
			<li>RangedHeavy</li>
    </weaponClasses>
    <relicChance>0</relicChance>
		<statBases>
      <MaxHitPoints>60</MaxHitPoints>
			<AccuracyTouch>0.70</AccuracyTouch> <!--.05 higher accuracies than dormant-->
			<AccuracyShort>0.70</AccuracyShort>
			<AccuracyMedium>0.80</AccuracyMedium>
			<AccuracyLong>0.60</AccuracyLong>
			<RangedWeapon_Cooldown>0.925</RangedWeapon_Cooldown> <!--lowered from 1.125-->
			<DeteriorationRate>0</DeteriorationRate>
			<Mass>2.8</Mass>
			<Flammability>2</Flammability>
      <WorkToMake>4000</WorkToMake>
		</statBases>
		<techLevel>Neolithic</techLevel>
		<smeltable>false</smeltable>
    <equippedAngleOffset>50</equippedAngleOffset>
    <verbs>
      <li>
        <verbClass>VEF.Weapons.Verb_MakeshiftShoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_StakeLight</defaultProjectile>
        <warmupTime>3</warmupTime>
        <range>34.9</range>
        <burstShotCount>2</burstShotCount>
        <ticksBetweenBurstShots>12</ticksBetweenBurstShots>
        <soundCast>ET_Sound_LightStake</soundCast>
        <muzzleFlashScale>0</muzzleFlashScale>
      </li>
    </verbs>
		<!--<verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_StakeBriar</defaultProjectile>
        <warmupTime>3</warmupTime>
        <range>34.9</range>
        <burstShotCount>2</burstShotCount>
        <ticksBetweenBurstShots>12</ticksBetweenBurstShots>
        <soundCast>ET_Sound_LightStake</soundCast>
        <muzzleFlashScale>0</muzzleFlashScale>
      </li>
    </verbs>-->
		<tools>
			<li>
				<label>grip</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<tickerType>Normal</tickerType>
		<comps>
        <li Class="Ecotech.ThingCompProperties_EquippedLifespan">
          <compClass>Ecotech.ThingComp_EquippedLifespan</compClass>
          <lifespanTicks>1080000</lifespanTicks> <!-- due to second iteration, this will still have the expiry time of it's dormant form-->
          <lifespanBarColor>(159, 115, 255)</lifespanBarColor>
        </li>
		</comps>
		<modExtensions>
			<li Class="VEF.Weapons.MoteProperties">
				<fleckDef>WoodBit</fleckDef>
				<size>0.2</size>
				<velocity>1</velocity>
				<angleRange>-15~15</angleRange>
				<rotationRange>-5~5</rotationRange>
				<numTimesThrown>2</numTimesThrown>
			</li>
			<li Class="VEF.Weapons.MakeshiftProperties">
				<shots>3~4</shots> <!--Hypersap burst count min/max increases by 1 every iteration.-->
			</li>
		</modExtensions>
	</ThingDef>

</Defs>