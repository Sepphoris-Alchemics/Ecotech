<Defs>

<!--
TIME TICK BASICS:
60,000 = 1 day
900,000 = 1 quadrum (15 days)
3,600,000	 = 1 quadrum (60 days)

Upgraded Primas get +10 health and -1 flammability. 1.2 lifespan times below:
			-Immature light: 30 days (1800000) | 30 health
			-Immature normal: 45 days (2700000) | 35 health
			-Immature heavy: 60 days (3600000) | 50 health

			-Mature light: 45 days (2700000) | 40 health
			-Mature normal: 60 days (3600000) | 45 health
			-Mature heavy: 75 days (4500000) | 50 health
-->

	<ThingDef ParentName="BaseWeapon">
		<defName>ET_PrimaKnife</defName>
		<label>terraknife</label>
		<description>A biotic curved dagger. One of the weakest terraweapons, but extremely quick to attack with, and to grow.</description>
		<graphicData>
			<texPath>Things/WeaponPrima/Basic/ET_PrimaKnifeBasic</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>0.8</drawSize>
		</graphicData>
    <!--<costList>
      <WoodLog>30</WoodLog>
    </costList>-->
    <thingCategories>
      <li>BasicTerraweapons</li>
    </thingCategories>
		<weaponTags Inherit='False'>
      <li>ET_PlantWeapon</li>
			<li>ET_PrimaMeleeBasic</li>
		</weaponTags>
    <relicChance>0</relicChance>
		<statBases>
      <MaxHitPoints>30</MaxHitPoints>
			<Mass>0.3</Mass>
			<Flammability>3</Flammability>
			<DeteriorationRate>0</DeteriorationRate>
		</statBases>
		<techLevel>Neolithic</techLevel>
		<smeltable>false</smeltable>
    <equippedAngleOffset>50</equippedAngleOffset>
		<tools>
			<li>
				<label>handle</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>blade</label>
				<capacities>
					<li>Cut</li>
					<li>Poke</li>
				</capacities>
				<power>11</power>
				<cooldownTime>1.5</cooldownTime>
			</li>
      <li>
        <label>point</label>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>12</power>
        <cooldownTime>1.5</cooldownTime>
      </li>
		</tools>
		<comps>
        <li Class="Ecotech.ThingCompProperties_EquippedLifespan">
          <compClass>Ecotech.ThingComp_EquippedLifespan</compClass>
          <lifespanTicks>1800000</lifespanTicks>
          <lifespanBarColor>(81, 89, 45)</lifespanBarColor>
          <!--<expireEffect></expireEffect>-->
					<!--<replacementToSpawn>ChunkSlagSteel</replacementToSpawn>-->
        </li>
		</comps>
    <tradeTags Inherit ='False'>
      <li>ET_BasePrimaWeaponTag</li>
    </tradeTags>
	</ThingDef>

