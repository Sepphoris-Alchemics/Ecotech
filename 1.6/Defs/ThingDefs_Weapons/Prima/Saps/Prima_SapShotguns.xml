<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!--Endosap differences:
	50% higher item health
	75% lower flammability
	Mass increase of .5-->

	<!--=====Endosap=====-->

	<ThingDef ParentName="ET_PrimaShotgunSapBase">
		<defName>ET_PrimaShotgunEndosap</defName>
		<label>prima endoburster</label>
		<description>The matured form of the Prima Spreadshot, infused with endosap. The presence of the endosap has enabled the pincaster to create a more durable epidermis, and decreasing flammability.</description>
		<graphicData>
			<texPath>Things/WeaponPrima/Endosap/PrimaShotgunUpgraded_ES</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>0.9</drawSize>
		</graphicData>
		<soundInteract>Interact_Shotgun</soundInteract>
		<weaponTags Inherit='False'>
			<li>ET_PlantWeapon</li>
			<li>ET_PrimaRangedUpgraded</li>
			<li>ET_PlantWeaponEndosap</li>
		</weaponTags>
		<weaponClasses>
			<li>ShortShots</li>
			<li>Ranged</li>
		</weaponClasses>
		<statBases>
			<MaxHitPoints>70</MaxHitPoints>
			<Mass>1.9</Mass>
			<Flammability>0.5</Flammability>
		</statBases>
		<verbs Inherit="False">
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_BriarShotgun</defaultProjectile>
				<warmupTime>1.125</warmupTime>
				<range>13.9</range>				<!--1 higher range than it's dormant form-->
				<soundCast>Shot_Shotgun</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>0</muzzleFlashScale>
			</li>
		</verbs>
		<comps>
			<li Class="CompProperties_InspectString">
				<inspectString>&lt;color=#68bd46&gt;Organic-class&lt;/color&gt; | Infused with Endosap
+15 health | +10 lifespan days</inspectString>
			</li>
			<li Class="Ecotech.ThingCompProperties_EquippedLifespan">
				<compClass>Ecotech.ThingComp_EquippedLifespan</compClass>
				<lifespanTicks>4200000</lifespanTicks>
				<lifespanBarColor>(50, 127, 59)</lifespanBarColor>
				<!--<expireEffect></expireEffect>-->
				<replacementToSpawn>ET_Seed_PrimaApexTurret</replacementToSpawn>
			</li>
			<li Class="CompProperties_SelfhealHitpoints">
				<ticksPerHeal>18000</ticksPerHeal>				<!-- 6k ticks = 10hp/day, 12k ticks = 5hp/day, 24k ticks = 2.5hp/day -->
			</li>
		</comps>
	</ThingDef>

	<!--=====Hypersap=====-->

	<ThingDef ParentName="ET_PrimaShotgunSapBase">
		<defName>ET_PrimaShotgunHypersap</defName>
		<label>prima hyperburster</label>
		<description>The matured form of the Prima Spreadshot, infused with hypersap. infused with the hypersap. The presence of the sap has increased it's range, projectile speed, and enabled the possibility of multiple shots.</description>
		<graphicData>
			<texPath>Things/WeaponPrima/Hypersap/PrimaShotgunUpgraded_HS</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>0.9</drawSize>
		</graphicData>
		<soundInteract>Interact_Shotgun</soundInteract>
		<weaponTags Inherit='False'>
			<li>ET_PlantWeapon</li>
			<li>ET_PrimaRangedUpgraded</li>
			<li>ET_PlantWeaponHypersap</li>
		</weaponTags>
		<weaponClasses>
			<li>ShortShots</li>
			<li>Ranged</li>
		</weaponClasses>
		<verbs Inherit="False">
			<li>
				<verbClass>VEF.Weapons.Verb_MakeshiftShoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_BriarShotgun</defaultProjectile>
				<warmupTime>1.125</warmupTime>
				<range>15.9</range>
				<burstShotCount>1</burstShotCount>
				<ticksBetweenBurstShots>10</ticksBetweenBurstShots>
				<soundCast>ET_Sound_BlowgunLight</soundCast>
				<soundCastTail>GunTail_Light</soundCastTail>
				<muzzleFlashScale>0</muzzleFlashScale>
			</li>
		</verbs>
		<comps>
			<li Class="CompProperties_InspectString">
				<inspectString>&lt;color=#68bd46&gt;Organic-class&lt;/color&gt; | Infused with Hypersap
+2 range | Fires 1-4 shots | +2.5 hp/day (unequipped)</inspectString>
			</li>
			<li Class="Ecotech.ThingCompProperties_EquippedLifespan">
				<compClass>Ecotech.ThingComp_EquippedLifespan</compClass>
				<lifespanTicks>3600000</lifespanTicks>
				<lifespanBarColor>(50, 127, 59)</lifespanBarColor>
				<!--<expireEffect></expireEffect>-->
				<replacementToSpawn>ET_Seed_PrimaApexTurret</replacementToSpawn>
			</li>
			<li Class="CompProperties_SelfhealHitpoints">
				<ticksPerHeal>18000</ticksPerHeal>				<!-- 6k ticks = 10hp/day, 12k ticks = 5hp/day, 24k ticks = 2.5hp/day -->
			</li>
		</comps>
		<modExtensions>
			<li Class="VEF.Weapons.MoteProperties">
				<fleckDef>WoodBit</fleckDef>
				<size>0.2</size>
				<velocity>1</velocity>
				<angleRange>-15~15</angleRange>
				<rotationRange>-5~5</rotationRange>
				<numTimesThrown>1</numTimesThrown>
			</li>
			<li Class="VEF.Weapons.MakeshiftProperties">
				<shots>1~3</shots>
			</li>
		</modExtensions>
	</ThingDef>

