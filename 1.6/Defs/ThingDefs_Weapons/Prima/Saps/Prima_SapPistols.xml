<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!--Endosap differences:
	50% higher item health
	75% lower flammability
	Mass increase of .5-->


	<!--=====Archsap=====-->

	<ThingDef ParentName="UpgradedArchsapTerraweapon"> <!--Counterpart: Revolver-->
		<defName>ET_PrimaPistolArchsap</defName>
		<label>prima archopistol</label>
		<description>The matured form of the prima minishot. While still not very powerful, it's easily carried, has decent lifepspan length, and the damage is strong enough to fend against predators and raiders. It's still vastly inferior to other weapons, however.\n\nThis weapon is entirely organic; it has a limited lifetime and will eventually expire, but can be easily regrown.</description>
		<graphicData>
			<texPath>Things/WeaponPrima/Archsap/PrimaPistolUpgraded_AS</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>0.7</drawSize>
		</graphicData>
		<soundInteract>Interact_Revolver</soundInteract>
		<weaponTags Inherit='False'>
			<li>ET_PlantWeaponAdvanced</li>
			<li>ET_PlantWeaponArchsap</li>
		</weaponTags>
    <weaponClasses>
			<li>RangedLight</li>
      <li>Ranged</li>
    </weaponClasses>
    <relicChance>0</relicChance>
		<statBases>
      <MaxHitPoints>60</MaxHitPoints>
			<AccuracyTouch>0.85</AccuracyTouch>
			<AccuracyShort>0.85</AccuracyShort>
			<AccuracyMedium>0.50</AccuracyMedium>
			<AccuracyLong>0.20</AccuracyLong>
			<RangedWeapon_Cooldown>0.8</RangedWeapon_Cooldown>
			<DeteriorationRate>0</DeteriorationRate>
			<Mass>1.4</Mass>
			<Flammability>4</Flammability>
      <WorkToMake>4000</WorkToMake>
		</statBases>
		<techLevel>Neolithic</techLevel>
		<smeltable>false</smeltable>
    <equippedAngleOffset>50</equippedAngleOffset>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_ThornPistol</defaultProjectile>
        <warmupTime>0.375</warmupTime>
        <range>25.9</range>
        <soundCast>ET_Sound_BlowgunLight</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
        <muzzleFlashScale>0</muzzleFlashScale>
      </li>
    </verbs>
		<tools>
			<li>
				<label>grip</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<tickerType>Normal</tickerType>
			<comps>
			<li Class="CompProperties_SelfhealHitpoints">
				<ticksPerHeal>12000</ticksPerHeal>				<!-- 6k ticks = 10hp/day, 12k ticks = 5hp/day, 18k = 3.75hp/day 24k ticks = 2.5hp/day -->
			</li>
		</comps>
	</ThingDef>

</Defs>