  <ThingDef ParentName="ResourceBase">
    <defName>ET_SoulsnareRifleDrained</defName>
    <label>Drained soulsnare rifle</label>
    <description>A soulsnare rifle that is devoid of even the slightest charge. Due to how inert it is, the crystals it once posessed have completely deteriorated.
You will need to bring this weapon to a geocharger to regrow the crystals, and make it usable again. The absence of crystals has regressed it to stage I.
5 starsap is required to restore it to a usable condition, on top of the shocksap required to charge it.</description>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/WeaponLithoid/Soulsnare/Soulsnare_d</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.2</drawSize>
    </graphicData>
    <stackLimit>1</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <intricate>true</intricate>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <MarketValue>5.5</MarketValue>
