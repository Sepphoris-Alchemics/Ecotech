<Defs>

	<!--WAYLIGHT CYCLER MECHANICS:
		-The WAYLIGHT CYCLER is a hybrid rifle that can be attuned to various wavelengths of light, each having different effects.
		-The WAYLIGHT CYCLER starts off in it's Class-K stage.
			-The damage values and stats are incredibly low, on part with a standard assault rifle or carbine.
			-It is charged with shocksap in this state.
		-When the WAYLIGHT CYCLER is imbued with sunsap or starsap, it's class-type is increased.
			-The class-types are as followed:
				-Stage 1: K-Class
				-Stage 2: F-Class
				-Stage 3: B-Class
				-Stage 4: O-Class
			-Class O can only be acquired by using Starsap on a B-Class
		-The WAYLIGHT CYCLER gains the following at each class:
				-Class K: Fires projectiles that deal additional EMP and burning damage.
				-Class F: Fires a flare deals a massive burst of burning damage + damage to all mechanoids and electrical structures.
				-Class B: Stat increases, projectile count increases.
				-Class O: Gains a ray with 150 range that has extremely high accuracy and damage.
		-Like other Waylight creations, this weapon can be broken down to discover Stellarite.
		-Waylight weapons can also use sunsap to be restored.
		-Like most other Lithic weapons, the WAYLIGHT CYCLER has some basic rules it follows:
			-It will never truly expire.
			-Lifespans are extremely long, and at full charge it can easily last over a year, if not two.
			-The theme of the weapon is pretty straightforward.
				-This weapon is based around the Harvard classifications of main sequence stars
		-->

<!--Stage 1-->

	<ThingDef ParentName="BaseWaylightTerraweapon">
		<defName>ET_WaylightRifleOne</defName>
		<label>waylight rifle (K-Class)</label>
		<description>A rifle forged from metal of a star, and also burning with the heart of one. One of the few Stellar-class weapons that has managed to remain on the Rimworld.
\n\nIt's lithic hybridization allows it to be upgraded, like other lithic weapons. However, it's stellar nature requires the upgrade materials to be sunsap or starsap, as opposed to shocksap.
\nOne should be very careful when using this weapon; stellar energy is extremely powerful... both in damage output, and should the weapon itself get destroyed!
\n\nThe waylight rifle requires 1 sunsap or starsap to successfully be heated into it's next class.</description>
		<graphicData>
			<texPath>Things/WeaponLithoid/Waylight/Waylight_a</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>1.2</drawSize>
		</graphicData>
		<soundInteract>Interact_Rifle</soundInteract>
		<weaponTags Inherit='False'>
			<li>ET_StellarWeapon</li>
			<li>ET_StellarWeaponStageOne</li>
			<li>ET_SpacetouchedWeapon</li>
		</weaponTags>
		<weaponClasses>
			<li>Ranged</li>
		</weaponClasses>
		<relicChance>0</relicChance>
		<statBases>
			<MaxHitPoints>160</MaxHitPoints>
			<AccuracyTouch>0.30</AccuracyTouch>
			<AccuracyShort>0.40</AccuracyShort>
			<AccuracyMedium>0.60</AccuracyMedium>
			<AccuracyLong>0.75</AccuracyLong>
			<RangedWeapon_Cooldown>0.75</RangedWeapon_Cooldown>
			<DeteriorationRate>0</DeteriorationRate>
			<Mass>5.4</Mass> <!--Heavy due to stellar mass, but not as heavy as a pure stellar-->
			<Flammability>0</Flammability>
			<WorkToMake>12000</WorkToMake>
		</statBases>
		<techLevel>Neolithic</techLevel>
		<smeltable>false</smeltable>
		<equippedAngleOffset>30</equippedAngleOffset>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_WaylightRifle</defaultProjectile>
				<warmupTime>2</warmupTime>
				<burstShotCount>2</burstShotCount>
				<ticksBetweenBurstShots>4</ticksBetweenBurstShots>
				<range>26.9</range>
				<soundCast>ET_Sound_BlowgunMedium</soundCast>
				<muzzleFlashScale>0</muzzleFlashScale>
			</li>
		</verbs>
		<tools>
			<li>
				<label>grip</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<tickerType>Rare</tickerType>
		<comps>
			<li Class="Ecotech.ThingCompProperties_EquippedLifespan">
				<compClass>Ecotech.ThingComp_EquippedLifespan</compClass>
				<!--<lifespanTicks>2700000</lifespanTicks>-->
				<lifespanBarColor>(53, 71, 108)</lifespanBarColor>
			</li>
			<li Class="CompProperties_InspectString">
				<inspectString>&lt;color=#CB943E&gt;Hybrid-class&lt;/color&gt; | &lt;color=#D46F44&gt;Stage I&lt;/color&gt;
Innate EMP damage | ??? | ??? | ???</inspectString>
			</li>
