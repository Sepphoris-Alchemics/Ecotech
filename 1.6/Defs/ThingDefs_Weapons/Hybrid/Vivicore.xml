			<texPath>Things/WeaponRanged/Wild/VivicoreRifle</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>0.8</drawSize>
		</graphicData>
		<soundInteract>Interact_Rifle</soundInteract>
		<weaponTags Inherit='False'>
			<li>ET_PlantWeapon</li>
			<li>HybridWeapons</li>
			<li>ET_CoretouchedWeapon</li>
		</weaponTags>
		<weaponClasses>
			<li>Ranged</li>
		</weaponClasses>
		<relicChance>0.1</relicChance>
		<statBases>
			<Beauty>12</Beauty>
			<MaxHitPoints>70</MaxHitPoints>
			<AccuracyTouch>0.30</AccuracyTouch>
			<AccuracyShort>0.50</AccuracyShort>
			<AccuracyMedium>0.40</AccuracyMedium>
			<AccuracyLong>0.20</AccuracyLong>
			<RangedWeapon_Cooldown>3</RangedWeapon_Cooldown>
			<DeteriorationRate>0</DeteriorationRate>
			<Mass>2.4</Mass>
			<Flammability>0.5</Flammability>
			<WorkToMake>12000</WorkToMake>
			<MarketValue>2200</MarketValue>
		</statBases>
		<techLevel>Neolithic</techLevel>
		<smeltable>false</smeltable>
		<equippedAngleOffset>50</equippedAngleOffset>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_WeakCrystalRifle</defaultProjectile>
				<warmupTime>2.125</warmupTime>
				<burstShotCount>1</burstShotCount>
				<ticksBetweenBurstShots>21</ticksBetweenBurstShots>
				<range>21.9</range>
				<soundCast>ET_Sound_BlowgunMedium</soundCast>
				<muzzleFlashScale>0</muzzleFlashScale>
			</li>
		</verbs>
		<tools>
			<li>
				<label>grip</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<tickerType>Normal</tickerType>
		<comps> <!--to-do: add ammo mechanic, make sure ammunition is generous-->
			<li Class="CompProperties_SelfhealHitpoints">
				<ticksPerHeal>48000</ticksPerHeal> <!--To-do: set to 1HP per day-->
			</li>
			<li Class="Ecotech.ThingCompProperties_EquippedLifespan">
				<compClass>Ecotech.ThingComp_EquippedLifespan</compClass> 
				<lifespanTicks>960000</lifespanTicks> <!--Should be twice as long as a standard wild weapon-->
				<lifespanBarColor>(174, 81, 123)</lifespanBarColor> <!--To-do: find a unique color for biolith-->
				<!--<expireEffect></expireEffect>-->
				<!--<replacementToSpawn>ChunkSlagSteel</replacementToSpawn>-->
			</li>
