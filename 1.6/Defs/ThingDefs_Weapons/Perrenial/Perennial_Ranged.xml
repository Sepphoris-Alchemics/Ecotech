<Defs>



	<!--Periwood Rifle-->
	<ThingDef ParentName="BasePeriwoodTerraweapon">
		<defName>ET_PeriwoodRifle</defName>		<!--Counterpart: Minigun-->
		<label>Periwood PSR</label>
		<description>The Periwood PSR (Plated Suppression Rifle) is a biotic weapon, carved from the heart of an Periwood Tree. The PSR is capable of firing bursts at relatively long ranges. Combines with it's high AP and projectile speed. This makes it a very effective suppresive weapon, or as a weapon meant to injure and down a target, with lowered chances of outright killing them.
\n\nPeriwood weapons have a very long lifespan, but they still do eventually expire. However, the living moss patches they posess allows them to be replanted, and (rougly after a quadrum) fully revitilized.</description>
		<graphicData>
			<texPath>Things/WeaponPeriwood/Basic/ET_PeriwoodRifleBasic</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>1.2</drawSize>
		</graphicData>
		<soundInteract>Interact_Rifle</soundInteract>
		<weaponTags Inherit='False'>
			<li>ET_PlantWeapon</li>
			<li>ET_PeriwoodWeapon</li>
		</weaponTags>
		<weaponClasses>
			<li>Ranged</li>
		</weaponClasses>
		<relicChance>0</relicChance>
		<statBases>
			<MaxHitPoints>45</MaxHitPoints>			<!--- mid/long range is increased by 0.15, touch/short decreased by 0.15-->
			<AccuracyTouch>0.15</AccuracyTouch>
			<AccuracyShort>0.15</AccuracyShort>
			<AccuracyMedium>0.40</AccuracyMedium>
			<AccuracyLong>0.32</AccuracyLong>
			<RangedWeapon_Cooldown>1.15</RangedWeapon_Cooldown>			<!--half of the counterpart-->
			<DeteriorationRate>0</DeteriorationRate>
			<Mass>1.6</Mass>
			<Flammability>3</Flammability>
			<WorkToMake>15000</WorkToMake>
		</statBases>
		<!--Crafting-->
		<costList>
			<ET_TierTwoWeaponHeart>1</ET_TierTwoWeaponHeart>
			<ET_Brightsap>2</ET_Brightsap>
		</costList>
		<recipeMaker>
			<workSpeedStat>WorkSpeedGlobal</workSpeedStat>
			<workSkill>Crafting</workSkill>
			<effectWorking>Sculpt</effectWorking>
			<unfinishedThingDef IsNull="True" />
			<recipeUsers>
				<li>ET_Terraforge</li>
			</recipeUsers>
			<workAmount>15000</workAmount>
			<skillRequirements>
				<Plants>6</Plants>
				<Artistic>3</Artistic>
			</skillRequirements>
			<researchPrerequisite>
				<li>ET_PeriwoodCarving</li>
			</researchPrerequisite>
		</recipeMaker>
	<!--End of crafting-->
		<techLevel>Neolithic</techLevel>
		<smeltable>false</smeltable>
		<equippedAngleOffset>50</equippedAngleOffset>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_PeriwoodNeedle</defaultProjectile>				<!--the damage and count isn't the same, but the overall damage is right below the Heavy SMG-->
				<warmupTime>2.1</warmupTime>				<!--0.4 faster than it's counterpart-->
				<burstShotCount>3</burstShotCount>
				<ticksBetweenBurstShots>4</ticksBetweenBurstShots>
				<range>25.9</range>				<!--five less than it's counterpart-->
				<soundCast>ET_Sound_Needle1</soundCast>
				<muzzleFlashScale>0</muzzleFlashScale>
			</li>
		</verbs>
		<tools>
			<li>
				<label>grip</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<tickerType>Normal</tickerType>
		<comps>
			<li Class="CompProperties_SelfhealHitpoints">
				<ticksPerHeal>24000</ticksPerHeal>				<!-- 6k ticks = 10hp/day, 12k ticks = 5hp/day, 24k ticks = 2.5hp/day -->
			</li>
			<li Class="Ecotech.ThingCompProperties_EquippedLifespan">
				<compClass>Ecotech.ThingComp_EquippedLifespan</compClass>
				<lifespanTicks>1200000</lifespanTicks>
				<lifespanBarColor>(91, 61, 48)</lifespanBarColor>
				<!--<expireEffect></expireEffect>-->
				<!--<replacementToSpawn>ChunkSlagSteel</replacementToSpawn>-->
			</li>
			<li Class="CompProperties_Plantable">
				<plantDefToSpawn>ET_PeriwoodRifleGrowthPod</plantDefToSpawn>
			</li>
			<li Class="CompProperties_InspectString">
				<inspectString>&lt;color=#68bd46&gt;Organic-class&lt;/color&gt; | &lt;color=#dae691&gt;Immutable&lt;/color&gt;
Renewable | Unable to be evolved or infused</inspectString>
			</li>
		</comps>
	</ThingDef>

