<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef ParentName="InjuryBase">
    <defName>ET_RadianceWound</defName>
    <label>flash burn</label>
    <labelNoun>a burn caused by intense, sudden heat</labelNoun>
    <description>A flash burn.</description>
    <tendable>true</tendable>
    <comps>
      <li Class="HediffCompProperties_TendDuration">
        <labelTendedWell>bandaged</labelTendedWell>
        <labelTendedWellInner>sutured</labelTendedWellInner>
        <labelSolidTendedWell>set</labelSolidTendedWell>
      </li>
      <li Class="HediffCompProperties_GetsPermanent">
        <permanentLabel>old flash burn</permanentLabel>
        <instantlyPermanentLabel>deep flash burn</instantlyPermanentLabel>
      </li>
    </comps>
    <injuryProps>
      <painPerSeverity>0.0125</painPerSeverity>
      <averagePainPerSeverityPermanent>0.00625</averagePainPerSeverityPermanent>
      <bleedRate>0</bleedRate>
      <canMerge>true</canMerge>
      <destroyedLabel>flash burnt</destroyedLabel>
      <destroyedOutLabel>flash-burned off</destroyedOutLabel>
    </injuryProps>
  </HediffDef>

  <HediffDef>
    <defName>ET_RadianceBuildup</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(1, 1, 0.9)</defaultLabelColor>
    <label>radiant flash</label>
    <initialSeverity>0.3</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <tendable>false</tendable>
    <canAffectBionicOrImplant>false</canAffectBionicOrImplant>
    <description>Blindness and disorientation caused by a source of sudden, intense light.</description>
    <alwaysShowSeverity>true</alwaysShowSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-5</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <label>dim vision</label>
        <minSeverity>.1</minSeverity>
        <capMods>
          <li>
            <capacity>Sight</capacity>
            <offset>-0.2</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>disoriented</label>
        <minSeverity>.4</minSeverity>
        <capMods>
          <li>
            <capacity>Sight</capacity>
            <offset>-0.4</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.2</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>blinded</label>
        <minSeverity>.6</minSeverity>
        <capMods>
          <li>
            <capacity>Sight</capacity>
            <offset>-0.8</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.4</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>blinded</label>
        <minSeverity>.8</minSeverity>
        <capMods>
          <li>
            <capacity>Sight</capacity>
            <offset>-1</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.5</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <!--=====Psychic Whispers: Minor=====-->

  <HediffDef>
    <defName>ET_PsychicWhispersBuildupMinor</defName>
    <defaultLabelColor>(0.7, 1.0, 0.7)</defaultLabelColor>
    <hediffClass>HediffWithComps</hediffClass>
    <label>psychic voices</label>
    <makesSickThought>false</makesSickThought>
    <initialSeverity>0.1</initialSeverity>
    <minSeverity>0.001</minSeverity>
    <maxSeverity>1</maxSeverity>
    <canAffectBionicOrImplant>false</canAffectBionicOrImplant>
    <description>Unintelligible voices that constantly barrage the mind. While not lethal, the effect can linger for a good while and disrupt concentration.</description>
    <alwaysShowSeverity>true</alwaysShowSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDayRange>-0.2</severityPerDayRange>
      </li>
    </comps>
    <stages>
      <li>
        <label>white noise</label>
        <minSeverity>0.001</minSeverity>
      </li>
      <li>
        <label>whispers</label>
        <minSeverity>0.2</minSeverity>
        <statOffsets>
          <GlobalLearningFactor>-0.2</GlobalLearningFactor>
        </statOffsets>
        <mentalBreakMtbDays>15</mentalBreakMtbDays>
        <statFactors>
          <RestFallRateFactor>1.25</RestFallRateFactor>
        </statFactors>
        <allowedMentalBreakIntensities>
          <li>Minor</li>
        </allowedMentalBreakIntensities>
      </li>
      <li>
        <label>raised voices</label>
        <minSeverity>0.6</minSeverity>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.1</offset>
          </li>
        </capMods>
        <statOffsets>
          <GlobalLearningFactor>-0.4</GlobalLearningFactor>
        </statOffsets>
        <mentalBreakMtbDays>10</mentalBreakMtbDays>
        <statFactors>
          <RestFallRateFactor>1.5</RestFallRateFactor>
        </statFactors>
        <allowedMentalBreakIntensities>
          <li>Minor</li>
        </allowedMentalBreakIntensities>
      </li>
      <li>
        <label>wailing</label>
        <minSeverity>0.8</minSeverity>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.4</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.5</offset>
          </li>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.15</offset>
          </li>
        </capMods>
        <statOffsets>
          <GlobalLearningFactor>-0.6</GlobalLearningFactor>
        </statOffsets>
        <mentalBreakMtbDays>5</mentalBreakMtbDays>
        <statFactors>
          <RestFallRateFactor>1.75</RestFallRateFactor>
        </statFactors>
        <allowedMentalBreakIntensities>
          <li>Minor</li>
        </allowedMentalBreakIntensities>
      </li>
      <li>
        <label>wailing</label>
        <minSeverity>0.9</minSeverity>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.5</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.6</offset>
          </li>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.2</offset>
          </li>
        </capMods>
        <statOffsets>
          <GlobalLearningFactor>-0.8</GlobalLearningFactor>
        </statOffsets>
        <mentalBreakMtbDays>5</mentalBreakMtbDays>
        <statFactors>
          <RestFallRateFactor>2</RestFallRateFactor>
        </statFactors>
        <allowedMentalBreakIntensities>
          <li>Minor</li>
        </allowedMentalBreakIntensities>
        <hediffGivers>
          <li Class="HediffGiver_Random">
            <hediff>PsychicComa</hediff>
            <mtbDays>30</mtbDays>
            <partsToAffect>
              <li>Brain</li>
            </partsToAffect>
          </li>
        </hediffGivers>
      </li>
    </stages>
  </HediffDef>

  <!--=====Mental Disruption: Minor=====-->

  <HediffDef>
    <defName>ET_MentalDisruptionBuildupMinor</defName>
    <defaultLabelColor>(0.7, 1.0, 0.7)</defaultLabelColor>
    <hediffClass>HediffWithComps</hediffClass>
    <label>mental inhibitors</label>
    <makesSickThought>false</makesSickThought>
    <initialSeverity>0.1</initialSeverity>
    <minSeverity>0.001</minSeverity>
    <maxSeverity>1</maxSeverity>
    <canAffectBionicOrImplant>false</canAffectBionicOrImplant>
    <description>Nerve disruptions that cause distrurbance to conciousness, and may even cause short-term mental lapses.</description>
    <alwaysShowSeverity>true</alwaysShowSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDayRange>-0.2</severityPerDayRange>
      </li>
    </comps>
    <stages>
      <li>
        <label>minor</label>
        <minSeverity>0.001</minSeverity>
      </li>
      <li>
        <label>minor</label>
        <minSeverity>0.2</minSeverity>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.1</offset>
          </li>
        </capMods>
        <mentalStateGivers>
          <li>
            <mentalState>Wander_Psychotic_Short</mentalState>
            <mtbDays>45</mtbDays>
          </li>
        </mentalStateGivers>
      </li>
      <li>
        <label>moderate</label>
        <minSeverity>0.6</minSeverity>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.15</offset>
          </li>
        </capMods>
        <mentalStateGivers>
          <li>
            <mentalState>Wander_Psychotic_Short</mentalState>
            <mtbDays>30</mtbDays>
          </li>
        </mentalStateGivers>
      </li>
      <li>
        <label>severe</label>
        <minSeverity>0.8</minSeverity>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.2</offset>
          </li>
        </capMods>
        <mentalStateGivers>
          <li>
            <mentalState>Wander_Psychotic_Short</mentalState>
            <mtbDays>15</mtbDays>
          </li>
        </mentalStateGivers>
      </li>
    </stages>
  </HediffDef>

  <!--=====Muscle Disruption: Minor=====-->

  <HediffDef>
    <defName>ET_MuscleDisruptionBuildupMinor</defName>
    <defaultLabelColor>(0.7, 1.0, 0.7)</defaultLabelColor>
    <hediffClass>HediffWithComps</hediffClass>
    <label>mental inhibitors</label>
    <makesSickThought>false</makesSickThought>
    <initialSeverity>0.1</initialSeverity>
    <minSeverity>0.001</minSeverity>
    <maxSeverity>1</maxSeverity>
    <canAffectBionicOrImplant>false</canAffectBionicOrImplant>
    <description>Nerve disruptions that cause distrurbance to conciousness, and may even cause short-term mental lapses.</description>
    <alwaysShowSeverity>true</alwaysShowSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDayRange>-0.2</severityPerDayRange>
      </li>
    </comps>
    <stages>
      <li>
        <label>minor</label>
        <minSeverity>0.001</minSeverity>
      </li>
      <li>
        <label>minor</label>
        <minSeverity>0.2</minSeverity>
        <capMods>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.1</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>moderate</label>
        <minSeverity>0.6</minSeverity>
        <capMods>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.2</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.1</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>severe</label>
        <minSeverity>0.8</minSeverity>
        <capMods>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.25</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.15</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
</Defs>