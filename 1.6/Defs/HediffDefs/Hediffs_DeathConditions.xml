<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef>
    <defName>ET_TestAlchemize</defName>
    <description>Turning into precious metals.
\nThis probably sucks.</description>
    <descriptionShort>Turning into precious metals.</descriptionShort>
    <hediffClass>HediffWithComps</hediffClass>
    <label>alchemizing</label>
    <defaultLabelColor>(203,148,62)</defaultLabelColor>
    <scenarioCanAdd>false</scenarioCanAdd>
    <maxSeverity>1</maxSeverity>
    <lethalSeverity>1</lethalSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.6</severityPerDay>
      </li>
      <li Class="Ecotech.HediffCompProperties_DropOnDeath">
        <drops>
          <li>
            <thingDef>Jade</thingDef>
              <countRange>
                <min>1</min>
                <max>25</max>
              </countRange>
            <chance>0.2</chance>
            <minSeverity>0.3</minSeverity>
            <maxSeverity>0.9</maxSeverity>
          </li>
          <li>
            <thingDef>Silver</thingDef>
              <countRange>
                <min>1</min>
                <max>50</max>
              </countRange>
              <chance>0.5</chance>
              <maxSeverity>0.8</maxSeverity>
          </li>
                <!-- Guaranteed drop -->
                <li>
                    <thingDef>Gold</thingDef>
                    <countRange>
                        <min>1</min>
                        <max>50</max>
                    </countRange>
                    <chance>1</chance>
                    <minSeverity>0.9</minSeverity>
                </li>
            </drops>
        </li>
    </comps>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <label>metallizing</label>
        <painFactor>1.2</painFactor>
      </li>

      <li>
        <minSeverity>0.3</minSeverity>
        <label>slightly alchemized</label>
        <painFactor>1.4</painFactor>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.05</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.1</offset>
          </li>
        </capMods>
      </li>

      <li>
        <minSeverity>0.5</minSeverity>
        <label>moderately alchemized</label>
        <painFactor>1.6</painFactor>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.10</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.25</offset>
          </li>
        </capMods>
      </li>

      <li>
        <minSeverity>0.7</minSeverity>
        <label>heavily alchemized</label>
        <painFactor>1.8</painFactor>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.35</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.5</offset>
          </li>
        </capMods>
        <hediffGivers>
          <li Class="HediffGiver_Random">
            <hediff>Blindness</hediff>
            <mtbDays>9</mtbDays>
          </li>
        </hediffGivers>
      </li>

      <li>
        <minSeverity>0.9</minSeverity>
        <label>completely alchemized</label>
        <painFactor>2</painFactor>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.9</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.75</offset>
          </li>
        </capMods>
        <hediffGivers>
          <li Class="HediffGiver_Random">
            <hediff>Blindness</hediff>
            <mtbDays>3</mtbDays>
          </li>
        </hediffGivers>
      </li>
    </stages>
  </HediffDef>

</Defs>