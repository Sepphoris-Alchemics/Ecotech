<!--===== alchemic inhibitor =====-->

  <ThingDef ParentName="ET_BodyPartLithicBase">
    <defName>ET_AlchemicInhibitor</defName>
    <label>midas wardlimb</label>
    <description>A highly specialized procedure that prevents one's body from transmuting in any way. This implant forces any transmutation to be focused on 'dummy' flesh that the body discards and quickly regenerates.
One must replace an entire limb of their choice for this process, as the transmutation requires a large space for the dummy flesh. The limb is still operational, however, albeit not as functional as a natural one.</description>
    <descriptionHyperlinks>
      <RecipeDef>ET_InstallAlchemicInhibitor</RecipeDef>
    </descriptionHyperlinks>
    <statBases>
      <MarketValue>800</MarketValue>
