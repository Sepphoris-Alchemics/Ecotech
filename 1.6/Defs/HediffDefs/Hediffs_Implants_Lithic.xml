          <RestFallRateFactor>-0.8</RestFallRateFactor>
		  <BedRestEffectiveness>-0.6</BedRestEffectiveness>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <ThingDef ParentName="ET_BodyPartLithicBase">
    <defName>ET_BiothiteWakegem</defName>
    <label>biothite slumbergem</label>
