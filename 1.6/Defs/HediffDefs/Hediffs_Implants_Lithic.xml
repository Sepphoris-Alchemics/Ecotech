    <label>install biothite nerve dampener</label>
    <description>Install biothite nerve dampener.</description>
    <descriptionHyperlinks>
      <ThingDef>ET_BiothiteNerveDampener</ThingDef>
      <HediffDef>ET_BiothiteNerveDampener</HediffDef>
    </descriptionHyperlinks>
    <jobString>Installing biothite nerve dampener.</jobString>
    <surgeryOutcomeEffect IsNull="True" /> <!-- Always succeeds -->
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>ET_BiothiteNerveDampener</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>ET_BiothiteNerveDampener</li>
      </thingDefs>
    </fixedIngredientFilter>
    <appliedOnFixedBodyParts>
      <li>Spine</li>
    </appliedOnFixedBodyParts>
    <addsHediff>ET_BiothiteNerveDampener</addsHediff>
