<!--===== Biothite Nerve Dampener =====-->

<HediffDef ParentName="ImplantHediffBase">
    <defName>ET_BiothiteNerveDampener</defName>
    <label>biothite nerve dampener</label>
    <description>A specialized biothite implant that melds directly to the spinal cord. Suppresses most pain, but makes the person more suspectable to disease.</description>
    <addedPartProps>
      <solid>true</solid>
    </addedPartProps>
	<stages>
      <li>
	  	<painOffset>-0.9</painOffset>
        <statFactors>
      		<ImmunityGainSpeed>0.8</ImmunityGainSpeed>
    	</statFactors>
      </li>
    </stages>
  </HediffDef>

  <ThingDef ParentName="ET_BodyPartOrganicBase">
    <defName>ET_BiothiteNerveDampener</defName>
    <label>biothite nerve dampener</label>
    <description>A specialized biothite implant that melds directly to the spinal cord. Specifically eliminates pain reception almost entirely, while still allowing nerves to recieve generally favorable signals.
\nUnfortunately, the lack of pain also makes the person more suspectable to disease. Cannot be removed.</description>
    <descriptionHyperlinks>
		<RecipeDef>ET_InstallBiothiteNerveDampener</RecipeDef>
	</descriptionHyperlinks>
    <statBases>
      <Mass>0.2</Mass>
      <WorkToMake>24000</WorkToMake>
    </statBases>
    <!--<techHediffsTags>
      <li>ET_OrganicTechTag</li>
    </techHediffsTags>-->
  </ThingDef>

  <RecipeDef ParentName="SurgeryInstallBodyPartArtificialBase">
