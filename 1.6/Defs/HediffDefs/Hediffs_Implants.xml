<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<HediffDef>
		<defName>ET_NutrientRootsHediff</defName>
		<hediffClass>Hediff</hediffClass>
		<label>nutrient roots</label>
		<labelNoun>nutrient roots</labelNoun>
		<defaultLabelColor>(178,102,255)</defaultLabelColor>
		<description>Microgrowths that are located at the bottom of the feet. These growths pierce the terrain and quickly absorb nutrients found within it, lowering hunger rate. Unfortunately, it also lowers movement speed.
The roots can be made larger and more effective, but keep in mind that movement speed is impacted as well.</description>
		<initialSeverity>0.3</initialSeverity>
		<stages>
			<li>
        <minSeverity>0.3</minSeverity>
        <label>I</label>
				<hungerRateFactorOffset>-0.5</hungerRateFactorOffset>
				<capMods>
					<li>
						<capacity>Moving</capacity>
						<offset>-0.2</offset>
					</li>
				</capMods>
			</li>
      <li>
        <minSeverity>0.6</minSeverity>
        <label>II</label>
				<hungerRateFactorOffset>-0.7</hungerRateFactorOffset>
				<capMods>
					<li>
						<capacity>Moving</capacity>
						<offset>-0.4</offset>
					</li>
				</capMods>
			</li>
      <li>
        <minSeverity>0.9</minSeverity>
        <label>III</label>
				<hungerRateFactorOffset>-0.9</hungerRateFactorOffset>
				<capMods>
					<li>
						<capacity>Moving</capacity>
						<offset>-0.6</offset>
					</li>
				</capMods>
			</li>
		</stages>
	</HediffDef>

</Defs>