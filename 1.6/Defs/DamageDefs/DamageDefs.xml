<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--Glowsap damage-->
  <DamageDef>
    <defName>ET_GlowsapExplosionDamage</defName>
    <label>sap coating</label>
    <workerClass>DamageWorker_AddInjury</workerClass>
    <externalViolence>true</externalViolence>
    <isRanged>true</isRanged>
    <impactSoundType>Slice</impactSoundType>
    <hediff>Burn</hediff>
    <additionalHediffs>
    <li>
      <hediff>ET_GlowsapPoisoning</hediff>
      <severityPerDamageDealt>0.1</severityPerDamageDealt>
      <victimSeverityScaling>ToxicResistance</victimSeverityScaling>
      <inverseStatScaling>true</inverseStatScaling>
      <victimSeverityScalingByInvBodySize>true</victimSeverityScalingByInvBodySize>
    </li>
  </additionalHediffs>
  <harmsHealth>true</harmsHealth>
  <harmAllLayersUntilOutside>true</harmAllLayersUntilOutside>
  <armorCategory>Heat</armorCategory>
  <defaultArmorPenetration>0</defaultArmorPenetration>
  <explosionCellMote>Mote_SmokeFlake</explosionCellMote>
  <explosionColorCenter>(232, 225, 165)</explosionColorCenter>
  <explosionColorEdge>(232, 225, 165)</explosionColorEdge>
  <soundExplosion>DeathAcidifier</soundExplosion>
  <combatLogRules>Damage_Flame</combatLogRules>
  <buildingDamageFactor>0</buildingDamageFactor>
</DamageDef>

