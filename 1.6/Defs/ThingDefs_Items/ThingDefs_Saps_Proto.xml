<?xml version="1.0" encoding="utf-8" ?>
<Defs>
<!--
Protosaps are saps that the player can start coming across relatively early, and are generally used for weapons.
Infusion-wise, they apply or alter an aspect of a weapon, though not enough to where the weapon is drastically different.

The Protosaps are:
  -Toxsap
  -Surgesap
  -Brightsap
-->

  <ThingDef ParentName="ResourceBase">
    <defName>ET_Brightsap</defName>
    <label>Brightsap</label>
    <description>A jar of refined, potent terrasap, named due to the vibrant glow it emits. When used as a fuel in a Terraforge, this sap can completely revitialize and restore the lifespan of various Terraweapons within it. It is also used as a catalyst for light-emitting Terratech plants.
\n\nBrightsap can be used on any matured weapon within a Terravat. To use it, insert this sap as a fuel source, then insert the weapon you wish to revitalize.</description>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/Resource/Brightsap</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>0.8</drawSize>
    </graphicData>
    <stackLimit>30</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <intricate>true</intricate>    <!-- Not returned to player when product made of this is smelted. -->
    <statBases>
      <MaxHitPoints>75</MaxHitPoints>
      <MarketValue>104</MarketValue>
      <Mass>0.05</Mass>
      <Flammability>1</Flammability>
      <DeteriorationRate>0.25</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>ProtosapsAll</li>
    </thingCategories>
    <!--<comps>
      <li Class="CompProperties_Glower">
        <glowRadius>1.9</glowRadius>
        <glowColor>(370,370,370,0)</glowColor>
      </li>
    </comps>-->
    <modExtensions>
      <li Class="Ecotech.ThingDefExtension_TransformerRecipe">        <!--recipes used by Terravats-->
        <recipes>
          <!--Apex weapons-->
          <li>
            <fuelCount>1</fuelCount>            <!--how much fuel the Terravat uses for the process-->
            <inputThingDef>ET_PrimaSMGUpgraded</inputThingDef>            <!--the input item needed inside the Terravat-->
            <outputThingDef>ET_PrimaSMGUpgraded</outputThingDef>            <!--the item produced after the transformation-->
            <!--outputStuff only for items or structures that are stuffable-->
            <!--<outputStuff>WoodLog</outputStuff>-->
          </li>
          <li>
            <fuelCount>1</fuelCount>
            <inputThingDef>ET_PrimaTwincaster</inputThingDef>
            <outputThingDef>ET_PrimaTwincaster</outputThingDef>
          </li>
          <li>
            <fuelCount>1</fuelCount>
            <inputThingDef>ET_PrimaShotgunUpgraded</inputThingDef>
            <outputThingDef>ET_PrimaShotgunUpgraded</outputThingDef>
          </li>
          <li>
            <fuelCount>1</fuelCount>
            <inputThingDef>ET_PrimaStakecaster</inputThingDef>
            <outputThingDef>ET_PrimaStakecaster</outputThingDef>
          </li>
          <!--Light weapons-->
          <li>
            <fuelCount>1</fuelCount>
            <inputThingDef>ET_PrimaPistol</inputThingDef>
            <outputThingDef>ET_PrimaPistol</outputThingDef>
          </li>
          <li>
            <fuelCount>1</fuelCount>
            <inputThingDef>ET_PrimaSMG</inputThingDef>
            <outputThingDef>ET_PrimaSMG</outputThingDef>
          </li>
          <li>
            <fuelCount>1</fuelCount>
            <inputThingDef>ET_PrimaShotgun</inputThingDef>
            <outputThingDef>ET_PrimaShotgun</outputThingDef>
          </li>
          <li>
            <fuelCount>1</fuelCount>
            <inputThingDef>ET_PrimaCarbine</inputThingDef>
            <outputThingDef>ET_PrimaCarbine</outputThingDef>
          </li>
          <!--Heavy weapons-->
          <li>
            <fuelCount>1</fuelCount>
            <inputThingDef>ET_PrimaRifle</inputThingDef>
            <outputThingDef>ET_PrimaRifle</outputThingDef>
          </li>
          <li>
            <fuelCount>1</fuelCount>
            <inputThingDef>ET_Seedburster</inputThingDef>
            <outputThingDef>ET_Seedburster</outputThingDef>
          </li>
          <li>
            <fuelCount>1</fuelCount>
            <inputThingDef>ET_Hailcannon</inputThingDef>
            <outputThingDef>ET_Hailcannon</outputThingDef>
          </li>
          <li>
            <fuelCount>1</fuelCount>
            <inputThingDef>ET_PrimaSapLauncher_Basic</inputThingDef>
            <outputThingDef>ET_PrimaSapLauncher_Basic</outputThingDef>
          </li>
          <li>
            <fuelCount>1</fuelCount>
            <inputThingDef>ET_PrimaLMG</inputThingDef>
            <outputThingDef>ET_PrimaLMG</outputThingDef>
          </li>
          <!--Melee weapons-->
          <li>
            <fuelCount>1</fuelCount>
            <inputThingDef>ET_PrimaKnife</inputThingDef>
            <outputThingDef>ET_PrimaKnife</outputThingDef>
          </li>
          <li>
            <fuelCount>1</fuelCount>
            <inputThingDef>ET_PrimaMace</inputThingDef>
            <outputThingDef>ET_PrimaMace</outputThingDef>
          </li>
          <li>
            <fuelCount>1</fuelCount>
            <inputThingDef>ET_PrimaSword</inputThingDef>
            <outputThingDef>ET_PrimaSword</outputThingDef>
          </li>
        <!--New items-->
          <li>
            <fuelCount>30</fuelCount>
            <inputThingDef>Heart</inputThingDef>
            <outputThingDef>ET_PrimaHeavyArmor</outputThingDef>
          </li>
          <li>
            <fuelCount>15</fuelCount>
