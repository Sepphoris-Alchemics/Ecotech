  <!--=====SUNSAP AND STARSAP=====-->

  <ThingDef ParentName="ResourceBase">
    <defName>ET_Sunsap</defName>
    <label>Sunsap</label>
    <description>A jar of terrasap containing stellar energies that were captured directly from the local sun. This sap can only be created during daylight hours; weather does not matter.
\n\nSunsap has no innate ability, but like Starsap it has immense energy potential. Those with sufficient Terratech knowledge can create Brightsap at an incredibly efficient ratio, alongside supporting very advanced Terrastructures.
\n\nCurrent use cases:
Conversion into Brightsap (1:10 ratio)
Needed to grow Wild weaponry
Upgrades organic weapons into their pinnacle form
Highly valuable trade commodity with all EcoTech factions
(Notes: Will have more use cases when Lithoid weapons are added!)</description>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/Resource/Sunsap</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>0.8</drawSize>
    </graphicData>
    <stackLimit>30</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <intricate>true</intricate>
    <statBases>
      <MaxHitPoints>75</MaxHitPoints>
      <MarketValue>225</MarketValue>
      <Mass>0.05</Mass>
      <Flammability>1</Flammability>
      <DeteriorationRate>0.25</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>MetasapsAll</li>
    </thingCategories>
  </ThingDef>

