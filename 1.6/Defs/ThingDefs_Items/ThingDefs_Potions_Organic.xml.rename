<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<!--

Since hediff amount can't seemingly be controlled via surgery amount, it looks like
Bloompox will be imcreased in dosage via Hediff_Level. Each severity will increase by 1.
This means that the potions can't be administered like normal drugs or medical operations, but are done via gizmo.

-->

<!--=====Potion Base=====-->

<ThingDef Name="ET_LithicPotionBase" ParentName="ResourceBase" Abstract="True" >
    <thingClass>ThingWithComps</thingClass>
    <stackLimit>3</stackLimit>
    <socialPropernessMatters>false</socialPropernessMatters>
    <orderedTakeGroup>Drug</orderedTakeGroup>
    <statBases>
      <MaxHitPoints>30</MaxHitPoints>
      <MarketValue>200</MarketValue>
      <DeteriorationRate>2.0</DeteriorationRate>
      <Mass>0.5</Mass>
      <Flammability>0.3</Flammability>
    </statBases>
    <thingCategories>
      <li>Drugs</li>
    </thingCategories>
    <tradeTags>
      <li>ET_OrganicPotionBase</li>
    </tradeTags>
    <ingestible>
      <preferability>NeverForNutrition</preferability>
      <maxNumToIngestAtOnce>1</maxNumToIngestAtOnce>
      <defaultNumToIngestAtOnce>1</defaultNumToIngestAtOnce>
      <drugCategory>Medical</drugCategory>
      <foodType>Processed</foodType>
      <baseIngestTicks>100</baseIngestTicks>
      <humanlikeOnly>true</humanlikeOnly>
      <chairSearchRadius>0</chairSearchRadius>
      <ingestSound>Ingest_Pill</ingestSound>
      <ingestHoldUsesTable>false</ingestHoldUsesTable>
      <ingestCommandString>Ingest {0}</ingestCommandString>
      <ingestReportString>Ingesting {0}.</ingestReportString>
      <showIngestFloatOption>false</showIngestFloatOption>
      <outcomeDoers>
        <li Class="IngestionOutcomeDoer_UseThing" />
      </outcomeDoers>
    </ingestible>
    <comps>
      <li Class="CompProperties_Drug">
        <listOrder>1200</listOrder>
        <teetotalerCanConsume>true</teetotalerCanConsume>
      </li>
      <li Class="CompProperties_Usable">
        <useLabel>Use {0_label}</useLabel>
        <useJob>Ingest</useJob>
        <showUseGizmo>true</showUseGizmo>
        <allowedMutants>
          <li>Ghoul</li>
        </allowedMutants>
      </li>
      <li Class="CompProperties_Serum" />
    </comps>
    <recipeMaker>
      <productCount>1</productCount>
      <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <recipeUsers>
        <li>ET_PrimaTerraforge</li>
      </recipeUsers>
    </recipeMaker>
  </ThingDef>

