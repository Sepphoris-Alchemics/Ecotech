<Defs>

    <!--
Tome breakdown:
Tomes are used for unlocking technology straight from Terratech factions. The player needs to prove themselves to attain them.
Tomes are used to unlock special tech, generally ones that the Terratech faction uses themselves.
Currently, the tech are:

    -Wilderbark Conduit Tree (produces large bounties of barks)
    -Terravein Conduit Tree (creates proto and metasaps)
    -Thermotrees (stabilizes temperature)
    -Elemental Conduit Trees (produces elemental saps)

    -Elemental Saps (produces Embersap, Hydrosap, and Aerosap)
    -Stellar Sap Usage (allows further use of stellar saps)

    -Briar Tech (fusion of Periwood and Prima)
    -Rotvine Tech (the precise corruption of Bloomwood)
    -Wildheart Tech (easier growth of wild weapons)

    -Deepsap Terrain
    -Crystal Infusion (allows scopes on weapons, and a secondary fire method)
    -Terraplasms (allows saps to be made into living organisms)

    -Genekeys (used for creating genomes from scratch)
    -Meldtech (symbiotic structures and weeapon)
    -Royal Weaponry (allows the player to grow royal weapons and structures)
    -Linkroot Tech (allows Linkroot implants and weapons)

-->

<!-- ================Organic Terratech Key================ -->

    <ThingDef ParentName="ResourceBase">
        <defName>ET_KeyT2OrganicAptitude</defName>
        <label>Devotee's Tome: Organic Aptitude</label>
        <description>A large tome, make out of thick glintwood and guilded with gold. This book holds guarded Terratech knowledge, and is quite valuable.
This tome teaches vital techniques needed to further handle and develop more complex organic terratech. It is the only way one can properly become a devoted terratechist.
\nA Terratech devotee can study this at a Terratech research bench in order to successfully experiment with, and understand, the knowledge held within.</description>
        <graphicData>
            <drawSize>0.6</drawSize>
            <texPath>Things/Resource/Tome/Tome_Devotee</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <generateCommonality>0</generateCommonality>
        <generateAllowChance>0</generateAllowChance>
        <tradeability>Buyable</tradeability>
        <tradeTags>
		    <li>ET_TechKeys</li>
            <li>ET_TechKeysDevotee</li>
        </tradeTags>
        <resourceReadoutPriority>Middle</resourceReadoutPriority>
        <stackLimit>1</stackLimit>
        <useHitPoints>true</useHitPoints>
        <soundInteract>Wood_Drop</soundInteract>
        <soundDrop>Wood_Drop</soundDrop>
        <statBases>
            <MarketValue>800</MarketValue>
            <MaxHitPoints>100</MaxHitPoints>
            <Mass>2.4</Mass>
            <Flammability>1</Flammability>
            <DeteriorationRate>1</DeteriorationRate>
        </statBases>
        <burnableByRecipe>false</burnableByRecipe>
        <healthAffectsPrice>true</healthAffectsPrice>
        <thingCategories>
            <li>ET_TechKeys</li>
        </thingCategories>
        <comps>
            <li Class="CompProperties_CompAnalyzableUnlockResearch">
                <analysisID>130912525</analysisID>
                <requiresMechanitor>false</requiresMechanitor>
                <analysisDurationHours>12</analysisDurationHours>
                <destroyedOnAnalyzed>true</destroyedOnAnalyzed>
                <completedLetterLabel>Tome studied: {RESEARCH} unlocked</completedLetterLabel>
                <completedLetter>By studying this tome, {PAWN_labelShort} has acquired the insight needed for the research project(s) {RESEARCH}.\n\nYou can now progress the next tier of organic terratech.</completedLetter>
                <completedLetterDef>PositiveEvent</completedLetterDef>
                <activateTexPath>UI/Icons/Study</activateTexPath>
                <activateLabelString>Study...</activateLabelString>
                <activateDescString>Study the tome.</activateDescString>
                <jobString>Study the tome</jobString>
                <guiLabelString>Choose who should study the tome</guiLabelString>
                <inspectString>Can be studied for exclusive knowledge.</inspectString>

                <targetingParameters>
                    <canTargetBuildings>false</canTargetBuildings>
                    <canTargetAnimals>false</canTargetAnimals>
                    <canTargetMechs>false</canTargetMechs>
                    <onlyTargetControlledPawns>true</onlyTargetControlledPawns>
                </targetingParameters>
            </li>
        </comps>
        <techHediffsTags>
            <li>Poor</li>
        </techHediffsTags>
    </ThingDef>

