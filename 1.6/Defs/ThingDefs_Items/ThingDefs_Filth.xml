<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="BaseFilth">
    <defName>ET_Filth_Glowsap</defName>
    <label>glowsap puddle</label>
    <description>A puddle of glowsap. Flammable.</description>
    <useHitPoints>true</useHitPoints>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Beauty>-10</Beauty>
      <Cleanliness>-15</Cleanliness>
      <Flammability>2.0</Flammability>
    </statBases>
    <graphicData>
      <texPath>Things/Filth/Spatter</texPath>
      <color>(232, 225, 165, 170)</color>
    </graphicData>
    <pathCost>30</pathCost>
    <filth>
      <rainWashes>true</rainWashes>
      <disappearsInDays>2~4</disappearsInDays>
      <cleaningWorkToReduceThickness>45</cleaningWorkToReduceThickness>
      <canFilthAttach>true</canFilthAttach>
      <maxThickness>2</maxThickness>
      <cleaningSound>Interact_CleanFilth_Fluid</cleaningSound>
    </filth>
  </ThingDef>

  <ThingDef ParentName="BaseFilth">
    <defName>ET_Filth_Sap</defName>
    <label>sap puddle</label>
    <description>A puddle of sap. Flammable.</description>
    <useHitPoints>true</useHitPoints>
    <statBases>
      <Beauty>-10</Beauty>
      <Cleanliness>-5</Cleanliness>
      <MaxHitPoints>150</MaxHitPoints>
      <Flammability>2.0</Flammability>
    </statBases>
    <graphicData>
      <texPath>Things/Filth/PoolSoft</texPath>
      <color>(200, 200, 140, 50)</color>
      <drawSize>0.5</drawSize>
    </graphicData>
    <filth>
      <rainWashes>true</rainWashes>
      <disappearsInDays>1~2</disappearsInDays>
      <cleaningWorkToReduceThickness>45</cleaningWorkToReduceThickness>
      <canFilthAttach>true</canFilthAttach>
      <cleaningSound>Interact_CleanFilth_Fluid</cleaningSound>
    </filth>
  </ThingDef>

  <ThingDef ParentName="BaseFilth">
    <defName>ET_Filth_Briars</defName>
    <label>scattered briars</label>
    <description>A collection of small - but painful - briars.</description>
    <useHitPoints>true</useHitPoints>
    <statBases>
      <Beauty>-10</Beauty>
      <Cleanliness>-5</Cleanliness>
      <MaxHitPoints>60</MaxHitPoints>
      <Flammability>1.0</Flammability>
    </statBases>
    <graphicData>
      <texPath>Things/Filth/Filth_Briar</texPath>
      <drawSize>0.5</drawSize>
    </graphicData>
    <pathCost>45</pathCost>
    <filth>
      <rainWashes>false</rainWashes>
      <disappearsInDays>5~15</disappearsInDays>
      <cleaningWorkToReduceThickness>75</cleaningWorkToReduceThickness>
      <canFilthAttach>true</canFilthAttach>
      <cleaningSound>Interact_CleanFilth_Dirt</cleaningSound>
      <maxThickness>4</maxThickness>
    </filth>
  </ThingDef>

</Defs>
