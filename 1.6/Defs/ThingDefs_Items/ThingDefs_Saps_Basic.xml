  <ThingDef ParentName="ResourceBase">
    <defName>ET_Deepsap</defName>
    <label>Deepsap</label>
    <description>A jar of harvested deepsap. Deepsap blooms appear underground or in caves, and emits a similar color to darklight sources.
\nDeepsap-infused weapons can be planted at any time to be regrown at 150% speed.
\nDeepsap and glowsap are quite similar, and can be transmuted into one another at a Sap Transposer.</description>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/Resource/Deepsap</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>0.8</drawSize>
    </graphicData>
    <stackLimit>30</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <intricate>true</intricate>    <!-- Not returned to player when product made of this is smelted. -->
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <MarketValue>8</MarketValue>
      <Mass>0.1</Mass>
      <Flammability>1</Flammability>
      <DeteriorationRate>0.25</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>BasicSapsAll</li>
    </thingCategories>
    <!--<comps>
      <li Class="CompProperties_Glower">
        <glowRadius>1.9</glowRadius>
        <glowColor>(370,370,370,0)</glowColor>
      </li>
    </comps>-->
    <modExtensions>
      <li Class="Ecotech.ThingDefExtension_TransformerRecipe">
        <recipes>
          <li>
            <fuelCount>1</fuelCount>
            <inputThingDef>ET_PrimaStakecaster</inputThingDef>
            <outputThingDef>ET_PeriwoodTricaster</outputThingDef>
          </li>
        </recipes>
      </li>
    </modExtensions>
  </ThingDef>

