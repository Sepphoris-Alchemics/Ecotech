  <ThingDef ParentName="ResourceBase">
    <defName>ET_Endosap</defName>
    <label>Endosap</label>
    <description>A jar of refined, potent terrasap. These unique features can be applied to certain terrastructures and terraweapons, giving them the following alterations:

-Lifespan increased by 15 days
-Hitpoints increased by 50% (rounded up)
-Flammability decreased by 75%</description>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/Resource/Endosap</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>0.8</drawSize>
    </graphicData>
    <stackLimit>6</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <intricate>true</intricate>    <!-- Not returned to player when product made of this is smelted. -->
    <statBases>
      <MaxHitPoints>75</MaxHitPoints>
      <MarketValue>82</MarketValue>
      <Mass>0.05</Mass>
      <Flammability>1</Flammability>
      <DeteriorationRate>0.25</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>BasicSapsAll</li>
    </thingCategories>
    <!--<comps>
      <li Class="CompProperties_Glower">
        <glowRadius>1.9</glowRadius>
        <glowColor>(370,370,370,0)</glowColor>
      </li>
    </comps>-->
    <modExtensions>
      <li Class="Ecotech.ThingDefExtension_TransformerRecipe">        <!--recipes used by Terravats-->
        <recipes>
          <li>
            <fuelCount>1</fuelCount>            <!--how much fuel the Terravat uses for the process-->
            <inputThingDef>ET_PrimaSMG</inputThingDef>            <!--the input item needed inside the Terravat-->
            <outputThingDef>ET_PrimaSMGEndosap</outputThingDef>            <!--the item produced after the transformation-->
            <!--outputStuff only for items or structures that are stuffable-->
            <!--<outputStuff>WoodLog</outputStuff>-->
