<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef Name="ET_TerrathystPlantBase" ParentName="PlantBaseNonEdible" Abstract="True">
    <graphicData>
      <texPath>Things/Plant/Terrathyst_Mature</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <minifiedDef IsNull="True" />
    <statBases>
      <MaxHitPoints>95</MaxHitPoints>
    </statBases>
    <selectable>true</selectable>
    <pathCost>14</pathCost>
    <maxTechLevelToBuild>Ultra</maxTechLevelToBuild>
    <plant>
      <mustBeWildToSow>true</mustBeWildToSow>
      <completelyIgnoreFertility>true</completelyIgnoreFertility>
      <showInFrozenWater>true</showInFrozenWater>
      <growMinGlow>0</growMinGlow>
      <harvestWork>600</harvestWork>
      <harvestedThingDef>ET_Terrathyst</harvestedThingDef>
      <burnedThingDef IsNull="True" />
      <harvestYield>8</harvestYield>
      <harvestMinGrowth>0.8</harvestMinGrowth>
      <harvestAfterGrowth>0</harvestAfterGrowth>
      <harvestTag>Standard</harvestTag>
      <harvestFailable>false</harvestFailable>
      <harvestYieldAffectedByDifficulty>false</harvestYieldAffectedByDifficulty>
      <immatureGraphicPath>Things/Plant/Terrathyst_Mature</immatureGraphicPath>
      <sowWork>300</sowWork>
      <blockAdjacentSow>false</blockAdjacentSow>
      <topWindExposure>0</topWindExposure>
      <visualSizeRange>0.5~1</visualSizeRange>
      <treeLoversCareIfChopped>false</treeLoversCareIfChopped>
    </plant>
  </ThingDef>

  <ThingDef ParentName="ET_TerrathystPlantBase">
    <defName>ET_TerrathystGrower</defName>
    <graphicData>
      <texPath>Things/Plant/TerrathystGrower</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <label>Terrathyst Cultivator</label>
    <description>A large crystal that will grow smaller, pure terrathyst crystals. While it can be shattered for terrathyst as well, it is highly inefficient and not recommended.
The growth can be placed anywhere, but will only grow harvestable crystals in water, watery terrains, or sap-infused terrains. It is therefore recommended to placed this near, or in, one such terrain.</description>
    <descriptionHyperlinks>
      <ThingDef>ET_OverviewTerrathyst</ThingDef>
    </descriptionHyperlinks>
    <plant>
      <showGrowthInInspectPane>false</showGrowthInInspectPane>
      <harvestMinGrowth>0.8</harvestMinGrowth>
      <lifespanDaysPerGrowDays>0</lifespanDaysPerGrowDays>
      <fertilityMin>0</fertilityMin>
      <fertilitySensitivity>0</fertilitySensitivity>
      <wildClusterWeight>0</wildClusterWeight>
      <harvestYield>16</harvestYield>
      <sowMinSkill>4</sowMinSkill>
      <growDays>6</growDays>
      <harvestWork>600</harvestWork>
      <sowTags Inherit="True">
        <li>Ground</li>
      </sowTags>
      <sowResearchPrerequisites>
        <li>ET_LithicTerratechEssentials</li>
      </sowResearchPrerequisites>
      <immatureGraphicPath>Things/Plant/TerrathystGrower</immatureGraphicPath>
    </plant>
    <tickerType>Rare</tickerType>
    <comps>
      <li Class="CompProperties_SpawnSubplant">
        <compClass>CompSpawnSubplantDuration</compClass>
        <subplant>Plant_MossGauranlen</subplant>
        <maxRadius>7.9</maxRadius>
        <subplantSpawnDays>1</subplantSpawnDays>
        <minGrowthForSpawn>0.6</minGrowthForSpawn>
        <initialGrowthRange>0.2~0.4</initialGrowthRange>
        <canSpawnOverPlayerSownPlants>false</canSpawnOverPlayerSownPlants>
        <plantsToNotOverwrite>
          <li MayRequire="Ludeon.Rimworld.Ideology">Plant_PodGauranlen</li>
          <li MayRequire="Ludeon.RimWorld.Royalty">Plant_GrassAnima</li>
          <li MayRequire="Ludeon.RimWorld.Royalty">Plant_TreeAnima</li>
        </plantsToNotOverwrite>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="ET_TerrathystPlantBase">
    <defName>ET_TerrathystSmallGrowth</defName>
    <graphicData>
      <texPath>Things/Plant/Terrathyst_Mature</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <label>Pure Terrathyst</label>
    <description>A pure crystal of terrathyst, which can be carefully shattered into usable terrathyst shards. These shards are unremarkable by themselves, but can be melded together to create incredibly strong materials.
The growth can be harvested for a decent amount of shards; however, at any point the growth may shatter and produced a random amount of shards. This can result in more - or less - shards than if it was manually harvested.
If one does not wish to test their luck, it is recommended to harvest these crystals as soon as they are ready.
These smaller growths can grow on any fertile terrain, though larger growths require specialized bays, or sap-infused terrains. It is also highly sensitive to fertility, as building it's innate charge requires much nutrition.</description>
    <!--<descriptionHyperlinks>
      <ThingDef>ET_OverviewTerrathyst</ThingDef>
    </descriptionHyperlinks>-->
    <plant>
      <showGrowthInInspectPane>true</showGrowthInInspectPane>
      <harvestMinGrowth>1</harvestMinGrowth>
      <lifespanDaysPerGrowDays>0</lifespanDaysPerGrowDays>
      <fertilityMin>0.1</fertilityMin>
      <fertilitySensitivity>0.8</fertilitySensitivity>
      <wildClusterWeight>0</wildClusterWeight>
      <harvestYield>8</harvestYield>
      <sowMinSkill>4</sowMinSkill>
      <growDays>4</growDays>
      <harvestWork>600</harvestWork>
      <sowTags>
        <li>Ground</li>
        <li>ET_SapTerrainTierOne</li>
        <li>ET_ShocksapCompatible</li>
      </sowTags>
      <sowResearchPrerequisites>
        <li>ET_LithicTerratechEssentials</li>
      </sowResearchPrerequisites>
      <immatureGraphicPath>Things/Plant/Terrathyst_Mature</immatureGraphicPath>
    </plant>
    <tickerType>Rare</tickerType>
    <comps>
      <li Class="Ecotech.ThingCompProperties_CyclicThingSpawner">
        <compClass>Ecotech.ThingComp_CyclicThingSpawner</compClass>
        <cycleDurationRangeTicks>42000~54000</cycleDurationRangeTicks>        <!--7 to 9 days-->
        <showNotificationWhenSpawningThings>true</showNotificationWhenSpawningThings>
        <potentialSpawnedThings>
          <li>
            <weight>1</weight>
            <things>
              <ET_Terrathyst>4</ET_Terrathyst>
            </things>
          </li>
          <li>
            <weight>1</weight>
            <things>
              <ET_Terrathyst>2</ET_Terrathyst>
            </things>
          </li>
          <li>
            <weight>0.8</weight>
            <things>
              <ET_Terrathyst>8</ET_Terrathyst>
            </things>
          </li>
          <li>
            <weight>0.6</weight>
            <things>
              <ET_Terrathyst>12</ET_Terrathyst>
            </things>
          </li>
          <li>
            <weight>0.4</weight>
            <things>
              <ET_Terrathyst>16</ET_Terrathyst>
            </things>
          </li>
          <li>
            <weight>0.2</weight>
            <things>
              <ET_Terrathyst>20</ET_Terrathyst>
            </things>
          </li>
          <!--Prismite additions-->
          <!--<li>
            <weight>0.6</weight>
            <things>
              <ET_Terrathyst>4</ET_Terrathyst>
              <ET_TierTwoCrystal>2</ET_TierTwoCrystal>
            </things>
          </li>
          <li>
            <weight>0.4</weight>
            <things>
              <ET_Terrathyst>6</ET_Terrathyst>
              <ET_TierTwoCrystal>4</ET_TierTwoCrystal>
            </things>
          </li>
          <li>
            <weight>0.2</weight>
            <things>
              <ET_Terrathyst>8</ET_Terrathyst>
              <ET_TierTwoCrystal>6</ET_TierTwoCrystal>
            </things>
          </li>
          <li>
            <weight>0.1</weight>
            <things>
              <ET_Terrathyst>10</ET_Terrathyst>
              <ET_TierTwoCrystal>8</ET_TierTwoCrystal>
            </things>
          </li>-->
          <!--Terrathyst heart additions-->
          <li>
            <weight>0.2</weight>
            <things>
              <ET_TerrathystCore>1</ET_TerrathystCore>
            </things>
          </li>
          <li>
            <weight>0.1</weight>
            <things>
              <ET_Terrathyst>4</ET_Terrathyst>
              <ET_TerrathystCore>1</ET_TerrathystCore>
            </things>
          </li>
          <li>
            <weight>0.1</weight>
            <things>
              <ET_Terrathyst>6</ET_Terrathyst>
              <ET_TerrathystCore>1</ET_TerrathystCore>
            </things>
          </li>
          <li>
            <weight>0.1</weight>
            <things>
              <ET_Terrathyst>8</ET_Terrathyst>
              <ET_TerrathystCore>1</ET_TerrathystCore>
            </things>
          </li>
          <li>
            <weight>0.1</weight>
            <things>
              <ET_Terrathyst>10</ET_Terrathyst>
              <ET_TerrathystCore>1</ET_TerrathystCore>
            </things>
          </li>
        </potentialSpawnedThings>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>1.9</glowRadius>
        <glowColor>(132,197,193,0)</glowColor>
      </li>
      <li Class="CompProperties_Lifespan">
        <lifespanTicks>542000</lifespanTicks>        <!--2000 ticks after the latest spawning time, to ensure spawning happens.-->
      </li>
      <li Class="CompProperties_InspectString">
        <inspectString>Shatters shortly after overgrowth</inspectString>
      </li>
    </comps>
  </ThingDef>
  
</Defs>
