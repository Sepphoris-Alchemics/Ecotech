  <ThingDef ParentName="ET_TerrathystPlantBase">
    <defName>ET_TerrathystSmallGrowth</defName>
    <graphicData>
      <texPath>Things/Plant/Terrathyst_Mature</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <label>Pure Terrathyst</label>
    <description>A pure crystal of terrathyst, which can be carefully shattered into usable terrathyst shards. These shards are unremarkable by themselves, but can be melded together to create incredibly strong materials.
The growth can be harvested for a decent amount of shards; however, at any point the growth may shatter and produced a random amount of shards. This can result in more - or less - shards than if it was manually harvested.
If one does not wish to test their luck, it is recommended to harvest these crystals as soon as they are ready.
These smaller growths can grow on any fertile terrain, though larger growths require specialized bays, or sap-infused terrains. It is also highly sensitive to fertility, as building it's innate charge requires much nutrition.</description>
    <!--<descriptionHyperlinks>
      <ThingDef>ET_OverviewTerrathyst</ThingDef>
    </descriptionHyperlinks>-->
    <plant>
      <showGrowthInInspectPane>true</showGrowthInInspectPane>
      <harvestMinGrowth>1</harvestMinGrowth>
      <lifespanDaysPerGrowDays>0</lifespanDaysPerGrowDays>
      <fertilityMin>0.1</fertilityMin>
      <fertilitySensitivity>0.8</fertilitySensitivity>
      <wildClusterWeight>0</wildClusterWeight>
      <harvestYield>8</harvestYield>
      <sowMinSkill>4</sowMinSkill>
      <growDays>4</growDays>
      <harvestWork>600</harvestWork>
      <sowResearchPrerequisites>
        <li>ET_TerrathystEssentials</li>
      </sowResearchPrerequisites>
      <immatureGraphicPath>Things/Plant/Terrathyst_Mature</immatureGraphicPath>
    </plant>
    <tickerType>Rare</tickerType>
    <comps>
      <li Class="Ecotech.ThingCompProperties_CyclicThingSpawner">
        <compClass>Ecotech.ThingComp_CyclicThingSpawner</compClass>
        <cycleDurationRangeTicks>420000~540000</cycleDurationRangeTicks>        <!--7 to 9 days-->
        <showNotificationWhenSpawningThings>true</showNotificationWhenSpawningThings>
        <potentialSpawnedThings>
          <li>
            <weight>1</weight>
            <things>
              <ET_TierOneCrystal>4</ET_TierOneCrystal>
            </things>
          </li>
          <li>
            <weight>1</weight>
            <things>
              <ET_TierOneCrystal>2</ET_TierOneCrystal>
            </things>
          </li>
          <li>
            <weight>0.8</weight>
            <things>
              <ET_TierOneCrystal>8</ET_TierOneCrystal>
            </things>
          </li>
          <li>
            <weight>0.6</weight>
            <things>
              <ET_TierOneCrystal>12</ET_TierOneCrystal>
            </things>
          </li>
          <li>
            <weight>0.4</weight>
            <things>
              <ET_TierOneCrystal>16</ET_TierOneCrystal>
            </things>
          </li>
          <li>
            <weight>0.2</weight>
            <things>
              <ET_TierOneCrystal>20</ET_TierOneCrystal>
            </things>
          </li>
          <!--Prismite additions-->
          <li>
            <weight>0.6</weight>
            <things>
              <ET_TierOneCrystal>4</ET_TierOneCrystal>
              <ET_TierTwoCrystal>2</ET_TierTwoCrystal>
            </things>
          </li>
          <li>
            <weight>0.4</weight>
            <things>
              <ET_TierOneCrystal>6</ET_TierOneCrystal>
              <ET_TierTwoCrystal>4</ET_TierTwoCrystal>
            </things>
          </li>
          <li>
            <weight>0.2</weight>
            <things>
              <ET_TierOneCrystal>8</ET_TierOneCrystal>
              <ET_TierTwoCrystal>6</ET_TierTwoCrystal>
            </things>
          </li>
          <li>
            <weight>0.1</weight>
            <things>
              <ET_TierOneCrystal>10</ET_TierOneCrystal>
              <ET_TierTwoCrystal>8</ET_TierTwoCrystal>
            </things>
          </li>
          <!--Terrathyst heart additions-->
          <li>
            <weight>0.2</weight>
            <things>
              <ET_TierOneCrystalCore>1</ET_TierOneCrystalCore>
            </things>
          </li>
          <li>
            <weight>0.1</weight>
            <things>
              <ET_TierOneCrystal>4</ET_TierOneCrystal>
              <ET_TierOneCrystalCore>1</ET_TierOneCrystalCore>
            </things>
          </li>
          <li>
            <weight>0.1</weight>
            <things>
              <ET_TierOneCrystal>6</ET_TierOneCrystal>
              <ET_TierOneCrystalCore>1</ET_TierOneCrystalCore>
            </things>
          </li>
          <li>
            <weight>0.1</weight>
            <things>
              <ET_TierOneCrystal>8</ET_TierOneCrystal>
              <ET_TierOneCrystalCore>1</ET_TierOneCrystalCore>
            </things>
          </li>
          <li>
            <weight>0.1</weight>
            <things>
              <ET_TierOneCrystal>10</ET_TierOneCrystal>
              <ET_TierOneCrystalCore>1</ET_TierOneCrystalCore>
            </things>
          </li>
        </potentialSpawnedThings>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>1.9</glowRadius>
        <glowColor>(132,197,193,0)</glowColor>
      </li>
      <li Class="CompProperties_Lifespan">
        <lifespanTicks>542000</lifespanTicks>        <!--2000 ticks after the latest spawning time, to ensure spawning happens.-->
      </li>
      <li Class="CompProperties_InspectString">
        <inspectString>Shatters shortly after overgrowth</inspectString>
      </li>
    </comps>
  </ThingDef>
  
</Defs>
