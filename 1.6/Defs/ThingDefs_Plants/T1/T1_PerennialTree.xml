<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--Periwood Tree -->

  <ThingDef ParentName="TreeBase">
    <defName>ET_PeriwoodTree</defName>
    <label>periwood tree</label>
    <description>A tree that is quite important to Terratech tribes, almost as important as many conduit trees. Periwood trees were carefully designed to be a staple plant of any Terratech tribe providing effective weaponry to it's tribe, while also requiring minimal effort in return.
\nPeriwood Trees grow relatively fast and last a very long time, and over their lifespan they produce various plant pods. Upon maturity these plant pods will produce a random Periwood weapon, and expire shortly after. This process requires nearby fertile soil.
Unlike Prima weapons, what a Periwood pod produces cannot be influenced. Furthermore, the pods are not created very often, so it is advised you plant - and protect - Periwood trees wherever possible.
\n\nLike most Terratech trees, they require ample growing space from others of their kind. Periwood trees are grown via seeds.</description>
    <graphicData>
      <graphicClass>Graphic_Random</graphicClass>
      <texPath>Things/Plant/PeriwoodTree</texPath>
      <shadowData>
        <volume>(0.4, 0.3, 0.1)</volume>
        <offset>(0,0,-0.3)</offset>
      </shadowData>
    </graphicData>
    <minifiedDef IsNull="True" />
    <statBases>
      <Beauty>13</Beauty>
      <BeautyOutdoors>13</BeautyOutdoors>
      <Flammability>2</Flammability>
      <MaxHitPoints>150</MaxHitPoints>
    </statBases>
    <ingestible />
    <neverMultiSelect>false</neverMultiSelect>
    <canScatterOver>false</canScatterOver>
    <plant>
      <pollution>Any</pollution>
      <growDays>5</growDays>
      <visualSizeRange>1.5~2.1</visualSizeRange>
      <sowMinSkill>8</sowMinSkill>
      <sowTags Inherit="False"/>
      <lifespanDaysPerGrowDays>15</lifespanDaysPerGrowDays>
      <fertilityMin>0.4</fertilityMin>
      <fertilitySensitivity>0.6</fertilitySensitivity>
      <wildClusterWeight>0</wildClusterWeight>
      <sowWork>400</sowWork>
      <harvestYield>15</harvestYield>
      <harvestedThingDef>ET_TierTwoPlating</harvestedThingDef>
      <treeCategory>Super</treeCategory>
      <dieIfNoSunlight>false</dieIfNoSunlight>
      <growMinGlow>0</growMinGlow>
      <sowResearchPrerequisites Inherit="False" />
      <dieFromToxicFallout>False</dieFromToxicFallout>
      <showGrowthInInspectPane>false</showGrowthInInspectPane>
      <minSpacingBetweenSamePlant>34.9</minSpacingBetweenSamePlant>
      <harvestWork>1600</harvestWork>
      <choppedThingDef IsNull="True" />
      <smashedThingDef IsNull="True" />
    </plant>
    <comps>
      <li Class="CompProperties_SelfhealHitpoints">
        <ticksPerHeal>2000</ticksPerHeal>        <!-- 30 hp per day, must be a multiple of 2000, since plants have Long ticker -->
      </li>
      <li Class="CompProperties_SpawnSubplant">
        <compClass>CompSpawnSubplantDuration</compClass>
        <subplant>ET_PeriwoodWeaponPod</subplant>
        <maxRadius>11.9</maxRadius>
        <subplantSpawnDays>6</subplantSpawnDays>
        <minGrowthForSpawn>0.6</minGrowthForSpawn>
        <initialGrowthRange>0.5~0.8</initialGrowthRange>
        <canSpawnOverPlayerSownPlants>false</canSpawnOverPlayerSownPlants>
        <plantsToNotOverwrite>
          <li MayRequire="Ludeon.RimWorld.Ideology">Plant_PodGauranlen</li>
          <li MayRequire="Ludeon.RimWorld.Royalty">Plant_GrassAnima</li>
          <li MayRequire="Ludeon.RimWorld.Royalty">Plant_TreeAnima</li>
        </plantsToNotOverwrite>
      </li>
    </comps>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
  </ThingDef>

</Defs>
