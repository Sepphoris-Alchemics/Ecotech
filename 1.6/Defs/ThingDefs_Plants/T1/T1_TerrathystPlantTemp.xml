<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<ThingDef Name="ET_TerrathystPlantBase" ParentName="PlantBaseNonEdible" Abstract="True">
    <graphicData>
      <texPath>Things/Plant/Terrathyst_Mature</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <minifiedDef IsNull="True" />
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
    </statBases>
    <selectable>true</selectable>
    <pathCost>14</pathCost>
    <maxTechLevelToBuild>Ultra</maxTechLevelToBuild>
    <plant>
      <mustBeWildToSow>true</mustBeWildToSow>
      <completelyIgnoreFertility>true</completelyIgnoreFertility>
      <showInFrozenWater>true</showInFrozenWater>
      <growMinGlow>0</growMinGlow>
      <harvestWork>600</harvestWork>
      <harvestedThingDef>ET_Terrathyst</harvestedThingDef>
      <burnedThingDef IsNull="True" />
      <harvestYield>0</harvestYield>
      <harvestMinGrowth>0.8</harvestMinGrowth>
      <harvestAfterGrowth>0</harvestAfterGrowth>
      <harvestTag>Standard</harvestTag>
      <harvestFailable>false</harvestFailable>
      <harvestYieldAffectedByDifficulty>false</harvestYieldAffectedByDifficulty>
      <immatureGraphicPath>Things/Plant/Terrathyst_Mature</immatureGraphicPath>
      <sowWork>300</sowWork>
      <blockAdjacentSow>false</blockAdjacentSow>
      <topWindExposure>0</topWindExposure>
      <visualSizeRange>0.5~1</visualSizeRange>
      <treeLoversCareIfChopped>false</treeLoversCareIfChopped>
    </plant>
  </ThingDef>

<ThingDef ParentName="ET_TerrathystPlantBase">
    <defName>ET_TerrathystCrystals</defName>
    <graphicData>
      <texPath>Things/Plant/Terrathyst_Mature</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <label>terrathyst crystals</label>
    <description>Pure crystals of terrathyst that grow in a few days. Mostly unremarkable by themselves, but when harvested they may produce terrasaps, terrathyst cores, or even chronite.
\n\nThese small growths can grow on any terrain with fertility, with any light level. However, they cannot be influenced like a normal plant (such as with harvest yield), and will break apart only when ready.</description>
    <plant>
      <maxMeshCount>1</maxMeshCount>
      <mustBeWildToSow>true</mustBeWildToSow>
      <showGrowthInInspectPane>false</showGrowthInInspectPane>
      <harvestMinGrowth>1</harvestMinGrowth>
      <lifespanDaysPerGrowDays>0</lifespanDaysPerGrowDays>
      <fertilityMin>0</fertilityMin>
      <fertilitySensitivity>0</fertilitySensitivity>
      <wildClusterWeight>0</wildClusterWeight>
      <harvestYield>0</harvestYield>
      <sowMinSkill>4</sowMinSkill>
      <growDays>4</growDays>
      <harvestWork>300</harvestWork>
      <sowTags>
        <li>Ground</li>
        <li>ET_SapTerrainTierOne</li>
        <li>ET_ShocksapCompatible</li>
      </sowTags>
      <sowResearchPrerequisites>
        <li>ET_LithicTerratechEssentials</li>
      </sowResearchPrerequisites>
      <immatureGraphicPath>Things/Plant/Terrathyst_Mature</immatureGraphicPath>
      <visualSizeRange>0.3~0.6</visualSizeRange>
    </plant>
    <tickerType>Rare</tickerType>
    <comps>
      <li Class="Ecotech.ThingCompProperties_CyclicThingSpawner">
        <compClass>Ecotech.ThingComp_CyclicThingSpawner</compClass>
        <cycleDurationRangeTicks>210000~240000</cycleDurationRangeTicks>
        <showNotificationWhenSpawningThings>false</showNotificationWhenSpawningThings>
        <potentialSpawnedThings>
          <!--Basic Terrathyst-->
          <li>
            <weight>1</weight>
            <things>
              <ET_Terrathyst>4</ET_Terrathyst>
            </things>
          </li>
          <li>
            <weight>1</weight>
            <things>
              <ET_Terrathyst>6</ET_Terrathyst>
            </things>
          </li>
          <!--<li>
            <weight>1</weight>
            <things>
              <ET_Terrathyst>8</ET_Terrathyst>
            </things>
          </li>-->
          <!--Core Drops-->
          <li>
            <weight>0.1</weight>
            <things>
              <ET_Terrathyst>4</ET_Terrathyst>
              <ET_TerrathystCore>1</ET_TerrathystCore>
            </things>
          </li>
          <li>
            <weight>0.1</weight>
            <things>
              <ET_Terrathyst>6</ET_Terrathyst>
              <ET_TerrathystCore>1</ET_TerrathystCore>
            </things>
          </li>
          <!--<li>
            <weight>0.1</weight>
            <things>
              <ET_Terrathyst>8</ET_Terrathyst>
              <ET_TerrathystCore>1</ET_TerrathystCore>
            </things>
          </li>-->
          <!--Shocksap Drops-->
          <li>
            <weight>0.1</weight>
            <things>
              <ET_Terrathyst>4</ET_Terrathyst>
              <ET_Shocksap>1</ET_Shocksap>
            </things>
          </li>
          <li>
            <weight>0.1</weight>
            <things>
              <ET_Terrathyst>6</ET_Terrathyst>
              <ET_Shocksap>1</ET_Shocksap>
            </things>
          </li>
          <!--<li>
            <weight>0.1</weight>
            <things>
              <ET_Terrathyst>8</ET_Terrathyst>
              <ET_Shocksap>1</ET_Shocksap>
            </things>
          </li>-->
          <!--Endosap Drops-->
          <li>
            <weight>0.1</weight>
            <things>
              <ET_Terrathyst>4</ET_Terrathyst>
              <ET_Endosap>1</ET_Endosap>
            </things>
          </li>
          <li>
            <weight>0.1</weight>
            <things>
              <ET_Terrathyst>6</ET_Terrathyst>
              <ET_Endosap>1</ET_Endosap>
            </things>
          </li>
          <!--<li>
            <weight>0.1</weight>
            <things>
              <ET_Terrathyst>8</ET_Terrathyst>
              <ET_Endosap>1</ET_Endosap>
            </things>
          </li>-->
          <!--Chronite Lattice-->
          <li>
            <weight>0.05</weight>
            <things>
              <ET_Seed_ChroniteForge>1</ET_Seed_ChroniteForge>
            </things>
          </li>
        </potentialSpawnedThings>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>2.9</glowRadius>
        <glowColor>(132,197,193,0)</glowColor>
      </li>
      <li Class="CompProperties_SelfhealHitpoints">
        <ticksPerHeal>2000</ticksPerHeal>        <!-- 30 hp per day, must be a multiple of 2000, since plants have Long ticker -->
      </li>
      <li Class="CompProperties_Lifespan">
        <lifespanTicks>242000</lifespanTicks>        <!--2000 ticks after the latest spawning time, to ensure spawning happens.-->
      </li>
      <li Class="CompProperties_InspectString">
        <inspectString>Shatters shortly after overgrowth</inspectString>
      </li>
    </comps>
  </ThingDef>

</Defs>
