<?xml version="1.0" encoding="utf-8" ?>
<Defs>


  <ThingDef ParentName="PlantBaseNonEdible">
    <defName>ET_GlowsapBloom</defName>
    <label>Glowsap Bloom</label>
    <description>A small plant bioengineered to produce Glowsap. Glowsap builds up underneath it's durable, transparent skin, and is ready for harvest once glowsap begins to break through. Also produces a moderate amount of light.
Due to it's size, this plant only produces a trace amount of glowsap. It is advised to have a Glowsap Tree as a reliable source.</description>
    <graphicData>
      <texPath>Things/Plant/GlowsapBloom</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <minifiedDef IsNull="True" />
    <statBases>
      <Beauty>8</Beauty>
      <BeautyOutdoors>8</BeautyOutdoors>
      <Flammability>3</Flammability>
      <MaxHitPoints>55</MaxHitPoints>
    </statBases>
    <selectable>true</selectable>
    <pathCost>14</pathCost>
    <plant>
      <fertilityMin>0.1</fertilityMin>
      <fertilitySensitivity>0.3</fertilitySensitivity>
      <growMinGlow>0</growMinGlow>
      <harvestWork>350</harvestWork>
      <harvestedThingDef>ET_Glowsap</harvestedThingDef>
      <burnedThingDef IsNull="True" />
      <harvestYield>1</harvestYield> <!--This was extremely spammy before, now piles upon piles of growsap won't be near as common.-->
      <harvestMinGrowth>0.9</harvestMinGrowth>
      <harvestAfterGrowth>0.05</harvestAfterGrowth>
      <harvestTag>Standard</harvestTag>
      <allowAutoCut>false</allowAutoCut>
      <sowWork>1000</sowWork>
      <sowTags>
        <li>Ground</li>
        <li>Decorative</li>
        <li>ET_GlowsapCompatible</li>
      </sowTags>
      <sowMinSkill>4</sowMinSkill>
      <sowResearchPrerequisites>
        <li>ET_SapBasics</li>
      </sowResearchPrerequisites>
      <blockAdjacentSow>false</blockAdjacentSow>
      <topWindExposure>0.1</topWindExposure>
      <growDays>10</growDays>
      <dieIfLeafless>false</dieIfLeafless>
      <dieIfNoSunlight>false</dieIfNoSunlight>
      <visualSizeRange>0.5~1</visualSizeRange>
      <treeLoversCareIfChopped>false</treeLoversCareIfChopped>
      <purpose>Misc</purpose>
      <wildBiomes>
				<TropicalRainforest>0.01</TropicalRainforest>
				<TemperateForest>0.008</TemperateForest>
				<AridShrubland>0.0015</AridShrubland>
				<BorealForest>0.004</BorealForest>
				<Tundra>0.002</Tundra>
			</wildBiomes>
      <wildOrder>2</wildOrder>
      <wildClusterWeight>0.002</wildClusterWeight>
			<wildClusterRadius>6</wildClusterRadius>
    </plant>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>4.9</glowRadius>
        <glowColor>(237,211,78,0)</glowColor>
      </li>
      <li Class="CompProperties_SelfhealHitpoints">
        <ticksPerHeal>2000</ticksPerHeal> <!-- 30 hp per day, must be a multiple of 2000, since plants have Long ticker -->
      </li>
      <li Class="CompProperties_InspectString">
        <inspectString>Mutation potential: &lt;color=#B2A644&gt;HIGH&lt;/color&gt;</inspectString>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="PlantBaseNonEdible">
    <defName>ET_DeepsapBloom</defName>
    <label>Deepsap Bloom</label>
    <description>A small plant that produces deepsap. Emits a glow that's almost identical to darklight, making it ideal for colonies that prefer such ambience.
Like most other unmodified blooms, it can quickly produce sap, but provides a very small yield. A farm is recommended for acquiring decent amounts of deepsap.</description>
    <!--<description>A small plant bioengineered to produce Darksap. Glows a pale purple color, and compliments darklight ambience quite well.
Like most other blooms, it can quickly produce sap, but provides a very small yield. A Darksap Tree is recommended for a reliable source.</description>-->
    <graphicData>
      <texPath>Things/Plant/DeepsapBloom</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <minifiedDef IsNull="True" />
    <statBases>
      <Beauty>8</Beauty>
      <BeautyOutdoors>8</BeautyOutdoors>
      <Flammability>3</Flammability>
      <MaxHitPoints>55</MaxHitPoints>
    </statBases>
    <selectable>true</selectable>
    <pathCost>14</pathCost>
    <plant>
      <fertilityMin>0.1</fertilityMin>
      <fertilitySensitivity>0.5</fertilitySensitivity>
      <growMinGlow>0</growMinGlow>
      <harvestWork>750</harvestWork>
      <harvestedThingDef>ET_Deepsap</harvestedThingDef>
      <!--<harvestedThingDef>ET_Darksap</harvestedThingDef>-->
      <burnedThingDef IsNull="True" />
      <harvestYield>1</harvestYield> <!--One will produce about 30 every year, not accounting yield differences-->
      <harvestMinGrowth>0.8</harvestMinGrowth>
      <harvestAfterGrowth>0.05</harvestAfterGrowth>
      <harvestTag>Standard</harvestTag>
      <allowAutoCut>false</allowAutoCut>
      <sowWork>1000</sowWork>
      <sowTags>
        <li>Ground</li>
        <li>Decorative</li>
        <li>ET_GlowsapCompatible</li>
      </sowTags>
      <sowMinSkill>4</sowMinSkill>
      <sowResearchPrerequisites>
        <li>ET_SapBasics</li>
      </sowResearchPrerequisites>
      <blockAdjacentSow>false</blockAdjacentSow>
      <topWindExposure>0.1</topWindExposure>
      <growDays>10</growDays>
      <cavePlant>true</cavePlant>
      <dieIfLeafless>false</dieIfLeafless>
      <dieIfNoSunlight>false</dieIfNoSunlight>
      <visualSizeRange>0.3~0.8</visualSizeRange>
      <treeLoversCareIfChopped>false</treeLoversCareIfChopped>
      <purpose>Misc</purpose>
    </plant>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>4.9</glowRadius>
        <glowColor>(78,226,229,0)</glowColor>
      </li>
      <li Class="CompProperties_SelfhealHitpoints">
        <ticksPerHeal>2000</ticksPerHeal> <!-- 30 hp per day, must be a multiple of 2000, since plants have Long ticker -->
      </li>
      <li Class="CompProperties_DarklightOverlay" MayRequire="Ludeon.RimWorld.Ideology">
        <fireSize>0</fireSize>
        <offset>(0,0,0.2)</offset>
      </li>
    </comps>
  </ThingDef>

</Defs>