<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--=====T2 CUSTODIAN=====-->

  <ThingDef ParentName="TreeBase">    <!--todo: add zone growth coding and add building coding-->
    <defName>ET_VivicoreTree</defName>
    <label>Vivicore Tree</label>
    <description>A spectacle to behold, the Vivicore Tree is a tree with an ashen wood on the outside, but with a pink-orange crystal core filling the inside. It is quite a rare site, but one of the only 'hybrid'-class Terraplants that can naturally grow; therefore, it is often one of the earliest spotted - and utilized - hybrid plants used.
The Vivicore Tree is an incredible and rare sight. It can be cut down, but once this happens, it may be months - or years - until another one is spotted. Not to mention most will highly disapprove of the action.
\nRather, it is recommended to use the Vivicore Tree as a centerpeice for a grove or a meditation spot, as it's unique and prstine appearance serve both of these purposes quite well.
The Vivicore tree can also produce a special weapon with proper care, but this process take a couple years; additionally, this weapon isn't exactly designed for battle....</description>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Plant/HybridTrees/VivicoreTree</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <shadowData>
        <volume>(0.21, 0.6, 0.21)</volume>
      </shadowData>
    </graphicData>
    <tickerType>Normal</tickerType>
    <canScatterOver>false</canScatterOver>
    <descriptionHyperlinks>
      <ThingDef>ET_HybridRoyalRifleOne</ThingDef>
    </descriptionHyperlinks>
    <minifiedDef IsNull="True" />
    <statBases>
      <Beauty>33</Beauty>
      <BeautyOutdoors>33</BeautyOutdoors>
      <Flammability>1</Flammability>
      <MaxHitPoints>150</MaxHitPoints>
    </statBases>
    <killedLeavings>
      <ET_Brightsap>8</ET_Brightsap>
    </killedLeavings>
    <ingestible />
    <preventSkyfallersLandingOn>true</preventSkyfallersLandingOn>
    <plant>
      <growDays>120</growDays>
      <visualSizeRange>2~2.2</visualSizeRange>
      <sowMinSkill>6</sowMinSkill>
      <sowTags>
        <li>Ground</li>
      </sowTags>
      <lifespanDaysPerGrowDays>0</lifespanDaysPerGrowDays>
      <fertilityMin>0.8</fertilityMin>
      <fertilitySensitivity>0</fertilitySensitivity>
      <wildClusterWeight>0</wildClusterWeight>
      <topWindExposure>0.05</topWindExposure>
      <mustBeWildToSow>true</mustBeWildToSow>
      <sowWork>400</sowWork>
      <harvestTag>Standard</harvestTag>
      <harvestYield>0.5</harvestYield>
      <harvestedThingDef>ET_HybridRoyalRifleOne</harvestedThingDef>
      <harvestFailable>false</harvestFailable>
      <harvestAfterGrowth>0</harvestAfterGrowth>
      <harvestMinGrowth>0.99</harvestMinGrowth>
      <neverBlightable>true</neverBlightable>
      <treeCategory>Super</treeCategory>
      <treeLoversCareIfChopped>true</treeLoversCareIfChopped>
      <dieIfNoSunlight>false</dieIfNoSunlight>
      <growMinGlow>0</growMinGlow>
      <dieIfLeafless>false</dieIfLeafless>
      <!--<sowResearchPrerequisites>
        <li>ET_SapBasics</li>
      </sowResearchPrerequisites>-->
      <dieFromToxicFallout>False</dieFromToxicFallout>
      <showGrowthInInspectPane>true</showGrowthInInspectPane>
      <minSpacingBetweenSamePlant>11.9</minSpacingBetweenSamePlant>
      <blockAdjacentSow>true</blockAdjacentSow>
      <warnIfMarkedForCut>true</warnIfMarkedForCut>
      <burnedThingDef IsNull="True" />
      <choppedThingDef IsNull="True" />
      <smashedThingDef IsNull="True" />
      <purpose>Misc</purpose>
    </plant>
    <comps>
      <li Class="CompProperties_GiveThoughtToAllMapPawnsOnDestroy">
        <thought>ET_VivicoreTreeDestroyed</thought>
        <message>A vivicore tree has been destroyed.</message>
      </li>
      <li Class="CompProperties_PlaySoundOnDestroy">
        <sound>ET_CrystalShatter</sound>
      </li>
      <li Class="CompProperties_ToggleDrawAffectedMeditationFoci" />
      <li Class="CompProperties_Glower">
        <glowRadius>7</glowRadius>
        <glowColor>(248,242,153,0)</glowColor>
      </li>
      <li Class="CompProperties_SelfhealHitpoints">
        <ticksPerHeal>2000</ticksPerHeal>        <!-- 30 hp per day, must be a multiple of 2000, since plants have Long ticker -->
      </li>
      <li Class="CompProperties_PlantPreventCutting"/>
      <li Class="CVNPlantUtils.CompProperties_AssemblingItem">
        <isAssemblingPawn>false</isAssemblingPawn>
        <uiIconChooseRecipe>Things/Building/powernode_researchlink</uiIconChooseRecipe>
        <uiIconStartProcess>Things/Building/powernode_researchlink</uiIconStartProcess>
        <useConnectedFacility>false</useConnectedFacility>
        <useZone>false</useZone>
        <radius>11</radius>
        <effectWorking>Smith</effectWorking>
        <recipeSet>
          <li>
            <label>awaken vivicore rifle</label>
            <duration>7200000</duration> <!--2 years-->
            <resultDef>ET_HybridRoyalRifleOne</resultDef>
            <amount>1</amount>
            <ingredientSets>
              <li>
                <thingDef>ET_Brightsap</thingDef>
                <amount>12</amount>
              </li>
              <!--<li>
                <thingDef>ET_Shocksap</thingDef>
                <amount>6</amount>
              </li>-->
            </ingredientSets>
          </li>
        </recipeSet>
      </li>
      <li Class="CompProperties_InspectString">
        <inspectString>Check Information for all recipes</inspectString>
      </li>
    </comps>
    <specialDisplayRadius>10.9</specialDisplayRadius>
  </ThingDef>

</Defs>
