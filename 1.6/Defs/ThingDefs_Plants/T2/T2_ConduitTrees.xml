<ThingDef Name="ET_MegatreeBase" ParentName="PlantBaseNonEdible" Abstract="True">
    <graphicData>
      <texPath>Things/Plant/ConduitTrees/ElderwoodWildbarkTree</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <minifiedDef IsNull="True" />
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
    </statBases>
    <selectable>true</selectable>
    <pathCost>14</pathCost>
    <maxTechLevelToBuild>Ultra</maxTechLevelToBuild>
    <plant>
      <maxMeshCount>1</maxMeshCount>
      <growDays>2</growDays> 
      <fertilityMin>0.05</fertilityMin>
      <fertilitySensitivity>0</fertilitySensitivity>
      <growMinGlow>0</growMinGlow>
      <burnedThingDef IsNull="True" />
      <immatureGraphicPath>Things/Plant/ConduitTrees/ElderwoodWildbarkTree</immatureGraphicPath>
      <sowWork>6000</sowWork>
      <sowTags>
        <li>Ground</li>
      </sowTags>
      <blockAdjacentSow>true</blockAdjacentSow>
      <minSpacingBetweenSamePlant>4.9</minSpacingBetweenSamePlant>
      <topWindExposure>0</topWindExposure>
      <visualSizeRange>0.7~1</visualSizeRange>
      <treeLoversCareIfChopped>false</treeLoversCareIfChopped>
      <sowResearchPrerequisites Inherit="False" />
