      <dieIfNoSunlight>false</dieIfNoSunlight>
      <dieFromToxicFallout>false</dieFromToxicFallout>
      <showGrowthInInspectPane>true</showGrowthInInspectPane>
      <purpose>Misc</purpose>
    </plant>
  </ThingDef>

  <ThingDef ParentName="ET_MegatreeBase">
    <defName>ET_WildbarkTreeTierTwo_Immature</defName>
    <label>Wildbark Megatree</label>
    <description>The Wildbark Tree is a special Conduit tree that Ecotech devotees learn to properly nurture, enabling tribes to live safely under natural resources.
Twice a year, the tree will grow a random bark, which can then be harvested in massive amounts. The type of bark that's grown can't be controlled, and the process is quite long, but the final bounty is always massive and incredibly efficient.
Wildbark Trees can only grow bark platings.
\n\nThe tree will produce 2-3 stacks's worth of wood of one of the following, roughly once a year:
-Primwood Plating
-Elderwood Plating
Multiple Wildbark Trees can exist together, but extensive spacing is required between each one. This tree also takes up a 3x3 space, so the surrounding area should be preserved while it's growing.</description>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Plant/ConduitTrees/ElderwoodWildbarkTree_Immature</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <drawSize>(1,1)</drawSize>
      <shadowData>
        <volume>(0.21, 0.6, 0.21)</volume>
      </shadowData>
    </graphicData>
    <tickerType>Normal</tickerType>
    <canScatterOver>false</canScatterOver>
    <descriptionHyperlinks>
      <ThingDef>ET_TierOnePlating</ThingDef>
      <ThingDef>ET_TierTwoPlating</ThingDef>
    </descriptionHyperlinks>
    <minifiedDef IsNull="True" />
    <statBases>
      <Beauty>12</Beauty>      <!--Perhaps try to add beauty that matches the bark type?-->
      <BeautyOutdoors>12</BeautyOutdoors>
      <Flammability>2</Flammability>      <!--T1=3-->
      <MaxHitPoints>200</MaxHitPoints>      <!--T1=300-->
    </statBases>
    <killedLeavings>
      <ET_Glowsap>30</ET_Glowsap>
      <!--Perhaps a comp that also leaves behind the wood of which is was growing? Might be overkill-->
    </killedLeavings>
    <preventSkyfallersLandingOn>false</preventSkyfallersLandingOn>
    <selectable>true</selectable>
    <plant>
      <mustBeWildToSow>true</mustBeWildToSow>
      <growDays>1</growDays>
      <immatureGraphicPath>Things/Plant/ConduitTrees/ElderwoodWildbarkTree_Immature</immatureGraphicPath>
      <visualSizeRange>1~3</visualSizeRange>      <!--Both attributes .3 higher than T1 trees-->
      <sowMinSkill>6</sowMinSkill>
      <sowTags>
        <li>Ground</li>
      </sowTags>
      <lifespanDaysPerGrowDays>0</lifespanDaysPerGrowDays>
      <fertilityMin>0.05</fertilityMin>
      <fertilitySensitivity>0</fertilitySensitivity>
      <wildClusterWeight>0</wildClusterWeight>
      <harvestYield>0</harvestYield>
      <neverBlightable>true</neverBlightable>
      <treeCategory>Super</treeCategory>
      <dieIfNoSunlight>false</dieIfNoSunlight>
      <growMinGlow>0</growMinGlow>
      <dieIfLeafless>false</dieIfLeafless>
      <dieFromToxicFallout>False</dieFromToxicFallout>
      <showGrowthInInspectPane>true</showGrowthInInspectPane>
      <minSpacingBetweenSamePlant>47.9</minSpacingBetweenSamePlant>
      <blockAdjacentSow>true</blockAdjacentSow>
      <warnIfMarkedForCut>true</warnIfMarkedForCut>
      <burnedThingDef IsNull="True" />
      <choppedThingDef IsNull="True" />
      <smashedThingDef IsNull="True" />
      <purpose>Misc</purpose>
    </plant>
    <comps>
      <li Class="CompProperties_PlantPreventCutting"/>
      <li Class="Ecotech.ThingCompProperties_PlantTransformOnMaturity">
        <compClass>Ecotech.ThingComp_PlantTransformOnMaturity</compClass>
        <transformedThing>ET_WildbarkTreeTierTwo_Mature</transformedThing>
        <isTransformedThingRotatable>false</isTransformedThingRotatable>
        <transformedPositionOffset>(0, 1)</transformedPositionOffset>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>5</glowRadius>
        <glowColor>(237,211,78,0)</glowColor>
      </li>
      <li Class="CompProperties_SelfhealHitpoints">
        <ticksPerHeal>2000</ticksPerHeal>        <!-- 30 hp per day, must be a multiple of 2000, since plants have Long ticker -->
      </li>
    </comps>
    <specialDisplayRadius>67.9</specialDisplayRadius>
  </ThingDef>

