<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="ET_FundamentalPlantBase">
    <defName>ET_BrightsapBay_Immature</defName>
    <label>Brightsap Bay Sprout</label>
    <description>A small, organic growth that will eventually grow into a self-sustaining brightsap bay.
While it grows slow, these brightsap bays are far more potent that glowsap bays, capable of handling many growths that don't have any special properties. This makes it a staple amongst terratech tribes.
These bays can be rotated once planted and before they fully mature. However, they will lose the ability to be rotated once fully mature, and will need to be fully destroyed if their rotation is wrong or wanted to be changed.</description>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Plant/SapBays/BrightsapBay_Immature</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shadowData>
        <volume>(0.21, 0.6, 0.21)</volume>
      </shadowData>
    </graphicData>
    <tickerType>Normal</tickerType>
    <canScatterOver>false</canScatterOver>
    <descriptionHyperlinks>
      <ThingDef>ET_Brightsap</ThingDef>
      <ThingDef>ET_BrightsapBay</ThingDef>
    </descriptionHyperlinks>
    <minifiedDef IsNull="True" />
    <statBases>
      <Beauty>0</Beauty>      <!--Perhaps try to add beauty that matches the bark type?-->
      <BeautyOutdoors>0</BeautyOutdoors>
      <Flammability>2</Flammability>      <!--T1=3-->
      <MaxHitPoints>200</MaxHitPoints>      <!--T1=300-->
    </statBases>
    <killedLeavings>
      <ET_Brightsap>2</ET_Brightsap>
      <!--Perhaps a comp that also leaves behind the wood of which is was growing? Might be overkill-->
    </killedLeavings>
    <preventSkyfallersLandingOn>false</preventSkyfallersLandingOn>
    <selectable>true</selectable>
    <plant>
      <mustBeWildToSow>true</mustBeWildToSow>
      <growDays>4</growDays>
      <visualSizeRange>0.5~1</visualSizeRange>      <!--Both attributes .3 higher than T1 trees-->
      <sowMinSkill>6</sowMinSkill>
      <sowTags>
        <li>Ground</li>
      </sowTags>
      <lifespanDaysPerGrowDays>0</lifespanDaysPerGrowDays>
      <completelyIgnoreFertility>true</completelyIgnoreFertility>
      <fertilitySensitivity>0.5</fertilitySensitivity>
      <wildClusterWeight>0</wildClusterWeight>
      <harvestYield>0</harvestYield>
      <neverBlightable>true</neverBlightable>
      <treeCategory>Super</treeCategory>
      <dieIfNoSunlight>false</dieIfNoSunlight>
      <growMinGlow>0</growMinGlow>
      <dieIfLeafless>false</dieIfLeafless>
      <dieFromToxicFallout>False</dieFromToxicFallout>
      <showGrowthInInspectPane>true</showGrowthInInspectPane>
      <blockAdjacentSow>false</blockAdjacentSow>
      <warnIfMarkedForCut>true</warnIfMarkedForCut>
      <burnedThingDef IsNull="True" />
      <choppedThingDef IsNull="True" />
      <smashedThingDef IsNull="True" />
      <purpose>Misc</purpose>
    </plant>
    <comps>
      <li Class="CompProperties_PlantPreventCutting"/>
      <li Class="Ecotech.ThingCompProperties_PlantTransformOnMaturity">
        <compClass>Ecotech.ThingComp_PlantTransformOnMaturity</compClass>
        <transformedThing>ET_BrightsapBay</transformedThing>
        <transformedPositionOffset>(0, 0)</transformedPositionOffset>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>5</glowRadius>
        <glowColor>(237,211,78,0)</glowColor>
      </li>
      <li Class="CompProperties_SelfhealHitpoints">
        <ticksPerHeal>2000</ticksPerHeal>        <!-- 30 hp per day, must be a multiple of 2000, since plants have Long ticker -->
      </li>
    </comps>
  </ThingDef>

</Defs>
