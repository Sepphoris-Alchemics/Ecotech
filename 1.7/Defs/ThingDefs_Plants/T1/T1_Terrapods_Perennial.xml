  <ThingDef ParentName="ET_PeriwoodRegrowthPodBase">
    <defName>ET_PeriwoodWeaponPod</defName>
    <label>Periwood terraweapon pod</label>
    <description>A fortified Terrapod that will create a random Periwood Terraweapon. Quite durable, but takes a long time to produce a final product. Seed can only be acquired from an expiring Periwood weapon.
\nBe aware that the growth is a delicate process. If this pod is destroyed, any weapon inside it will be destroyed as well.
\nDue to the way the pod grows, smaller weapons are more likely to form over bigger/longer ones.</description>
    <descriptionHyperlinks>
      <ThingDef>ET_OverviewPeriwoodWeapons</ThingDef>
    </descriptionHyperlinks>
    <comps>
      <li Class="Ecotech.ThingCompProperties_CyclicThingSpawner">
        <compClass>Ecotech.ThingComp_CyclicThingSpawner</compClass>
        <cycleDurationRangeTicks>840000</cycleDurationRangeTicks>        <!--14 days-->
        <showNotificationWhenSpawningThings>true</showNotificationWhenSpawningThings>
        <potentialSpawnedThings>
          <li>
            <weight>0.5</weight>
            <things>
              <ET_PeriwoodRifle>1</ET_PeriwoodRifle>
            </things>
          </li>
          <li>
            <weight>1</weight>
            <things>
              <ET_PeriwoodSMG>1</ET_PeriwoodSMG>
            </things>
          </li>
          <li>
            <weight>0.25</weight>
            <things>
              <ET_PeriwoodCannon>1</ET_PeriwoodCannon>
            </things>
          </li>
          <li>
            <weight>0.5</weight>
            <things>
              <ET_PeriwoodGlaive>1</ET_PeriwoodGlaive>
            </things>
          </li>
        </potentialSpawnedThings>
      </li>
      <li Class="CompProperties_Lifespan">
        <lifespanTicks>840030</lifespanTicks>        <!--30 ticks longer to make sure the weapon spawns-->
      </li>
    </comps>
  </ThingDef>


  <ThingDef ParentName="ET_PeriwoodRegrowthPodBase">
    <defName>ET_PeriwoodSMGGrowthPod</defName>
    <label>Periwood Needler Pod</label>
    <description>A fortified Terrapod that is revitalizing a Terraweapon. Will produce a single, revitalized Periwood Needler when finished.
\nBe aware that the growth is a delicate process. If this pod is destroyed, any weapon inside it will be destroyed as well.</description>
    <comps>
      <li Class="CompProperties_Spawner">
        <thingToSpawn>ET_PeriwoodSMG</thingToSpawn>
        <spawnCount>1</spawnCount>
        <spawnIntervalRange>900000</spawnIntervalRange>        <!--15 days to respawn-->
        <spawnForbidden>false</spawnForbidden>
        <requiresPower>false</requiresPower>
        <showMessageIfOwned>true</showMessageIfOwned>
        <writeTimeLeftToSpawn>true</writeTimeLeftToSpawn>
      </li>
      <li Class="CompProperties_Lifespan">
        <lifespanTicks>900030</lifespanTicks>        <!--30 ticks longer to make sure the weapon spawns-->
      </li>
    </comps>
  </ThingDef>

