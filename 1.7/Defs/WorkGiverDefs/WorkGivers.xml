  <WorkGiverDef>
    <defName>ET_PlantSeed</defName>
    <label>replant seed</label>
    <giverClass>Ecotech.WorkGiver_PlantSeed</giverClass>
    <workType>Growing</workType>
    <priorityInType>60</priorityInType>
    <verb>replant</verb>
    <gerund>replanting</gerund>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
