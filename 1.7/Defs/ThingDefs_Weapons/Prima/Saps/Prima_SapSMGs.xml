<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!--Endosap differences:
	50% higher item health
	75% lower flammability
	Mass increase of .5-->

	<!--=====Endosap=====-->

	<ThingDef ParentName="BaseEndosapTerraweapon">
		<defName>ET_PrimaSMGEndosap</defName>
		<label>prima endoshredder</label>
		<description>The matured form of the Prima Pincaster, infused with the Endosap. The presence of the endosap has enabled the pincaster to create a more durable epidermis, and decreasing flammability.</description>
		<graphicData>
			<texPath>Things/WeaponPrima/Endosap/PrimaSMGUpgraded_ES</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>0.8</drawSize>
		</graphicData>
		<soundInteract>Interact_SMG</soundInteract>
		<weaponTags Inherit='False'>
      <li>ET_PlantWeapon</li>
		</weaponTags>
    <weaponClasses>
      <li>RangedLight</li>
			<li>ShortShots</li>
    </weaponClasses>
    <relicChance>0</relicChance>
		<statBases>
      <MaxHitPoints>60</MaxHitPoints>
			<AccuracyTouch>0.90</AccuracyTouch>
			<AccuracyShort>0.70</AccuracyShort>
			<AccuracyMedium>0.30</AccuracyMedium>
			<AccuracyLong>0.15</AccuracyLong>
			<RangedWeapon_Cooldown>0.45</RangedWeapon_Cooldown>
			<DeteriorationRate>0</DeteriorationRate>
			<Mass>1.2</Mass>
			<Flammability>0.75</Flammability>
      <WorkToMake>12000</WorkToMake>
		</statBases>
		<techLevel>Neolithic</techLevel>
		<smeltable>false</smeltable>
    <equippedAngleOffset>50</equippedAngleOffset>
    <verbs>
      <li>
        <verbClass>VEF.Weapons.Verb_MakeshiftShoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_ThornSMG</defaultProjectile>
        <warmupTime>0.75</warmupTime>
        <range>17.9</range>
        <burstShotCount>4</burstShotCount>
        <ticksBetweenBurstShots>6</ticksBetweenBurstShots>
        <soundCast>ET_Sound_BlowgunLight</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
		<tools>
			<li>
				<label>grip</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<tickerType>Normal</tickerType>
		<comps>
			<li Class="CompProperties_InspectString">
				<inspectString>&lt;color=#68bd46&gt;Organic-class&lt;/color&gt; | &lt;color=#327f3b&gt;Infused with Endosap&lt;/color&gt;
&lt;color=#327f3b&gt;+25 health&lt;/color&gt; | &lt;color=#327f3b&gt;+8 lifetime days&lt;/color&gt;</inspectString>
			</li>
        <li Class="Ecotech.ThingCompProperties_EquippedLifespan">
          <compClass>Ecotech.ThingComp_EquippedLifespan</compClass>
          <lifespanTicks>3300000</lifespanTicks>
          <lifespanBarColor>(50, 127, 59)</lifespanBarColor>
          <!--<expireEffect></expireEffect>-->
		<replacementToSpawn>ET_Seed_PrimaApexTurret</replacementToSpawn>
        </li>
		</comps>
		<modExtensions>
			<li Class="VEF.Weapons.MoteProperties">
				<fleckDef>WoodBit</fleckDef>
				<size>0.2</size>
				<velocity>1</velocity>
				<angleRange>-15~15</angleRange>
				<rotationRange>-5~5</rotationRange>
				<numTimesThrown>1</numTimesThrown>
			</li>
			<li Class="VEF.Weapons.MakeshiftProperties">
				<shots>4~5</shots>
			</li>
		</modExtensions>
	</ThingDef>

	<!--=====Hypersap=====-->

	<ThingDef ParentName="UpgradedHypersapTerraweapon_Single">
		<defName>ET_PrimaSMGHypersap</defName>
		<label>prima hypershredder</label>
		<description>The Apex form of the Prima Pincaster, infused with the Hypersap. The presence of the sap has enabled the pineshredder has increased the range, projectile speed, and fire rate.
\nAdditionally, the sap has also altered the minimum and maximum projectiles. It now fires 3-7 projectiles per burst, instead of 4-5.</description>
		<graphicData>
			<texPath>Things/WeaponPrima/Hypersap/PrimaSMGUpgraded_HS</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>0.8</drawSize>
		</graphicData>
		<soundInteract>Interact_SMG</soundInteract>
		<weaponTags Inherit='False'>
      <li>ET_PlantWeapon</li>
		</weaponTags>
    <weaponClasses>
      <li>RangedLight</li>
			<li>ShortShots</li>
    </weaponClasses>
    <relicChance>0</relicChance>
		<statBases>
      <MaxHitPoints>40</MaxHitPoints>
			<AccuracyTouch>0.90</AccuracyTouch>
			<AccuracyShort>0.70</AccuracyShort>
			<AccuracyMedium>0.30</AccuracyMedium>
			<AccuracyLong>0.15</AccuracyLong>
			<RangedWeapon_Cooldown>0.20</RangedWeapon_Cooldown> <!--Lowered from 0.45-->
			<DeteriorationRate>0</DeteriorationRate>
			<Mass>1.2</Mass>
			<Flammability>2</Flammability>
      <WorkToMake>12000</WorkToMake>
		</statBases>
		<techLevel>Neolithic</techLevel>
		<smeltable>false</smeltable>
    <equippedAngleOffset>50</equippedAngleOffset>
    <verbs>
      <li>
        <verbClass>VEF.Weapons.Verb_MakeshiftShoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_ThornSMG</defaultProjectile>
        <warmupTime>0.75</warmupTime>
        <range>19.9</range>
        <burstShotCount>3</burstShotCount>
        <ticksBetweenBurstShots>6</ticksBetweenBurstShots>
        <soundCast>ET_Sound_BlowgunLight</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
		<tools>
			<li>
				<label>grip</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<tickerType>Normal</tickerType>
		<comps>
        <li Class="Ecotech.ThingCompProperties_EquippedLifespan">
          <compClass>Ecotech.ThingComp_EquippedLifespan</compClass>
          <lifespanTicks>2700000</lifespanTicks> <!--Light weapon-->
          <lifespanBarColor>(159, 115, 255)</lifespanBarColor>
        </li>
		</comps>
		<modExtensions>
			<li Class="VEF.Weapons.MoteProperties">
				<fleckDef>WoodBit</fleckDef>
				<size>0.2</size>
				<velocity>1</velocity>
				<angleRange>-15~15</angleRange>
				<rotationRange>-5~5</rotationRange>
				<numTimesThrown>1</numTimesThrown>
			</li>
			<li Class="VEF.Weapons.MakeshiftProperties">
				<shots>3~7</shots> <!--Hypersap burst count is lowered by 1, but increased by 2.-->
			</li>
		</modExtensions>
	</ThingDef>

