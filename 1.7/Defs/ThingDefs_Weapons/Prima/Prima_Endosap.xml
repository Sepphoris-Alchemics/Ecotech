		<graphicData>
			<texPath>Things/WeaponPrima/Endosap/PrimaMaulBasic_ES</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>1</drawSize>
		</graphicData>
    <thingCategories>
      <li>InfusedTerraweapons</li>
    </thingCategories>
		<weaponTags Inherit='False'>
      <li>ET_PlantWeapon</li>
			<li>ET_PrimaMeleeBasic</li>
		</weaponTags>
    <relicChance>0</relicChance>
		<statBases>
      <MaxHitPoints>75</MaxHitPoints>
			<Mass>1.6</Mass>
			<Flammability>0.5</Flammability>
      <WorkToMake>12000</WorkToMake>
