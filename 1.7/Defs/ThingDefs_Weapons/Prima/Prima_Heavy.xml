<Defs>

<!--
TIME TICK BASICS:
60,000 = 1 day
900,000 = 1 quadrum (15 days)
3,600,000	 = 1 quadrum (60 days)

Upgraded Primas get +10 health and -1 flammability. 1.2 lifespan times below:
			-Immature light: 30 days (1800000) | 30 health
			-Immature normal: 45 days (2700000) | 35 health
			-Immature heavy: 60 days (3600000) | 40 health

			-Mature light: 45 days (2700000) | 40 health
        -Sunsap: 4050000 | Endosap: 3300000 lifespan + 60 health
			-Mature normal: 60 days (3600000) | 45 health
        -Sunsap: 5400000 | Endosap 4200000 lifespan + 70 health
			-Mature heavy: 75 days (4500000) | 50 health
        -Sunsap: 6750000 | Endosap 5100000 lifespan + 75 health
      +2 range for mature
      +0.2 mass for mature
      +1 burst
-->

<!--Prima Stakecaster downgraded to an entry weapon. Still quite powerful, but very limited on ammo and speed.-->

	<ThingDef ParentName="BaseUnupgradableTerraweapon">
		<defName>ET_PrimaRifle</defName> <!--Counterpart: Bolt Action-->
		<label>prima OLR</label>
		<description>The OLR (Organic Long Rifle) is a biotic weapon patterned off of a long-range rifle, and grown straight from a specialized pod. Due to its plant nature, no optics are present, giving it a lower range than most other longrifles.\n\nThis weapon is entirely organic; it has a limited lifetime and will eventually expire, but can be easily regrown.</description>
		<graphicData>
			<texPath>Things/WeaponPrima/Basic/ET_PrimaRifleBasic</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>1.2</drawSize>
		</graphicData>
		<soundInteract>Interact_Rifle</soundInteract>
		<weaponTags Inherit='False'>
			<li>ET_ET_PlantWeapon</li>
			<li>ET_InitiateHeavyWeapon</li>
		</weaponTags>
    <weaponClasses>
      <li>Ranged</li>
    </weaponClasses>
    <relicChance>0</relicChance>
		<statBases>
      <MaxHitPoints>40</MaxHitPoints> <!--80 shots-->
			<AccuracyTouch>0.70</AccuracyTouch>
			<AccuracyShort>0.80</AccuracyShort>
			<AccuracyMedium>0.70</AccuracyMedium>
			<AccuracyLong>0.40</AccuracyLong>
			<RangedWeapon_Cooldown>0.75</RangedWeapon_Cooldown>
			<DeteriorationRate>0</DeteriorationRate>
			<Mass>1.6</Mass>
			<Flammability>3</Flammability>
      <WorkToMake>12000</WorkToMake>
		</statBases>
		<techLevel>Neolithic</techLevel>
		<smeltable>false</smeltable>
    <equippedAngleOffset>50</equippedAngleOffset>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_ThornRifle</defaultProjectile>
        <warmupTime>2.125</warmupTime>
        <range>29.9</range>
        <soundCast>ET_Sound_BlowgunMedium</soundCast>
        <muzzleFlashScale>0</muzzleFlashScale>
      </li>
    </verbs>
		<tools>
			<li>
				<label>grip</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<tickerType>Normal</tickerType>
		<comps>
			<li Class="CompProperties_SelfhealHitpoints">
        <ticksPerHeal>12000</ticksPerHeal> <!-- 6k ticks = 10hp/day, 12k ticks = 5hp/day, 24k ticks = 2.5hp/day -->
