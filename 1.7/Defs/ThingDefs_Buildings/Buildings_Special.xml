<ThingDef ParentName="BuildingBase">
    <defName>ET_MidasTransmutationPylon</defName>
    <label>transmutation pylon</label>
    <description>A large monolith consisting of a vivium crystal and reinforced by ebonwood. Designed by Wildheart tribes, the transmutation pylon is a highly successful - and lethal - structure. When activated, it will stun and begin transmuting organics within it's radius. Anything that can't quickly escape will be killed, and be turned into a variety of valuable resources.
Even by terratech standards, this pylon was often seen excessive and overly violent, and it didn't often see use. Still, it's potential to turn raiders - and excess prisoners - into an abundance of usable resources should not be underestimated.
\nThis pylon will transmute ANYONE within it's radius - including your own. Therefore, it is EXTREMELY suggested to outfit EVERY colonist you have with a Vivium Wardlimb before establishing one of these pylons.</description>
    <tickerType>Normal</tickerType>
    <size>(1,1)</size>
    <drawerType>RealtimeOnly</drawerType>
    <fillPercent>1</fillPercent>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/TransmutePylon/ET_TransmutePylon_Vivium</texPath>
      <drawSize>(1.5,1.5)</drawSize>
      <addTopAltitudeBias>true</addTopAltitudeBias>
      <drawOffset>(0,0,0.3)</drawOffset>
      <shadowData>
        <volume>(2.5, 5, 2.5)</volume>
        <offset>(0, 0, -0.3)</offset>
      </shadowData>
    </graphicData>
    <drawGUIOverlay>True</drawGUIOverlay>
    <!--<minifiedDef>MinifiedThing</minifiedDef>-->
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <specialDisplayRadius>5</specialDisplayRadius>
    <building>
      <artificialForMeditationPurposes>false</artificialForMeditationPurposes>
      <ai_combatDangerous>true</ai_combatDangerous>
      <paintable>false</paintable>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
      <soundMeleeHitOverride>ObeliskDamaged</soundMeleeHitOverride>
    </building>
    <placeWorkers>
      <li>VEF.Buildings.PlaceWorker_CompCustomCauseHediff_AoE</li>
    </placeWorkers>
    <killedLeavings>
    </killedLeavings>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <Flammability>0.2</Flammability>
      <MeditationFocusStrength>1</MeditationFocusStrength>
    </statBases>
    <comps>
      <li Class="CompProperties_CauseHediff_AoE">
        <hediff>ET_TotalAlchemizingInfection</hediff>
        <range>4.9</range>
        <canTargetSelf>false</canTargetSelf>
        <drawLines>true</drawLines>
        <ignoreMechs>true</ignoreMechs>
      </li>
      <li Class="CompProperties_Refuelable"> <!--Same life duration-->
        <consumeFuelOnlyWhenUsed>false</consumeFuelOnlyWhenUsed>
        <fuelConsumptionRate>3</fuelConsumptionRate>
        <destroyOnNoFuel>true</destroyOnNoFuel>
        <fuelCapacity>100</fuelCapacity>
        <fuelLabel>Stability percentage left</fuelLabel>
        <initialFuelPercent>1</initialFuelPercent>
        <fuelMultiplier>100</fuelMultiplier>
        <fuelFilter>
          <thingDefs>
            <li>ET_Shocksap</li>
          </thingDefs>
        </fuelFilter>
      </li> 
      <!--<li Class="CompProperties_MeditationFocus">
        <statDef>MeditationFocusStrength</statDef>
