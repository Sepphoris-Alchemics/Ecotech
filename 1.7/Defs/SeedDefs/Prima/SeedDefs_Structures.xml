<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<!--
	-Sap effects (beacon):
  Glowsap: nothing, returns a sap lamp seed when destroyed
  Brightsap: higher radius + luminosity, drops a sap lamp seed when destroyed
  Deepsap: Sap lasts 50% longer, increases plant growth speed
  Endosap: lower flammability, increases resistances
  Hypersap: increases pawn speed
  Shocksap: occasionally shocks hostiles nearby, lowers sleep loss
  Embersap: infinite lifespan, burns enemies in a large radius, increases temperature in radius
  Cryosap: infinite lifespan, drastically slows enemies, decreases temperature in radius
  Arcsap: infinite lifespan, shocks hostiles nearby, increases conciousness
  Toxsap: 50% lifespan decrease, poisons enemies nearby, cleanses toxic packs and pullution
  Sunsap: extremely bright radius, luminosity is 100%
  Psysap: provides minor psychic soothe

-->

<ThingDef ParentName="ResourceBase">
    <defName>ET_Seed_PrimaSapLamp</defName>
    <label>Prima sap lamp</label>
    <description>A warm seed that has been patterned to grow into a sap lamp. A sap lamp produces slightly lower light than a normal lamp, but due to the sap acting as a static light source, it can glow for years before the sap needs to be replaced.
\n\nThis seed ignores fertility, allowing it to be planted on many surfaces. Once grown, the lamp deeply roots into the surface beneath it, making it unable to be moved.</description>
    <possessionCount>0</possessionCount>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/Resource/SurgeSeed</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
      <drawSize>0.3</drawSize>
    </graphicData>
    <stackLimit>8</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <intricate>true</intricate>
    <statBases>
      <MaxHitPoints>30</MaxHitPoints>
      <MarketValue>45</MarketValue>
      <Mass>0.015</Mass>
      <Flammability>2</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>TerraseedsPrimaStructures</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Plantable">
        <plantDefToSpawn>ET_PrimaSapLampPlant</plantDefToSpawn>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>1.9</glowRadius>
        <glowColor>(238,211,77,0)</glowColor>
      </li>
    </comps>
    <tradeTags Inherit='false'>
      <li>ET_PrimaStructureSeed</li>
    </tradeTags>
    <allowedArchonexusCount>4</allowedArchonexusCount>
  </ThingDef>

