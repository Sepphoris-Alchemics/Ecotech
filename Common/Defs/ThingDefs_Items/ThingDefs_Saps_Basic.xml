  <ThingDef ParentName="ResourceBase">
    <defName>ET_Brightsap</defName>
    <label>Brightsap</label>
    <description>A jar of refined, potent terrasap, named due to the vibrant glow it emits. When used as a fuel in a Terraforge, this sap can completely revitialize and restore the lifespan of various Terraweapons within it. It is also used as a catalyst for light-emitting Terratech plants.
\n\nBrightsap can be used on any matured weapon within a Terravat. To use it, insert this sap as a fuel source, then insert the weapon you wish to revitalize.</description>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/Resource/Brightsap</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>0.8</drawSize>
    </graphicData>
    <stackLimit>6</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <intricate>true</intricate>    <!-- Not returned to player when product made of this is smelted. -->
    <statBases>
      <MaxHitPoints>75</MaxHitPoints>
      <MarketValue>104</MarketValue>
      <Mass>0.05</Mass>
      <Flammability>1</Flammability>
      <DeteriorationRate>0.25</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>TerrasapsAll</li>
    </thingCategories>
    <!--<comps>
      <li Class="CompProperties_Glower">
        <glowRadius>1.9</glowRadius>
        <glowColor>(370,370,370,0)</glowColor>
      </li>
    </comps>-->
    <modExtensions>
      <li Class="Ecotech.ThingDefExtension_TransformerRecipe">        <!--recipes used by Terravats-->
        <recipes>
          <!--Apex weapons-->
          <li>
            <fuelCount>1</fuelCount>            <!--how much fuel the Terravat uses for the process-->
            <inputThingDef>ET_PrimaSMGUpgraded</inputThingDef>            <!--the input item needed inside the Terravat-->
            <outputThingDef>ET_PrimaSMGUpgraded</outputThingDef>            <!--the item produced after the transformation-->
            <!--outputStuff only for items or structures that are stuffable-->
            <!--<outputStuff>WoodLog</outputStuff>-->
