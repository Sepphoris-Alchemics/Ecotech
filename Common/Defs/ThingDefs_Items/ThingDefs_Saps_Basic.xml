<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--IMPORTANT: Most saps can only be applied to second-stage weapons.
      This is done to avoid texture bloat and excessive XML.
      Any immature weapons can only be given Glowsap, in order to change into their matured form.-->

  <!--
	-To-do: Glowsap can also be used to create pots that can act as a makeshift growing location. Akin to hyroponics, but with standard fertility and a limited lifespan. An ideal way to grow Terraplants in regions with low soil quality.
	-To-do: Later used in Perennial Weapons.
-->

  <ThingDef ParentName="ResourceBase">
    <defName>ET_Glowsap</defName>
    <label>Glowsap</label>
    <description>A jar of harvested glowsap. Used as a supplement or nutrition source for Ecotech plants. Unfortunately, it cannot affect baseline plants, such crops and most trees.</description>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/Resource/Glowsap</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>0.8</drawSize>
    </graphicData>
    <stackLimit>90</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <intricate>true</intricate>    <!-- Not returned to player when product made of this is smelted. -->
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <MarketValue>5.5</MarketValue>
      <Mass>0.05</Mass>
      <Flammability>3</Flammability>
      <DeteriorationRate>0.5</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>TerrasapsAll</li>
    </thingCategories>
    <!--<comps>
      <li Class="CompProperties_Glower">
        <glowRadius>1.9</glowRadius>
        <glowColor>(370,370,370,0)</glowColor>
      </li>
    </comps>-->
    <modExtensions>
      <li Class="Ecotech.ThingDefExtension_TransformerRecipe">        <!--recipes used by Terravats-->
        <recipes>
          <li>
            <fuelCount>30</fuelCount>            <!--how much fuel the Terravat uses for the process-->
            <inputThingDef>ET_PrimaSMG</inputThingDef>            <!--the input item needed inside the Terravat-->
            <outputThingDef>ET_PrimaSMGUpgraded</outputThingDef>            <!--the item produced after the transformation-->
            <!--outputStuff only for items or structures that are stuffable-->
            <!--<outputStuff>WoodLog</outputStuff>-->
          </li>
          <li>
            <fuelCount>30</fuelCount>
            <inputThingDef>ET_PrimaStakecaster</inputThingDef>
            <outputThingDef>ET_PrimaTwincaster</outputThingDef>
          </li>
          <li>
            <fuelCount>30</fuelCount>
            <inputThingDef>ET_PrimaShotgun</inputThingDef>
            <outputThingDef>ET_PrimaShotgunUpgraded</outputThingDef>
          </li>
          <li>
            <fuelCount>30</fuelCount>
            <inputThingDef>ET_PrimaSMG</inputThingDef>
            <outputThingDef>ET_PrimaSMGUpgraded</outputThingDef>
          </li>
          <li>
            <fuelCount>30</fuelCount>
            <inputThingDef>ET_PrimaCarbine</inputThingDef>
            <outputThingDef>ET_PrimaCarbineUpgraded</outputThingDef>
          </li>
          <li>
            <fuelCount>30</fuelCount>
            <inputThingDef>ET_PrimaSapLauncher_Basic</inputThingDef>
            <outputThingDef>ET_PrimaSapLauncher_Upgraded</outputThingDef>
          </li>
        </recipes>
      </li>
    </modExtensions>
    <tradeTags>
      <li>ET_SapsBasicFuel</li>
    </tradeTags>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
    <defName>ET_Darksap</defName>
    <label>Darksap</label>
    <description>A jar of harvested darksap. Used as an equal alternative to glowsap in many colonies and regions.</description>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/Resource/Darksap</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>0.8</drawSize>
    </graphicData>
    <stackLimit>6</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <intricate>true</intricate>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <MarketValue>5.5</MarketValue>
      <Mass>0.05</Mass>
      <Flammability>3</Flammability>
      <DeteriorationRate>0.5</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>TerrasapsAll</li>
    </thingCategories>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
    <defName>ET_Endosap</defName>
    <label>Endosap</label>
    <description>A jar of refined, potent terrasap, named due to it's unique features. These unique features can be applied to mature terraweapons, giving them the following alterations:
\n\nEvolves the weapon into it's matured form.
Lifespan increased by 50%
Hitpoints increased by 50% (rounded up)
Flammability decreased by 75%
Regenerates 2.5 HP/Day</description>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/Resource/Endosap</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>0.8</drawSize>
    </graphicData>
    <stackLimit>6</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <intricate>true</intricate>    <!-- Not returned to player when product made of this is smelted. -->
    <statBases>
      <MaxHitPoints>75</MaxHitPoints>
      <MarketValue>82</MarketValue>
      <Mass>0.05</Mass>
      <Flammability>1</Flammability>
      <DeteriorationRate>0.25</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>TerrasapsAll</li>
    </thingCategories>
    <!--<comps>
      <li Class="CompProperties_Glower">
        <glowRadius>1.9</glowRadius>
        <glowColor>(370,370,370,0)</glowColor>
      </li>
    </comps>-->
    <modExtensions>
      <li Class="Ecotech.ThingDefExtension_TransformerRecipe">        <!--recipes used by Terravats-->
        <recipes>
          <li>
            <fuelCount>1</fuelCount>            <!--how much fuel the Terravat uses for the process-->
            <inputThingDef>ET_PrimaSMG</inputThingDef>            <!--the input item needed inside the Terravat-->
            <outputThingDef>ET_PrimaSMGEndosap</outputThingDef>            <!--the item produced after the transformation-->
            <!--outputStuff only for items or structures that are stuffable-->
            <!--<outputStuff>WoodLog</outputStuff>-->
          </li>
          <li>
            <fuelCount>1</fuelCount>
            <inputThingDef>ET_PrimaStakecaster</inputThingDef>
            <outputThingDef>ET_PrimaTwincasterEndosap</outputThingDef>
          </li>
          <li>
            <fuelCount>1</fuelCount>
            <inputThingDef>ET_PrimaShotgun</inputThingDef>
            <outputThingDef>ET_PrimaShotgunEndosap</outputThingDef>
          </li>
        </recipes>
      </li>
    </modExtensions>
    <tradeTags>
      <li>ET_SapsBasic</li>
    </tradeTags>
  </ThingDef>

