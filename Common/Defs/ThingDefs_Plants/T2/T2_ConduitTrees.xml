<?xml version="1.0" encoding="utf-8" ?>
<Defs>
<!--todo:
add dynamic graphics and the proper wood types
add a way for the tree to recognize techs; the tree can then grow the bark.
Alternatively, add a meditation method or some sort of gizmo operation that unlocks with other techs. This is how the player "guides" the tree.
-->

  <ThingDef ParentName="TreeBase">
    <defName>ET_WildbarkTreeTierTwo</defName>
    <label>Wilderbark Tree</label>
    <description>The Wilderbark Tree is a special Conduit tree that Ecotech devotees learn to properly nurture, enabling tribes to live safely under natural resources. However, due to the nature of this tree, the technology is highly guarded, and the seed can only be acquired directly from a Terratech faction.
Once fully grown, Wilderbark trees will grow a random bark type that it's adopted colony has shown proficiency in. The type of bark that's grown can't be controlled, and the process is quite long, but the final bounty is always massive.
Wilderbark Trees can only grow bark platings.
\n\nThe tree will produce 2-3 stacks's worth of wood of one of the following, roughly once a year:
-Primwood Plating
-Elderwood Plating
-Bloomwood Plating
-Briarwood Plating
Multiple Wilderbark Trees can exist together, but extensive spacing is required between each one.</description>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Plant/ConduitTrees/PrimwoodSentinelTree</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <shadowData>
        <volume>(0.21, 0.6, 0.21)</volume>
      </shadowData>
    </graphicData>
    <tickerType>Normal</tickerType>
    <canScatterOver>false</canScatterOver>
    <descriptionHyperlinks>
      <ThingDef>ET_Glowsap</ThingDef>
    </descriptionHyperlinks>
    <minifiedDef IsNull="True" />
    <statBases>
      <Beauty>18</Beauty> <!--Perhaps try to add beauty that matches the bark type?-->
      <BeautyOutdoors>18</BeautyOutdoors>
      <Flammability>2</Flammability> <!--T1=3-->
      <MaxHitPoints>400</MaxHitPoints> <!--T1=300-->
    </statBases>
    <killedLeavings>
      <ET_Glowsap>60</ET_Glowsap>
      <!--Perhaps a comp that also leaves behind the wood of which is was growing? Might be overkill-->
    </killedLeavings>
    <ingestible />
    <preventSkyfallersLandingOn>false</preventSkyfallersLandingOn>
    <plant>
      <growDays>1</growDays> 
      <visualSizeRange>2.1~2.7</visualSizeRange> <!--Bothg attributes .3 higher than T1 trees-->
      <!--<sowMinSkill>6</sowMinSkill>
			<sowTags>
				<li>Ground</li>
			</sowTags>-->
      <lifespanDaysPerGrowDays>0</lifespanDaysPerGrowDays>
      <fertilityMin>0.05</fertilityMin>
      <fertilitySensitivity>0</fertilitySensitivity>
      <wildClusterWeight>0</wildClusterWeight>
      <harvestYield>0</harvestYield>
      <!--<mustBeWildToSow>true</mustBeWildToSow>
      <sowWork>400</sowWork>
      <harvestTag>Standard</harvestTag>
      <harvestYield>30</harvestYield>
			<harvestedThingDef>ET_Glowsap</harvestedThingDef>
			<harvestFailable>false</harvestFailable>
			<harvestAfterGrowth>0.05</harvestAfterGrowth>
      <harvestMinGrowth>0.9</harvestMinGrowth>-->
      <neverBlightable>true</neverBlightable>
      <treeCategory>Super</treeCategory>
      <dieIfNoSunlight>false</dieIfNoSunlight>
      <growMinGlow>0</growMinGlow>
      <dieIfLeafless>false</dieIfLeafless>
      <!--<sowResearchPrerequisites>
        <li>ET_SapBasics</li>
      </sowResearchPrerequisites>-->
      <dieFromToxicFallout>False</dieFromToxicFallout>
      <showGrowthInInspectPane>true</showGrowthInInspectPane>
      <minSpacingBetweenSamePlant>47.9</minSpacingBetweenSamePlant>
      <blockAdjacentSow>true</blockAdjacentSow>
      <warnIfMarkedForCut>true</warnIfMarkedForCut>
			<burnedThingDef IsNull="True" />
			<choppedThingDef IsNull="True" />
			<smashedThingDef IsNull="True" />
      <purpose>Misc</purpose>
    </plant>
    <comps>
      <li Class="Ecotech.ThingCompProperties_CyclicThingSpawner">
        <compClass>Ecotech.ThingComp_CyclicThingSpawner</compClass>
        <cycleDurationRangeTicks>3300000~3900000</cycleDurationRangeTicks> <!-- 55 to 65 days-->
        <showNotificationWhenSpawningThings>true</showNotificationWhenSpawningThings>
        <potentialSpawnedThings> <!--weights should all be equal-->
          <li>
            <weight>1</weight>
            <things>
              <ET_TierOnePlating>225~300</ET_TierOnePlating>
            </things>
          </li>
          <li>
            <weight>1</weight>
            <things>
              <ET_TierTwoPlating>225~300</ET_TierTwoPlating>
            </things>
          </li>
        </potentialSpawnedThings>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>9</glowRadius>
        <glowColor>(237,211,78,0)</glowColor>
      </li>
      <li Class="CompProperties_SelfhealHitpoints">
        <ticksPerHeal>2000</ticksPerHeal> <!-- 30 hp per day, must be a multiple of 2000, since plants have Long ticker -->
      </li>
    </comps>
    <specialDisplayRadius>67.9</specialDisplayRadius>
  </ThingDef>
</Defs>
