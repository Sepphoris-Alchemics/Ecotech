<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<!--Pods should follow the following skill rules:
Tier 1 weapons: 1-4
Tier 1 heavy: 5-7
Tier 1 upgrades: 6-8
Tier 1 surge seeds: 6-8

Tier 2 weapons: 4-8
Tier 2 heavy: 9-11
Tier 2 upgrades: 10-12
Tier 2 surge seeds: 10-12

Tier 3 weapons: 8-12
Tier 3 heavy: 13-15
Tier 3 upgrades: 14-16
Tier 3 surge seeds: 14-16

Tier 4 weapons: 16-20
Tier 4 heavy: 17-19
Tier 4 upgrades: 20
Tier 4 surge seeds: 20
-->

  <ThingDef Name="ET_PerennialRegrowthPodBase" ParentName="PlantBaseNonEdible" Abstract="True">
    <graphicData>
      <texPath>Things/Plant/PerennialPod</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <minifiedDef IsNull="True" />
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
    </statBases>
    <selectable>true</selectable>
    <pathCost>14</pathCost>
    <!--<maxTechLevelToBuild>Neolithic</maxTechLevelToBuild>-->
    <tickerType>Normal</tickerType>
    <plant>
      <growDays>1</growDays> 
      <fertilityMin>0.3</fertilityMin>
      <fertilitySensitivity>0.1</fertilitySensitivity>
      <growMinGlow>0</growMinGlow>
      <burnedThingDef IsNull="True" />
      <immatureGraphicPath>Things/Plant/PerennialPod</immatureGraphicPath>
      <sowWork>200</sowWork>
      <sowTags>
        <li>Ground</li>
      </sowTags>
      <blockAdjacentSow>true</blockAdjacentSow>
      <minSpacingBetweenSamePlant>3.9</minSpacingBetweenSamePlant>
      <topWindExposure>0.1</topWindExposure>
      <visualSizeRange>0.66~1</visualSizeRange>
      <treeLoversCareIfChopped>false</treeLoversCareIfChopped>
      <sowResearchPrerequisites Inherit="False" />
      <mustBeWildToSow>true</mustBeWildToSow>
      <dieIfNoSunlight>false</dieIfNoSunlight>
      <dieFromToxicFallout>False</dieFromToxicFallout>
      <showGrowthInInspectPane>false</showGrowthInInspectPane>
    </plant>
  </ThingDef>


