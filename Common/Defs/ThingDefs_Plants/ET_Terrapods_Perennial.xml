  <ThingDef ParentName="ET_PerennialRegrowthPodBase">
    <defName>ET_PerennialSMGGrowthPod</defName>
    <label>Perennial Needler Pod</label>
    <description>A fortified Terrapod that is revitalizing a Terraweapon. Will produce a single, revitalized Perennial Needler when finished.
\nBe aware that the growth is a delicate process. If this pod is destroyed, any weapon inside it will be destroyed as well.</description>
    <comps>
      <li Class="CompProperties_Spawner">
        <thingToSpawn>ET_PerennialSMG</thingToSpawn>
        <spawnCount>1</spawnCount>
        <spawnIntervalRange>900000</spawnIntervalRange> <!--15 days to respawn-->
        <spawnForbidden>false</spawnForbidden>
        <requiresPower>false</requiresPower>
        <showMessageIfOwned>true</showMessageIfOwned>
        <writeTimeLeftToSpawn>true</writeTimeLeftToSpawn>
      </li>
      <li Class="CompProperties_Lifespan">
        <lifespanTicks>900030</lifespanTicks> <!--30 ticks longer to make sure the weapon spawns-->
      </li>
    </comps>
  </ThingDef>


  <ThingDef ParentName="ET_PerennialRegrowthPodBase">
    <defName>ET_PerennialRifleGrowthPod</defName>
    <label>Perennial PSR Pod</label>
    <description>A fortified Terrapod that is revitalizing a Terraweapon. Will produce a single, revitalized Perennial PSR when finished.
\nBe aware that the growth is a delicate process. If this pod is destroyed, any weapon inside it will be destroyed as well.</description>
    <comps>
      <li Class="CompProperties_Spawner">
        <thingToSpawn>ET_PerennialRifle</thingToSpawn>
        <spawnCount>1</spawnCount>
        <spawnIntervalRange>900000</spawnIntervalRange> <!--15 days to respawn-->
        <spawnForbidden>false</spawnForbidden>
        <requiresPower>false</requiresPower>
        <showMessageIfOwned>true</showMessageIfOwned>
        <writeTimeLeftToSpawn>true</writeTimeLeftToSpawn>
      </li>
      <li Class="CompProperties_Lifespan">
        <lifespanTicks>900030</lifespanTicks> <!--30 ticks longer to make sure the weapon spawns-->
      </li>
    </comps>
  </ThingDef>


</Defs>
