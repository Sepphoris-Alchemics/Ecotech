  <ThingDef ParentName="TreeBase"> <!--todo: add pod growth mechanic-->
    <defName>ET_SentinelTreeTierOne</defName>
    <label>Elderwood Sentinel Tree</label>
    <description>The Elderwood Sentinel is one of the "Conduit" trees that Ecotech devotees learn to properly nurture, enabling tribes to live safely under natural resources. Elderwood Sentinels provide various weapons and Prima seeds to their colony.
 Some of the weapons that Sentinels create are ancient designs, which were either forgotten, or never could be manually formed/grown in the first place.

While this tree is present, weapons and seeds will be created at the base of the tree roughly 3 times a year. Multiple Sentinels can exist together, but extensive spacing is required between each one.</description>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Plant/ConduitTrees/ElderwoodSentinelTree</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <shadowData>
        <volume>(0.21, 0.6, 0.21)</volume>
      </shadowData>
    </graphicData>
    <tickerType>Normal</tickerType>
    <canScatterOver>false</canScatterOver>
    <descriptionHyperlinks>
      <ThingDef>ET_Glowsap</ThingDef>
    </descriptionHyperlinks>
    <minifiedDef IsNull="True" />
    <statBases>
      <Beauty>18</Beauty>
      <BeautyOutdoors>18</BeautyOutdoors>
      <Flammability>3</Flammability>
      <MaxHitPoints>300</MaxHitPoints>
    </statBases>
    <killedLeavings>
      <ET_Glowsap>60</ET_Glowsap>
      <ET_ElderwoodMaterial>40</ET_ElderwoodMaterial>
    </killedLeavings>
    <ingestible />
    <preventSkyfallersLandingOn>false</preventSkyfallersLandingOn>
    <plant>
      <growDays>1</growDays> 
      <visualSizeRange>1.8~2.4</visualSizeRange>
      <!--<sowMinSkill>6</sowMinSkill>
			<sowTags>
				<li>Ground</li>
			</sowTags>-->
      <lifespanDaysPerGrowDays>0</lifespanDaysPerGrowDays>
      <fertilityMin>0.05</fertilityMin>
      <fertilitySensitivity>0</fertilitySensitivity>
      <wildClusterWeight>0</wildClusterWeight>
      <harvestYield>0</harvestYield>
      <!--<mustBeWildToSow>true</mustBeWildToSow>
      <sowWork>400</sowWork>
      <harvestTag>Standard</harvestTag>
      <harvestYield>30</harvestYield>
			<harvestedThingDef>ET_Glowsap</harvestedThingDef>
			<harvestFailable>false</harvestFailable>
			<harvestAfterGrowth>0.05</harvestAfterGrowth>
      <harvestMinGrowth>0.9</harvestMinGrowth>-->
      <neverBlightable>true</neverBlightable>
      <treeCategory>Super</treeCategory>
      <dieIfNoSunlight>false</dieIfNoSunlight>
      <growMinGlow>0</growMinGlow>
      <dieIfLeafless>false</dieIfLeafless>
      <!--<sowResearchPrerequisites>
        <li>ET_SapBasics</li>
      </sowResearchPrerequisites>-->
      <dieFromToxicFallout>False</dieFromToxicFallout>
      <showGrowthInInspectPane>true</showGrowthInInspectPane>
      <minSpacingBetweenSamePlant>47.9</minSpacingBetweenSamePlant>
      <blockAdjacentSow>true</blockAdjacentSow>
      <warnIfMarkedForCut>true</warnIfMarkedForCut>
			<burnedThingDef IsNull="True" />
			<choppedThingDef IsNull="True" />
			<smashedThingDef IsNull="True" />
      <purpose>Misc</purpose>
    </plant>
    <comps>
      <li Class="Ecotech.ThingCompProperties_CyclicThingSpawner">
        <compClass>Ecotech.ThingComp_CyclicThingSpawner</compClass>
        <cycleDurationRangeTicks>900000~1200000</cycleDurationRangeTicks> <!--15 to 20 days-->
        <showNotificationWhenSpawningThings>true</showNotificationWhenSpawningThings>
        <potentialSpawnedThings>
          <li>
            <weight>1</weight>
            <things>
              <ET_Seed_PrimaApexTurret>1~3</ET_Seed_PrimaApexTurret>
            </things>
          </li>
          <li>
            <weight>0.6</weight>
            <things>
              <ET_NightshadeRifle>1</ET_NightshadeRifle>
            </things>
          </li>
          <li>
            <weight>0.6</weight>
            <things>
              <ET_GaubornShotgun>1</ET_GaubornShotgun>
            </things>
          </li>
          <li>
            <weight>0.4</weight>
            <things>
              <ET_PerrenialRifle>1</ET_PerrenialRifle>
            </things>
          </li>
          <li>
            <weight>0.4</weight>
            <things>
              <ET_PerrenialSMG>1</ET_PerrenialSMG>
            </things>
          </li>
          <li>
            <weight>0.01</weight>
            <things>
              <ET_RoyalSword>1</ET_RoyalSword>
            </things>
          </li>
          <li>
            <weight>0.01</weight>
            <things>
              <ET_RoyalRifle>1</ET_RoyalRifle>
            </things>
          </li>
        </potentialSpawnedThings>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>9</glowRadius>
        <glowColor>(237,211,78,0)</glowColor>
      </li>
      <li Class="CompProperties_SelfhealHitpoints">
        <ticksPerHeal>2000</ticksPerHeal> <!-- 30 hp per day, must be a multiple of 2000, since plants have Long ticker -->
      </li>
    </comps>
    <specialDisplayRadius>67.9</specialDisplayRadius>
  </ThingDef>


  <ThingDef ParentName="TreeBase"> <!--todo: add zone growth coding-->
    <defName>ET_BuildingTreeTierOne</defName>
    <label>Elderwood Custodian Tree</label>
    <description>The Elderwood Custodian Tree is one of the "Conduit" trees that Ecotech devotees learn to properly nurture, enabling tribes to live safely under natural resources. Elderwood custodian trees produce lumps of terramass that can be harvested from the ground.
This tree will also periodically shed excess bark, creating malleable wooden plates that can be used for crafting and construction.

Legend has it this tree was once able to independently shelter entire colonies. Whether or not that is true remains to be seen....</description>
