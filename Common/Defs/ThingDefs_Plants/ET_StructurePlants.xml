<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="ET_FundamentalPlantBase">
    <defName>ET_PrimaBrightsapLampPlant</defName>
    <label>Prima Brightlamp Sprout</label>
    <description>A growing sprout that will shape itself into a sturdy Brightlamp. Brightlamps provide light by only using brightsap.</description>
    <graphicData>
      <texPath>Things/Plant/PrimaBrightsapLamp_Mature</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <plant>
      <topWindExposure>0.15</topWindExposure>
      <growDays>1.5</growDays>
      <immatureGraphicPath>Things/Plant/PrimaBrightsapLamp_Immature</immatureGraphicPath>
      <visualSizeRange>0.8~1.2</visualSizeRange>
    </plant>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>0.9</glowRadius>
        <glowColor>(238,211,77,0)</glowColor>
      </li>
      <li Class="Ecotech.ThingCompProperties_PlantTransformOnMaturity">
        <compClass>Ecotech.ThingComp_PlantTransformOnMaturity</compClass>
        <transformedThing>ET_PrimaBrightsapLamp</transformedThing>
        <!--<transformedThingStuff>WoodLog</transformedThingStuff>-->
      </li>
      <li Class="CompProperties_InspectString">
        <inspectString>Growing into: Prima Brightlamp</inspectString>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="ET_FundamentalPlantBase">
    <defName>ET_PrimaBrightsapColumnPlant</defName>
    <label>Brightsap Column Sprout</label>
    <description>A growing sprout that will shape itself into a Brightsap Column. Brightsap Columns provide light by only using brightsap, and will also hold any rooftop above it.</description>
    <graphicData>
      <texPath>Things/Plant/PrimaBrightsapColumn_Mature</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <plant>
      <topWindExposure>0.15</topWindExposure>
      <growDays>1.5</growDays>
      <immatureGraphicPath>Things/Plant/PrimaBrightsapColumn_Immature</immatureGraphicPath>
      <visualSizeRange>0.8~1.2</visualSizeRange>
    </plant>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>0.9</glowRadius>
        <glowColor>(238,211,77,0)</glowColor>
      </li>
      <li Class="Ecotech.ThingCompProperties_PlantTransformOnMaturity">
        <compClass>Ecotech.ThingComp_PlantTransformOnMaturity</compClass>
        <transformedThing>ET_PrimaBrightsapColumn</transformedThing>
        <!--<transformedThingStuff>WoodLog</transformedThingStuff>-->
      </li>
      <li Class="CompProperties_InspectString">
        <inspectString>Growing into: Prima Brightsap Column</inspectString>
      </li>
    </comps>
  </ThingDef>

</Defs>