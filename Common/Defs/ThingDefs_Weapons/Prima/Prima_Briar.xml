<Defs>

	<!--Upgraded Primas get +20 health and -1 flammability. Lifespan times below:
			-Immature light: 10 days (600000) | 40 health
			-Immature normal: 12 days (720000) | 45 health
			-Immature heavy: 14 days (840000) | 50 health

			-Mature light: 14 days (840000) | 60 health
			-Mature normal: 16 days (960000) | 65 health
			-Mature heavy: 18 days (1080000) | 70 health
			
			
			POST-TESTING LIFESPANS: Prima weapons now generally last more than a quadrum. Their upgraded growth time is only +2 instead of +3 or +4, due to their ease of access.
			Immature Light: 14 days (840000) | 30 health
			Immature Normal: 16 days (960000) | 35 health
			Immature Heavy: 18 days (1080000) | 40 health
			
			Mature Light: 16 days (960000) | 50 health
			Mature Normal: 18 days (1080000) | 55 health
			Mature Heavy: 20 days (1200000) | 60 health-->

	<ThingDef ParentName="UpgradedUnmodifiedTerraweapon">
		<defName>ET_BriarShotgunBasic</defName>
		<label>Briar Spreadshot</label>
		<description>The Apex weapon of the Prima Spreadshot, replacing it's Prima materials with the stronger Elderwood ones. The evolution has resulted in a well armored epidermis, and has created the growth of many razor-sharp thorns and segments growing out of the weapon. These briars are utilized as high-speed projectiles that shatter upon contact, creating painful fields of tiny framents, buried deep into the skin.
Briar weapons also retain the random projectile output, though with higher accuracy, projectile minimum, and projectile maximum.
\nUnlike every other Prima weapon, Briar weapons have very little room for growth due to the evolution they've gone under. They cannot accept most available saps, and cannot be renewed with Brightsap. Briar weapons have no further stages, hence being classified as an "Apex" weapon.</description>
		<graphicData>
			<texPath>Things/WeaponPrima/Briar/ET_BriarShotgun_Basic</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>0.9</drawSize>
		</graphicData>
		<soundInteract>Interact_Shotgun</soundInteract>
		<weaponTags Inherit='False'>
			<li>PlantWeapons</li>
			<li>ApexWeaponns</li>
			<li>BriarWeapons</li>
		</weaponTags>
		<weaponClasses>
			<li>ShortShots</li>
			<li>Ranged</li>
		</weaponClasses>
		<relicChance>0</relicChance>
		<statBases>
			<MaxHitPoints>75</MaxHitPoints>			<!--From 55 to 75: 20 health increase-->
			<AccuracyTouch>0.9</AccuracyTouch>			<!--.05 higher accuracy in all areas-->
			<AccuracyShort>0.9</AccuracyShort>
			<AccuracyMedium>0.8</AccuracyMedium>
			<AccuracyLong>0.4</AccuracyLong>
			<RangedWeapon_Cooldown>0.6</RangedWeapon_Cooldown>			<!--decrease by 0.15-->
			<DeteriorationRate>0</DeteriorationRate>
			<Mass>1.9</Mass>			<!--Mass increased by .5 from upgraded variant-->
			<Flammability>1</Flammability> <!--Decreased by 1-->
			<WorkToMake>12000</WorkToMake>
		</statBases>
		<techLevel>Neolithic</techLevel>
		<smeltable>false</smeltable>
		<equippedAngleOffset>50</equippedAngleOffset>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_BriarShotgun</defaultProjectile>
				<warmupTime>1.125</warmupTime>
				<range>13.9</range>				<!--Same as upgraded variant-->
				<soundCast>Shot_Shotgun</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>0</muzzleFlashScale>
			</li>
		</verbs>
		<tools>
			<li>
				<label>grip</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<tickerType>Normal</tickerType>
		<comps>
			<li Class="Ecotech.ThingCompProperties_EquippedLifespan">
				<compClass>Ecotech.ThingComp_EquippedLifespan</compClass>
				<lifespanTicks>1080000</lifespanTicks> <!--Same as upgraded variant-->
				<lifespanBarColor>(28, 31, 15)</lifespanBarColor> <!--to-do: figure out special color-->
				<!--<expireEffect></expireEffect>-->
				<!--<replacementToSpawn>ET_Seed_PrimaApexTurret</replacementToSpawn>-->
			</li>
		</comps>
	</ThingDef>


