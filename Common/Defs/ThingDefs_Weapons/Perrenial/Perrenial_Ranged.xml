<?xml version="1.0" encoding="utf-8" ?>
<Defs>



<!--Perennial Rifle-->
	<ThingDef ParentName="BasePerennialTerraweapon">
		<defName>ET_PerennialRifle</defName>		<!--Counterpart: Minigun-->
		<label>Perennial PSR</label>
		<description>The Perennial PSR (Plated Suppression Rifle) is a biotic weapon, carved from the heart of an Epoch Tree. The PSR is capable of firing bursts at relatively long ranges. Combines with it's high AP and projectile speed. This makes it a very effective suppresive weapon, or as a weapon meant to injure and down a target, with lowered chances of outright killing them.
\n\nPerennial weapons have a very long lifespan, but they still do eventually expire. However, the living moss patches they posess allows them to be replanted, and (rougly after a quadrum) fully revitilized.</description>
		<graphicData>
			<texPath>Things/WeaponPerennial/Basic/ET_PerennialRifleBasic</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>1.2</drawSize>
		</graphicData>
		<soundInteract>Interact_Rifle</soundInteract>
		<weaponTags Inherit='False'>
			<li>PlantWeapons</li>
		</weaponTags>
		<weaponClasses>
			<li>Ranged</li>
		</weaponClasses>
		<relicChance>0</relicChance>
		<statBases>
			<MaxHitPoints>45</MaxHitPoints> <!--- mid/long range is increased by 0.15, touch/short decreased by 0.15-->
			<AccuracyTouch>0.15</AccuracyTouch>
			<AccuracyShort>0.15</AccuracyShort>
			<AccuracyMedium>0.40</AccuracyMedium>
			<AccuracyLong>0.32</AccuracyLong>
			<RangedWeapon_Cooldown>1.15</RangedWeapon_Cooldown> <!--half of the counterpart-->
			<DeteriorationRate>0</DeteriorationRate>
			<Mass>1.6</Mass>
			<Flammability>3</Flammability>
			<WorkToMake>12000</WorkToMake>
		</statBases>
		<techLevel>Neolithic</techLevel>
		<smeltable>false</smeltable>
		<equippedAngleOffset>50</equippedAngleOffset>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_PerennialNeedle</defaultProjectile> <!--the damage and count isn't the same, but the overall damage is right below the Heavy SMG-->
				<warmupTime>2.1</warmupTime> <!--0.4 faster than it's counterpart-->
				<burstShotCount>3</burstShotCount>
				<ticksBetweenBurstShots>4</ticksBetweenBurstShots>
				<range>25.9</range> <!--five less than it's counterpart-->
				<soundCast>ET_Sound_Needle1</soundCast>
				<muzzleFlashScale>0</muzzleFlashScale>
			</li>
		</verbs>
		<tools>
			<li>
				<label>grip</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<tickerType>Normal</tickerType>
		<comps>
			<li Class="CompProperties_SelfhealHitpoints">
				<ticksPerHeal>24000</ticksPerHeal>				<!-- 6k ticks = 10hp/day, 12k ticks = 5hp/day, 24k ticks = 2.5hp/day -->
			</li>
			<li Class="Ecotech.ThingCompProperties_EquippedLifespan">
				<compClass>Ecotech.ThingComp_EquippedLifespan</compClass>
				<lifespanTicks>1200000</lifespanTicks>
				<lifespanBarColor>(91, 61, 48)</lifespanBarColor>
				<!--<expireEffect></expireEffect>-->
				<!--<replacementToSpawn>ChunkSlagSteel</replacementToSpawn>-->
			</li>
				<li Class="CompProperties_Plantable">
        	<plantDefToSpawn>ET_PerennialRifleGrowthPod</plantDefToSpawn>
      	</li>
    <li Class="CompProperties_InspectString">
      <inspectString>Perennial Genome | Dormant
Accepts most terrasaps | Renewable | +5 hp/day (unequipped)</inspectString>
      </li>
		</comps>
	</ThingDef>

	<ThingDef ParentName="BasePerennialTerraweapon">
		<defName>ET_PerennialSMG</defName>		<!--Counterpart: Heavy SMG-->
		<label>Perennial Needler</label>
		<description>The Perennial Needler is a biotic weapon, carved fom the heart of an Epoch Tree. The Needler is quite limited on range, but it's volley of armor-shredding thorns are more than deadly to anything that gets too close. Contrary to some myths, it's projectiles do not explode, nor are they pink.
\n\nPerennial weapons have a very long lifespan, but they still do eventually expire. However, the living moss patches they posess allows them to be replanted, and (rougly after a quadrum) fully revitilized.</description>
		<graphicData>
			<texPath>Things/WeaponPerennial/Basic/ET_PerennialSMGBasic</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>1.2</drawSize>
		</graphicData>
		<soundInteract>Interact_Rifle</soundInteract>
		<weaponTags Inherit='False'>
			<li>PlantWeapons</li>
		</weaponTags>
		<weaponClasses>
			<li>Ranged</li>
		</weaponClasses>
		<relicChance>0</relicChance>
		<statBases>
			<MaxHitPoints>35</MaxHitPoints>
			<AccuracyTouch>0.85</AccuracyTouch>
			<AccuracyShort>0.80</AccuracyShort>
			<AccuracyMedium>0.20</AccuracyMedium>
			<AccuracyLong>0.15</AccuracyLong>
			<RangedWeapon_Cooldown>0.8</RangedWeapon_Cooldown> <!--half of the counterpart, rounded down-->
			<DeteriorationRate>0</DeteriorationRate>
			<Mass>1.2</Mass>
			<Flammability>1</Flammability>
			<WorkToMake>12000</WorkToMake>
		</statBases>
		<techLevel>Neolithic</techLevel>
		<smeltable>false</smeltable>
		<equippedAngleOffset>50</equippedAngleOffset>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
