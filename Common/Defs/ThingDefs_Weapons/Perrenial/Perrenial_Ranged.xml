				<warmupTime>2.1</warmupTime> <!--0.4 faster than it's counterpart-->
				<burstShotCount>7</burstShotCount>
				<ticksBetweenBurstShots>11</ticksBetweenBurstShots>
				<range>17.9</range> <!--five less than it's counterpart-->
				<soundCast>ET_Sound_Needle1</soundCast>
				<muzzleFlashScale>0</muzzleFlashScale>
			</li>
		</verbs>
		<tools>
			<li>
				<label>grip</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>spear</label>
				<capacities>
					<li>Poke</li>
				</capacities>
				<power>12</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<tickerType>Normal</tickerType>
		<comps>
			<li Class="CompProperties_SelfhealHitpoints">
				<ticksPerHeal>24000</ticksPerHeal>				<!-- 6k ticks = 10hp/day, 12k ticks = 5hp/day, 24k ticks = 2.5hp/day -->
			</li>
			<li Class="Ecotech.ThingCompProperties_EquippedLifespan">
				<compClass>Ecotech.ThingComp_EquippedLifespan</compClass>
				<lifespanTicks>1500000</lifespanTicks>
				<lifespanBarColor>(91, 61, 48)</lifespanBarColor>
				<!--<expireEffect></expireEffect>-->
				<!--<replacementToSpawn>ChunkSlagSteel</replacementToSpawn>-->
			</li>
				<li Class="CompProperties_Plantable">
        	<plantDefToSpawn>ET_PerennialSMGGrowthPod</plantDefToSpawn>
      	</li>
    <li Class="CompProperties_InspectString">
      <inspectString>Perennial Genome | Immutable
Accepts most terrasaps | Renewable | +5 hp/day (unequipped)</inspectString>
      </li>
		</comps>
	</ThingDef>

	<ThingDef ParentName="BasePerennialTerraweapon">
		<defName>ET_PerennialCannon</defName>		<!--Counterpart: Grenade Launcher-->
		<label>Perennial Spinecannon</label>
		<description>The Perennial Spinecannon is a biotic weapon, carved from the heart of an Epoch Tree. This weapon fires a large stake at close range, which deal moderate damage on top of fragmenting into splinters that affect the immediate area. This makes the Cannon very capable against strong targets that are a bit too close for confort.
\n\nPerennial weapons have a very long lifespan, but they still do eventually expire. However, the living moss patches they posess allows them to be replanted, and (rougly after a quadrum) fully revitilized.</description>
		<graphicData>
