<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <FactionDef>
		<defName>ET_OrganicFaction</defName>
		<label>Terratech Curators</label>
    <description>Using the soil as their library, this faction has massive groves of hundreds - if not thousands - of plants constantly being grown and replanted, which has kept their tech alive for thousands of years. While they do not posess much metal, adn refuse to use alloys and fabricated tools, they are nontheless more than capable of defending themselves.\n\nThey generally keep to themselves, but are open to establishing relations to colonies that only embrace technolgies that don't exploit the earth (Medieval and lower).</description>
    <pawnSingular>curator</pawnSingular>
	<pawnsPlural>curator</pawnsPlural>
    <settlementGenerationWeight>0.5</settlementGenerationWeight>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <canMakeRandomly>true</canMakeRandomly>
    <canSiege>true</canSiege>
    <canStageAttacks>true</canStageAttacks>
    <leaderTitle>Grovekeeper</leaderTitle>
	<autoFlee>false</autoFlee>
	<earliestRaidDays>7</earliestRaidDays>
    <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath> <!--create custom icon-->
    <colorSpectrum>
      <li>(0.64, 0.05, 0.8)</li>
      <li>(0.8, 0.05, 0.64)</li>
    </colorSpectrum>
	<factionNameMaker>ET_NamerOrganicFaction</factionNameMaker> <!--create custom def-->
	<settlementNameMaker>ET_NamerOrganicSettlement</settlementNameMaker> <!--create custom def-->
	<techLevel>Neolithic</techLevel>
	<backstoryCategories>
		<li>ET_OrganicFactionBackstories</li> <!--create custom def-->
	</backstoryCategories>
	<raidCommonalityFromPointsCurve>
      <points>
        <li>(0, .5)</li> 
      </points>
    </raidCommonalityFromPointsCurve>
	<raidLootMaker>ET_OrganicRaidLootMaker</raidLootMaker> <!--create custom def-->
    <caravanTraderKinds> <!--create defs-->
      <li>ET_OrganicCaravan_Seeds</li>
			<li>ET_OrganicCaravan_Saps</li>
    </caravanTraderKinds>
    <visitorTraderKinds> <!--create defs-->
      <li>ET_OrganicVisitor_Standard</li>
    </visitorTraderKinds>
    <baseTraderKinds> <!--create defs-->
      <li>ET_FactionTrader_Base</li>
    </baseTraderKinds>
    <allowedArrivalTemperatureRange>
      <min>-40</min>
      <max>45</max>
    </allowedArrivalTemperatureRange>
	<maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(0,40)</li>
        <li>(70, 70)</li>
        <li>(700, 150)</li>
        <li>(1300, 250)</li>
        <li>(100000, 10000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>
	<raidLootValueFromPointsCurve>
      <points>
        <li>(35,     15)</li>
        <li>(100,   120)</li>
        <li>(1000,  500)</li>
        <li>(2000,  800)</li>
        <li>(4000, 1000)</li>
      </points>
    </raidLootValueFromPointsCurve>
    <pawnGroupMakers> <!--create defs-->
			<!--
			Perennial should be most common.
			Prima should be second-most common, and should only be upgraded or sapped weaponry.
			Both briar and wild wepaonry should be rare, and not upgraded.
			"Random" means that weapons may or may not be infused
			"Basic" means weapons won't be infused
			"Infused" means weapons will be infused
			-->
      <li>
        <kindDef>Combat</kindDef>
    		<options>
					<!--Perennial-->
					<ET_PerennialGunner_RangedBasic>2</ET_PerennialGunner_RangedBasic>
					<ET_PerennialGunner_RangedInfused>2</ET_PerennialGunner_RangedInfused>
					<ET_PerennialGunner_RangedRandom>6</ET_PerennialGunner_RangedRandom>
					<ET_PerennialGunner_HeavyBasic>2</ET_PerennialGunner_HeavyBasic>
					<ET_PerennialGunner_HeavyRandom>1</ET_PerennialGunner_HeavyRandom>
					<ET_PerennialGunner_CQCRandom>5</ET_PerennialGunner_CQCRandom>
					<ET_PerennialWarrior_MeleeRandom>4</ET_PerennialWarrior_MeleeRandom>
					<ET_PerennialElite_RangedInfused>2</ET_PerennialElite_RangedInfused> <!--will have an advanced infusion-->
					<ET_PerennialElite_MeleeInfused>2</ET_PerennialElite_MeleeInfused> <!--will have an advanced infusion-->
					<!--Prima; these exclude base Prima weapons-->
					<ET_PrimaGunner_AllInfused>5</ET_PrimaGunner_AllInfused>
					<ET_PrimaGunner_HeavyRandom>3</ET_PrimaGunner_HeavyRandom>
					<ET_PrimaWarrior_MeleeInfused>2</ET_PrimaWarrior_MeleeInfused>
					<!--Briar-->
					<ET_BriarGunner_SMG>4</ET_BriarGunner_SMG>
					<ET_BriarGunner_Shotgun>3</ET_BriarGunner_Shotgun>
					<ET_BriarGunner_Rifle>3</ET_BriarGunner_Rifle>
					<!--Wild-->
					<ET_NightshadeGunner>2</ET_NightshadeGunner>
					<ET_GaubornGunner>2</ET_GaubornGunner>
					<ET_BiolithGunner>1</ET_BiolithGunner>
					<ET_RoyalGunner_Rifle>1</ET_RoyalGunner_Rifle>
					<ET_RoyalWarrior_Sword>1</ET_RoyalWarrior_Sword>
				</options>
      </li>
	  <li>
        <kindDef>Peaceful</kindDef>
        <options>
			<ET_PerennialGunner_CQCRandom>10</ET_PerennialGunner_CQCRandom>
			<ET_RoyalWarrior_Sword>1</ET_RoyalWarrior_Sword>
			<ET_PerennialGunner_RangedBasic>6</ET_PerennialGunner_RangedBasic>
			<ET_PerennialElite_RangedInfused>5</ET_PerennialElite_RangedInfused>
			<ET_RoyalGunner_Rifle>2</ET_RoyalGunner_Rifle>
        </options>
      </li>
      <li>
        <kindDef>Trader</kindDef>
        <traders>
          <Town_Trader>1</Town_Trader>
        </traders>
        <carriers>
          <Muffalo>1</Muffalo>
          <Dromedary>4</Dromedary>
          <Alpaca>2</Alpaca>
          <Elephant>6</Elephant>
        </carriers>
        <guards>
			<ET_PerennialGunner_RangedRandom>8</ET_PerennialGunner_RangedRandom>
			<ET_BriarGunner_Random>4</ET_BriarGunner_Random>
			<ET_PerennialElite_MeleeInfused>10</ET_PerennialElite_MeleeInfused>
			<ET_WildElite>5</ET_WildElite>
		</guards>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
			<ET_PerennialGunner_RangedInfused>10</ET_PerennialGunner_RangedInfused>
			<ET_BriarGunner_Random>18</ET_BriarGunner_Random>
			<ET_RoyalGunner_Sword>5</ET_RoyalGunner_Sword>
			<ET_PerennialGunner_CQCRandom>16</ET_PerennialGunner_CQCRandom>
			<ET_RoyalWarrior_Sword>4</ET_RoyalWarrior_Sword>
			<ET_WildElite>5</ET_WildElite>
			<ET_PerennialGunner_HeavyRandom>6</ET_PerennialGunner_HeavyRandom>
		</options>
      </li>
    </pawnGroupMakers>
    <factionIconPath>World/TerratechTown</factionIconPath>
	<maxConfigurableAtWorldCreation>9999</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>77</configurationListOrderPriority>
  </FactionDef>
  
    <ThingSetMakerDef>
    <defName>ET_RaidLootMaker</defName>
    <root Class="ThingSetMaker_MarketValue">
      <fixedParams>
        <filter>
          <thingDefs>
            <li>Silver</li>
            <li>MedicineHerbal</li>
            <li>Jade</li>
            <li>ET_SunDrop</li>
          </thingDefs>
        </filter>
      </fixedParams>
    </root>
  </ThingSetMakerDef>


</Defs>