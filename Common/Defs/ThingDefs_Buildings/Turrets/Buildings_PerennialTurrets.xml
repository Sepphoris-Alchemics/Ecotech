<!--Prima Turret Gun-->

  <ThingDef ParentName="BaseWeaponTurret">
    <defName>ET_PerennialLargeTurretSpearGun</defName>
    <label>Perennial Groveguard</label>
    <description>A sentry grown from a specialized seed. Despite being a plant, a network of sensitive roots allow the sentry to identify hostiles from a medium distance, and a hardy wooden shell allows it to withstand a limited amount of damage.
The Groveguard has considerably higher range and durability than most smaller turrets. However, it was shaped with supression and multiple targets in mind, making it's projectiles cover a wide area - and thus, being far less accurate than many other grown turrets.
\n\nGroveguard Sentries are entirely organic, and do not require power. However due to it's biological nature, old or expired Perrenial Groveguards will need to be replaced with fresh ones.</description>
    <graphicData>
      <texPath>Things/Security/PerennialCannon/PerennialCannon_Top</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <altitudeLayer>Item</altitudeLayer>
    <soundInteract>Interact_Rifle</soundInteract>
    <tradeability>None</tradeability>
    <destroyOnDrop>true</destroyOnDrop>
    <statBases>
      <AccuracyTouch>0.55</AccuracyTouch>
      <AccuracyShort>0.55</AccuracyShort>
      <AccuracyMedium>0.55</AccuracyMedium>
      <AccuracyLong>0.55</AccuracyLong>
      <RangedWeapon_Cooldown>4</RangedWeapon_Cooldown>
      <Mass>20</Mass>
      <Flammability>1</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
    <weaponTags>
      <li>TurretGun</li>
    </weaponTags>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>ET_PerennialCannonSpear</defaultProjectile>
        <warmupTime>9.0</warmupTime>
        <range>28.9</range>
        <ticksBetweenBurstShots>15</ticksBetweenBurstShots>
        <burstShotCount>3</burstShotCount>
        <soundCast>ET_Sound_BlowgunHeavy</soundCast>
        <muzzleFlashScale>0</muzzleFlashScale>
        <consumeFuelPerShot>0.5</consumeFuelPerShot>
        <forcedMissRadius>1.9</forcedMissRadius>
      </li>
    </verbs>
  </ThingDef>

<!--Perennial Spear Shot-->
